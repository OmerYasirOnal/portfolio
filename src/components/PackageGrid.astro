---
/**
 * PackageGrid - the four corporate service pillars on `/packages`.
 */
import { packageTiers } from '../data/packages';
import { t, localizePath, type Locale } from '../data/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const contactHref = `${localizePath(locale, '/')}#contact`;
---

<ul class="grid gap-6 md:grid-cols-2" role="list">
  {
    packageTiers.map((tier) => (
      <li
        class:list={[
          'flex h-full flex-col rounded-2xl border p-6 sm:p-7',
          tier.highlighted ? 'border-accent/70 bg-card shadow-sm' : 'border-border bg-card shadow-2xs',
        ]}
      >
        <div class="flex flex-wrap items-center justify-between gap-2">
          <span class="rounded-full bg-accent/10 px-3 py-1 text-xs font-semibold text-accent">
            {tier.pages[locale]}
          </span>
          {tier.highlighted && (
            <span class="inline-flex items-center rounded-full bg-accent px-3 py-1 text-xs font-semibold text-bg">
              {t(locale, 'packages.mostPopular')}
            </span>
          )}
        </div>

        <h3 class="mt-4 text-xl font-bold tracking-tight text-fg">{tier.name[locale]}</h3>
        <p class="mt-2 text-sm leading-relaxed text-muted">{tier.tagline[locale]}</p>

        <p class="mt-4 text-xs font-medium text-muted">
          {t(locale, 'packages.timeline')}: <strong class="font-semibold text-fg">{tier.timeline[locale]}</strong>
        </p>

        <ul class="mt-5 flex-1 space-y-2.5 border-t border-border/70 pt-5" role="list">
          {tier.features.map((feature) => (
            <li class="flex items-start gap-2.5 text-sm leading-relaxed text-muted">
              <svg
                class="mt-0.5 h-4 w-4 shrink-0 text-accent"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                focusable="false"
              >
                <path d="M20 6 9 17l-5-5" />
              </svg>
              <span>{feature[locale]}</span>
            </li>
          ))}
        </ul>

        <a
          href={contactHref}
          class:list={[
            'mt-6 inline-flex items-center justify-center gap-2 rounded-xl px-5 py-3 text-sm font-semibold transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent',
            tier.highlighted
              ? 'bg-accent text-bg shadow-2xs hover:opacity-90'
              : 'border border-border bg-bg text-fg hover:border-accent hover:text-accent',
          ]}
        >
          {t(locale, 'packages.cta')}
        </a>
      </li>
    ))
  }
</ul>

<p class="mt-8 max-w-2xl text-sm leading-relaxed text-muted">{t(locale, 'packages.priceNote')}</p>
