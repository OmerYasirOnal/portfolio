---
/**
 * PackageGrid - the four corporate service pillars on `/packages`.
 */
import { packageTiers } from '../data/packages';
import { t, localizePath, type Locale } from '../data/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const contactHref = `${localizePath(locale, '/')}#contact`;
---

<ul class="grid gap-6 md:grid-cols-2" role="list">
  {
    packageTiers.map((tier) => (
      <li
        data-spotlight
        class:list={[
          'group relative flex h-full flex-col overflow-hidden rounded-3xl border p-6 backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 sm:p-8',
          tier.highlighted
            ? 'border-accent/60 bg-gradient-to-br from-card via-card to-emerald-500/[0.07] shadow-lg shadow-accent/10'
            : 'border-accent/20 bg-card/80 shadow-sm hover:border-accent/50 hover:shadow-lg hover:shadow-accent/5',
        ]}
      >
        <div class="relative z-10 flex flex-wrap items-center justify-between gap-2">
          <span class="rounded-full border border-accent/25 bg-accent/8 px-3.5 py-1 text-xs font-semibold text-accent">
            {tier.pages[locale]}
          </span>
          {tier.highlighted && (
            <span class="inline-flex items-center rounded-full bg-gradient-to-r from-emerald-600 to-teal-600 px-3.5 py-1 text-xs font-semibold text-white shadow-xs">
              {t(locale, 'packages.mostPopular')}
            </span>
          )}
        </div>

        <h3 class="relative z-10 mt-5 text-xl font-bold tracking-tight text-fg transition-colors group-hover:text-accent sm:text-2xl">
          {tier.name[locale]}
        </h3>
        <p class="relative z-10 mt-2 text-sm leading-relaxed text-muted">{tier.tagline[locale]}</p>

        <p class="relative z-10 mt-4 text-xs font-medium text-muted">
          {t(locale, 'packages.timeline')}: <strong class="font-semibold text-fg">{tier.timeline[locale]}</strong>
        </p>

        <ul class="relative z-10 mt-6 flex-1 space-y-2.5 border-t border-accent/15 pt-5" role="list">
          {tier.features.map((feature) => (
            <li class="flex items-start gap-2.5 text-sm leading-relaxed text-muted">
              <span class="mt-1 grid h-4 w-4 shrink-0 place-items-center rounded-full bg-accent/15 text-accent">
                <svg
                  class="h-2.5 w-2.5"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="3"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  focusable="false"
                >
                  <path d="M20 6 9 17l-5-5" />
                </svg>
              </span>
              <span>{feature[locale]}</span>
            </li>
          ))}
        </ul>

        <a
          href={contactHref}
          class:list={[
            'relative z-10 mt-6 inline-flex items-center justify-center gap-2 rounded-full px-5 py-3 text-sm font-semibold transition-all focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent',
            tier.highlighted
              ? 'bg-gradient-to-r from-emerald-600 via-emerald-500 to-teal-600 text-white shadow-md shadow-emerald-600/25 hover:-translate-y-0.5 hover:shadow-lg'
              : 'border border-accent/25 bg-bg/80 text-fg hover:border-accent hover:bg-accent hover:text-white',
          ]}
        >
          {t(locale, 'packages.cta')} →
        </a>
      </li>
    ))
  }
</ul>

<p class="mt-8 max-w-2xl text-sm leading-relaxed text-muted">{t(locale, 'packages.priceNote')}</p>
