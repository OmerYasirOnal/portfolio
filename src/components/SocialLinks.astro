const hint = t(locale, 'social.opensNewTab');
---

<ul class:list={['flex items-center gap-1', className]} role="list">
  {
    platforms.map((key) => {
      const link = profile.links[key];
      return (
        <li>
          <a
            href={link.url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${link.label} — ${hint}`}
            title={link.label}
            class="group grid h-9 w-9 place-items-center rounded-md border border-transparent text-muted transition-colors hover:border-border hover:text-fg focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
          >
            <svg
              width={size}
              height={size}
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
              focusable="false"
            >
              <path d={ICONS[key]} />
            </svg>
          </a>
        </li>
      );
    })
  }
</ul>
