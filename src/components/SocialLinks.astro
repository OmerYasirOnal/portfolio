---
/**
 * SocialLinks — icon links to the owner's external profiles.
 *
 * All hrefs/handles come from `profile.links` (single source of truth); labels
 * and the "opens in a new tab" hint come from the i18n dictionary. No copy is
 * hard-coded here. Icons are inline single-path SVGs (fill: currentColor) so
 * they inherit theme colours and ship zero extra network requests.
 */
import { profile } from '../data/profile';
import { t, type Locale } from '../data/i18n';

type Platform = keyof typeof profile.links;

interface Props {
  locale: Locale;
  /** Which profiles to show, in order. Defaults to the hero set (spec §5). */
  platforms?: Platform[];
  /** Icon edge length in px. */
  size?: number;
  class?: string;
}

const {
  locale,
  platforms = ['github', 'linkedin', 'medium', 'youtube'],
  size = 18,
  class: className = '',
} = Astro.props;

/** simple-icons single-path glyphs (24×24 viewBox). */
const ICONS: Record<Platform, string> = {
