---
/**
 * LangToggle — a static EN | TR segmented control that preserves the current
 * route across locales. Given the current `locale` and `path`, it computes the
 * twin route with `altLocalePath` and renders both locales as links; the active
 * one is marked `aria-current`. No island/JS needed — these are plain <a>s.
 */
import { altLocalePath, t, type Locale } from '../data/i18n';

interface Props {
  locale: Locale;
  /** Current page path in the current locale, e.g. "/" or "/tr/projects". */
  path: string;
  class?: string;
}

const { locale, path, class: className = '' } = Astro.props;

const twin = altLocalePath(locale, path);
const enPath = locale === 'en' ? path : twin;
const trPath = locale === 'tr' ? path : twin;

const segments = [
  {
    code: 'en' as const,
    label: 'EN',
    href: enPath,
    active: locale === 'en',
    aria: t(locale, 'lang.switchToEn'),
  },
  {
    code: 'tr' as const,
    label: 'TR',
    href: trPath,
    active: locale === 'tr',
    aria: t(locale, 'lang.switchToTr'),
  },
];
---

<div
  class:list={[
    'inline-flex items-center rounded-md border border-border p-0.5 font-mono text-xs',
    className,
  ]}
  role="group"
  aria-label={t(locale, 'lang.label')}
>
  {
    segments.map((seg) => (
      <a
        href={seg.href}
        hreflang={seg.code}
        aria-current={seg.active ? 'true' : undefined}
        aria-label={seg.active ? undefined : seg.aria}
        class:list={[
          'rounded px-2 py-1 leading-none transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent',
          seg.active
            ? 'bg-accent/15 text-accent'
            : 'text-muted hover:text-fg',
        ]}
      >
        {seg.label}
      </a>
    ))
  }
</div>
