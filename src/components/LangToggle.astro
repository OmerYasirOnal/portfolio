---
/**
 * LangToggle - a static TR | EN segmented control that preserves the current
 * route across locales.
 */
import { altLocalePath, t, type Locale } from '../data/i18n';

interface Props {
  locale: Locale;
  /** Current page path in the current locale, e.g. "/" or "/en/projects". */
  path: string;
  class?: string;
}

const { locale, path, class: className = '' } = Astro.props;

const twin = altLocalePath(locale, path);
const trPath = locale === 'tr' ? path : twin;
const enPath = locale === 'en' ? path : twin;

const segments = [
  {
    code: 'tr' as const,
    label: 'TR',
    href: trPath,
    active: locale === 'tr',
    aria: t(locale, 'lang.switchToTr'),
  },
  {
    code: 'en' as const,
    label: 'EN',
    href: enPath,
    active: locale === 'en',
    aria: t(locale, 'lang.switchToEn'),
  },
];
---

<div
  class:list={[
    'inline-flex items-center rounded-lg border border-border bg-card p-0.5 text-xs font-semibold',
    className,
  ]}
  role="group"
  aria-label={t(locale, 'lang.label')}
>
  {
    segments.map((seg) => (
      <a
        href={seg.href}
        hreflang={seg.code}
        aria-current={seg.active ? 'true' : undefined}
        aria-label={seg.active ? undefined : seg.aria}
        class:list={[
          'rounded-md px-2.5 py-1.5 leading-none transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent',
          seg.active
            ? 'bg-accent/12 text-accent font-bold'
            : 'text-muted hover:text-fg',
        ]}
      >
        {seg.label}
      </a>
    ))
  }
</div>
