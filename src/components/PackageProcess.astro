---
/**
 * PackageProcess - the four-step "how we work" section on `/packages`.
 */
import { packageProcess } from '../data/packages';
import { t, type Locale } from '../data/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<section class="mx-auto max-w-6xl px-6 pb-16">
  <h2 class="text-2xl font-bold tracking-tight text-fg sm:text-3xl">
    {t(locale, 'packages.processTitle')}
  </h2>

  <ol class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4" role="list">
    {
      packageProcess.map((step) => (
        <li class="flex h-full flex-col rounded-2xl border border-border bg-card p-6 shadow-2xs">
          <h3 class="text-base font-bold tracking-tight text-fg">{step.title[locale]}</h3>
          <p class="mt-2.5 text-sm leading-relaxed text-muted">{step.description[locale]}</p>
        </li>
      ))
    }
  </ol>
</section>
