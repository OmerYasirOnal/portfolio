---
/**
 * SiteFooter - solid ink footer: an optional closing CTA, sitemap columns,
 * contact details and social profiles.
 */
import { profile } from '../data/profile';
import { t, localizePath, pick, type Locale } from '../data/i18n';
import { serviceGroups } from '../data/services';
import { landings } from '../data/landings';
import { mailtoHref, displayPhone } from '../lib/contact';
import SocialLinks from './SocialLinks.astro';
import WhatsAppButton from './WhatsAppButton.astro';
import Icon from './Icon.astro';
import Logo from './Logo.astro';

interface Props {
  locale: Locale;
  /** Hide the closing CTA block (contact page already is one). */
  hideCta?: boolean;
  /** Deprecated: the footer never adds top margin; pages own their bottom padding. */
  flush?: boolean;
}

const { locale, hideCta = false } = Astro.props;
const L = (tr: string, en: string) => pick(locale, { tr, en });
const year = new Date().getFullYear();

// Short sector labels for the footer; falls back to the landing's service name.
const sectorLabel: Record<string, string> = {
  '/psikologlar-icin-instagram-reels': 'Psikolog ve terapistler',
  '/guzellik-merkezleri-icin-web-sitesi-ve-reels': 'Güzellik merkezleri',
  '/kafe-ve-restoranlar-icin-reels-ve-google-gorunurluk': 'Kafe ve restoranlar',
  '/en/reels-for-therapists': 'Therapists and counsellors',
  '/en/ai-video-ads': 'AI video ads',
};
const sectors = landings
  .filter((l) => l.locale === locale)
  .map((l) => ({ href: `${l.slug}/`, label: sectorLabel[l.slug] ?? l.serviceName.charAt(0).toUpperCase() + l.serviceName.slice(1) }));
---

<footer class="bg-ink text-on-ink">
  {
    !hideCta && (
      <div class="border-b border-white/10">
      <div class="container-page py-14">
        <div class="flex flex-col gap-8 md:flex-row md:items-center md:justify-between">
          <div class="max-w-xl">
            <h2 class="text-2xl font-semibold tracking-tight sm:text-3xl">
              {L('Projenizi kısaca anlatın, size net bir planla döneyim.', 'Tell me about your project and I will come back with a clear plan.')}
            </h2>
            <p class="mt-3 text-[0.95rem] leading-relaxed text-white/70">
              {L('WhatsApp ya da e-posta ile yazabilirsiniz.', 'You can write on WhatsApp or by email.')}
            </p>
          </div>
          <div class="flex shrink-0 flex-wrap gap-3 md:flex-nowrap md:justify-end">
            <WhatsAppButton locale={locale} location="footer" variant="light" size="lg" />
            <a
              href={mailtoHref(locale)}
              data-track="email_click"
              data-track-location="footer"
              class="btn btn-lg btn-outline-light"
            >
              <Icon name="mail" size={18} />
              {t(locale, 'cta.email')}
            </a>
          </div>
        </div>
      </div>
      </div>
    )
  }

  <div class="container-page grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-[1.3fr_1fr_1fr_1fr]">
    <div>
      <a href={localizePath(locale, '/')} class="inline-flex items-center gap-3 text-lg font-semibold tracking-tight">
        <Logo size={36} class="text-on-ink" />
        <span>{profile.name}</span>
      </a>
      <p class="mt-3 max-w-xs text-sm leading-relaxed text-white/70">
        {L('Bilgisayar Mühendisi. Web sitesi, reklam yönetimi ve video içerik.', 'Computer Engineer. Websites, ad management and video content.')}
        <br />{profile.location[locale]}
      </p>
    </div>

    <div>
      <p class="label !text-white/55">{t(locale, 'nav.services')}</p>
      <ul class="mt-4 space-y-2.5 text-sm" role="list">
        {
          serviceGroups.map((g) => (
            <li>
              <a href={localizePath(locale, `/services/${g.id}`)} class="text-white/80 hover:text-white">
                {pick(locale, g.short)}
              </a>
            </li>
          ))
        }
      </ul>
      {sectors.length > 0 && (
        <>
          <p class="label mt-8 !text-white/55">{L('Sektörlere özel', 'By industry')}</p>
          <ul class="mt-4 space-y-2.5 text-sm" role="list">
            {sectors.map((x) => (
              <li><a href={x.href} class="text-white/80 hover:text-white">{x.label}</a></li>
            ))}
          </ul>
        </>
      )}
    </div>

    <div>
      <p class="label !text-white/55">{L('Site', 'Site')}</p>
      <ul class="mt-4 space-y-2.5 text-sm" role="list">
        <li><a href={localizePath(locale, '/projects')} class="text-white/80 hover:text-white">{t(locale, 'nav.work')}</a></li>
        <li><a href={localizePath(locale, '/about')} class="text-white/80 hover:text-white">{t(locale, 'nav.about')}</a></li>
        <li><a href={localizePath(locale, '/writing')} class="text-white/80 hover:text-white">{t(locale, 'nav.writing')}</a></li>
        <li><a href={localizePath(locale, '/cv')} class="text-white/80 hover:text-white">{t(locale, 'nav.cv')}</a></li>
        <li><a href={localizePath(locale, '/privacy')} class="text-white/80 hover:text-white">{t(locale, 'nav.privacy')}</a></li>
      </ul>
    </div>

    <div>
      <p class="label !text-white/55">{t(locale, 'nav.contact')}</p>
      <ul class="mt-4 space-y-2.5 text-sm" role="list">
        <li>
          <a href={mailtoHref(locale)} data-track="email_click" data-track-location="footer_list" class="break-all text-white/80 hover:text-white">
            {profile.email}
          </a>
        </li>
        <li>
          <a href={`tel:+${profile.whatsapp}`} data-track="phone_click" data-track-location="footer_list" class="text-white/80 hover:text-white">
            {displayPhone()}
          </a>
        </li>
        {
          profile.instagram.url && (
            <li>
              <a
                href={profile.instagram.url}
                target="_blank"
                rel="noopener noreferrer"
                data-track="instagram_click"
                data-track-location="footer_list"
                class="text-white/80 hover:text-white"
              >
                Instagram @{profile.instagram.handle}
              </a>
            </li>
          )
        }
      </ul>
      <SocialLinks locale={locale} platforms={['linkedin', 'github', 'medium', 'youtube']} class="-ml-2 mt-4 [&_a]:text-white/70 [&_a:hover]:text-white" />
    </div>
  </div>

  <div class="border-t border-white/10">
    <p class="container-page flex flex-wrap justify-between gap-2 py-6 text-xs text-white/55">
      <span>© {year} {profile.name}</span>
      <a href="#top" class="hover:text-white">{t(locale, 'footer.backToTop')} ↑</a>
    </p>
  </div>
</footer>
