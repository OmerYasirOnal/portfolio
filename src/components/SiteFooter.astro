---
/**
 * SiteFooter - shared executive footer for the home page and every sub-page.
 */
import { profile } from '../data/profile';
import { t, localizePath, type Locale } from '../data/i18n';
import SocialLinks from './SocialLinks.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const home = localizePath(locale, '/');
---

<footer class="border-t border-border/80 bg-card/50">
  <div
    class="mx-auto flex max-w-6xl flex-col gap-6 px-6 py-10 sm:flex-row sm:items-center sm:justify-between"
  >
    <div class="space-y-1.5">
      <a
        href={home}
        class="text-base font-bold tracking-tight text-fg transition-colors hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      >
        {profile.name}
      </a>
      <p class="text-sm text-muted">{profile.role[locale]} · {profile.location[locale]}</p>
    </div>

    <div class="flex flex-col items-start gap-3 sm:items-end">
      <SocialLinks
        locale={locale}
        platforms={['github', 'linkedin', 'medium', 'youtube', 'hackerrank']}
      />
      <a
        href="#top"
        class="text-xs font-semibold text-muted transition-colors hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      >
        {t(locale, 'footer.backToTop')} ↑
      </a>
    </div>
  </div>

  <div class="border-t border-border/60">
    <p
      class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-4 gap-y-1 px-6 py-5 text-xs text-muted"
    >
      <span>© {new Date().getFullYear()} {profile.name}. {t(locale, 'footer.rights')}</span>
      <span>{t(locale, 'footer.builtWith')}</span>
    </p>
  </div>
</footer>
