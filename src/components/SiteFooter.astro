---
/**
 * SiteFooter — shared footer for the home page and every sub-page. Brand, role
 * and location come from `profile`; every label comes from the i18n dictionary.
 */
import { profile } from '../data/profile';
import { t, localizePath, type Locale } from '../data/i18n';
import SocialLinks from './SocialLinks.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const home = localizePath(locale, '/');
---

<footer class="border-t border-border/60">
  <div
    class="mx-auto flex max-w-5xl flex-col gap-6 px-6 py-10 sm:flex-row sm:items-center sm:justify-between"
  >
    <div class="space-y-1">
      <a
        href={home}
        class="font-mono text-sm font-medium text-fg transition-colors hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      >
        {profile.name}
      </a>
      <p class="text-sm text-muted">{profile.role[locale]} · {profile.location[locale]}</p>
    </div>

    <div class="flex flex-col items-start gap-3 sm:items-end">
      <SocialLinks
        locale={locale}
        platforms={['github', 'linkedin', 'medium', 'youtube', 'hackerrank']}
      />
      <a
        href="#top"
        class="font-mono text-xs text-muted transition-colors hover:text-fg focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      >
        {t(locale, 'footer.backToTop')} ↑
      </a>
    </div>
  </div>

  <div class="border-t border-border/40">
    <p
      class="mx-auto flex max-w-5xl flex-wrap items-center gap-x-2 gap-y-1 px-6 py-5 font-mono text-xs text-muted"
    >
      <span>© {new Date().getFullYear()} {profile.name}</span>
      <span aria-hidden="true">·</span>
      <span>{t(locale, 'footer.builtWith')}</span>
    </p>
  </div>
</footer>
