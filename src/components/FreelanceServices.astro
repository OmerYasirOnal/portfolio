---
/**
 * FreelanceServices - home-page overview of the 4 corporate software & digital
 * solution areas. Links directly to the on-page contact form (pre-selecting
 * the chosen topic) and to `/packages` for full details.
 */
import { packageTiers } from '../data/packages';
import { t, localizePath, type Locale } from '../data/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const packagesHref = localizePath(locale, '/packages');
---

<div>
  <p class="max-w-3xl text-base leading-relaxed text-muted sm:text-lg">
    {t(locale, 'services.intro')}
  </p>

  <ul class="mt-8 grid gap-6 sm:grid-cols-2" role="list">
    {
      packageTiers.map((tier) => (
        <li
          class:list={[
            'group flex h-full flex-col rounded-2xl border p-6 transition-all duration-200 hover:-translate-y-0.5 hover:border-accent/60 hover:shadow-md sm:p-7',
            tier.highlighted
              ? 'border-accent/70 bg-card shadow-sm'
              : 'border-border bg-card shadow-2xs',
          ]}
        >
          <div class="flex flex-wrap items-center justify-between gap-2">
            <span class="rounded-full bg-accent/10 px-3 py-1 text-xs font-semibold text-accent">
              {tier.pages[locale]}
            </span>
            {tier.highlighted && (
              <span class="rounded-full bg-accent px-3 py-1 text-xs font-semibold text-bg">
                {t(locale, 'packages.mostPopular')}
              </span>
            )}
          </div>

          <h3 class="mt-4 text-xl font-bold tracking-tight text-fg">{tier.name[locale]}</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">{tier.tagline[locale]}</p>

          <ul class="mt-5 flex-1 space-y-2.5 border-t border-border/70 pt-5" role="list">
            {tier.features.map((feature) => (
              <li class="flex items-start gap-2.5 text-sm leading-relaxed text-muted">
                <svg
                  class="mt-0.5 h-4 w-4 shrink-0 text-accent"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M20 6 9 17l-5-5" />
                </svg>
                <span>{feature[locale]}</span>
              </li>
            ))}
          </ul>

          <div class="mt-6 flex items-center justify-between border-t border-border/60 pt-4">
            <span class="text-xs font-medium text-muted">
              {t(locale, 'packages.timeline')}: <strong class="font-semibold text-fg">{tier.timeline[locale]}</strong>
            </span>
            <a
              href="#contact"
              data-select-topic={tier.id}
              class="inline-flex items-center gap-1 text-sm font-semibold text-accent transition-colors hover:text-fg"
            >
              {t(locale, 'packages.cta')} →
            </a>
          </div>
        </li>
      ))
    }
  </ul>

  <div class="mt-8 flex flex-wrap items-center gap-4">
    <a
      href={packagesHref}
      class="inline-flex items-center gap-1.5 text-sm font-semibold text-accent transition-colors hover:text-fg focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
    >
      {t(locale, 'services.cta')} →
    </a>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLAnchorElement>('[data-select-topic]').forEach((link) => {
    link.addEventListener('click', () => {
      const topic = link.dataset.selectTopic;
      if (!topic) return;
      const select = document.querySelector<HTMLSelectElement>('select[name="topic"]');
      if (select) {
        select.value = topic;
      }
    });
  });
</script>
