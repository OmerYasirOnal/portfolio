---
/**
 * FreelanceServices - home-page overview of the 4 corporate software & digital
 * solution areas. Links directly to the on-page contact form (pre-selecting
 * the chosen topic) and to `/packages` for full details.
 */
import { packageTiers } from '../data/packages';
import { t, localizePath, type Locale } from '../data/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const packagesHref = localizePath(locale, '/packages');
---

<div data-reveal>
  <p class="max-w-3xl text-base leading-relaxed text-muted sm:text-lg">
    {t(locale, 'services.intro')}
  </p>

  <ul class="mt-9 grid gap-6 lg:grid-cols-12" role="list">
    {
      packageTiers.map((tier, idx) => {
        // Asymmetric bento span: rows alternate 7/5 and 5/7 on desktop so it doesn't look like a rigid 2x2 grid
        const spanClass =
          idx === 0 || idx === 3 ? 'lg:col-span-7' : 'lg:col-span-5';
        return (
          <li
            data-spotlight
            class:list={[
              spanClass,
              'group relative flex h-full flex-col overflow-hidden rounded-3xl border p-6 backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 sm:p-8',
              tier.highlighted
                ? 'border-accent/60 bg-gradient-to-br from-card via-card to-emerald-500/[0.07] shadow-lg shadow-accent/10'
                : 'border-accent/20 bg-card/80 shadow-sm hover:border-accent/50 hover:shadow-lg hover:shadow-accent/5',
            ]}
          >
            <div class="relative z-10 flex flex-wrap items-center justify-between gap-2">
              <div class="flex items-center gap-2.5">
                <span class="grid h-8 w-8 place-items-center rounded-full bg-accent/12 font-mono text-xs font-bold text-accent">
                  0{idx + 1}
                </span>
                <span class="rounded-full border border-accent/25 bg-accent/8 px-3.5 py-1 text-xs font-semibold text-accent">
                  {tier.pages[locale]}
                </span>
              </div>
              {tier.highlighted && (
                <span class="rounded-full bg-gradient-to-r from-emerald-600 to-teal-600 px-3.5 py-1 text-xs font-semibold text-white shadow-xs">
                  {t(locale, 'packages.mostPopular')}
                </span>
              )}
            </div>

            <h3 class="relative z-10 mt-5 text-xl font-bold tracking-tight text-fg transition-colors group-hover:text-accent sm:text-2xl">
              {tier.name[locale]}
            </h3>
            <p class="relative z-10 mt-2 text-sm leading-relaxed text-muted">
              {tier.tagline[locale]}
            </p>

            <ul class="relative z-10 mt-6 flex-1 space-y-2.5 border-t border-accent/15 pt-5" role="list">
              {tier.features.map((feature) => (
                <li class="flex items-start gap-2.5 text-sm leading-relaxed text-muted">
                  <span class="mt-1 grid h-4 w-4 shrink-0 place-items-center rounded-full bg-accent/15 text-accent">
                    <svg
                      class="h-2.5 w-2.5"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="3"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M20 6 9 17l-5-5" />
                    </svg>
                  </span>
                  <span>{feature[locale]}</span>
                </li>
              ))}
            </ul>

            <div class="relative z-10 mt-6 flex items-center justify-between border-t border-accent/15 pt-4">
              <span class="text-xs font-medium text-muted">
                {t(locale, 'packages.timeline')}:{' '}
                <strong class="font-semibold text-fg">{tier.timeline[locale]}</strong>
              </span>
              <a
                href="#contact"
                data-select-topic={tier.id}
                class="inline-flex items-center gap-1.5 rounded-full bg-accent/10 px-4 py-1.5 text-xs font-bold text-accent transition-all hover:bg-accent hover:text-white"
              >
                {t(locale, 'packages.cta')} →
              </a>
            </div>
          </li>
        );
      })
    }
  </ul>

  <div class="mt-8 flex flex-wrap items-center gap-4">
    <a
      href={packagesHref}
      class="inline-flex items-center gap-2 rounded-full border border-accent/30 bg-card/80 px-5 py-2.5 text-sm font-semibold text-accent shadow-2xs backdrop-blur-md transition-all hover:-translate-y-0.5 hover:border-accent hover:bg-accent hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
    >
      {t(locale, 'services.cta')} →
    </a>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLAnchorElement>('[data-select-topic]').forEach((link) => {
    link.addEventListener('click', () => {
      const topic = link.dataset.selectTopic;
      if (!topic) return;
      const select = document.querySelector<HTMLSelectElement>('select[name="topic"]');
      if (select) {
        select.value = topic;
      }
    });
  });
</script>
