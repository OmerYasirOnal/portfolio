---
/**
 * Contact — the closing "get in touch" section (spec §5.7).
 *
 * All copy comes from `profile` + the i18n dictionary (nothing hard-coded):
 * the intro line, the availability CTA (`contact.availability`), the email
 * (mailto, from `profile.email`), the CV link, and the full set of social
 * profiles (via <SocialLinks>). The phone number is intentionally omitted —
 * per spec it is CV-only; the public site uses email.
 *
 * Visual: a single bordered "panel" laid out like a terminal card. The email
 * sits in a monospace chip with a progressive-enhancement copy button (the
 * mailto link is the no-JS fallback). The only motion is the copy-feedback
 * swap, which is inert under prefers-reduced-motion (no animation used).
 */
import { profile } from '../data/profile';
import { t, localizePath, type Locale } from '../data/i18n';
import SocialLinks from './SocialLinks.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const email = profile.email;
const mailto = `mailto:${email}`;
const cvHref = localizePath(locale, '/cv');
const availability = t(locale, 'contact.availability');
---

<div
  class="rounded-2xl border border-border bg-card/40 p-6 sm:p-10"
  data-contact
>
  <div class="grid gap-10 lg:grid-cols-[1.1fr_1fr] lg:items-start">
    {/* Left: intro + availability signal */}
    <div>
      <p class="max-w-md text-base leading-relaxed text-muted sm:text-lg">
        {t(locale, 'contact.intro')}
      </p>

      <p
        class="mt-6 inline-flex items-start gap-2.5 rounded-lg border border-emerald-500/25 bg-emerald-500/[0.06] px-3.5 py-2.5 font-mono text-sm leading-snug text-emerald-700 dark:text-emerald-300/90"
      >
        <span
          class="relative mt-1.5 flex h-2 w-2 shrink-0"
          aria-hidden="true"
        >
          <span
            class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400/60"
          ></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-400"></span>
        </span>
        {availability}
      </p>
    </div>

    {/* Right: actions */}
    <div class="space-y-5">
      {/* Email chip: mono address + copy button (mailto = no-JS fallback) */}
      <div
        class="flex items-center gap-2 rounded-lg border border-border bg-bg/60 p-2 pl-4"
      >
        <a
          href={mailto}
          class="min-w-0 flex-1 truncate font-mono text-sm text-fg transition-colors hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        >
          {email}
        </a>
        <button
          type="button"
          data-copy-email
          data-email={email}
          data-label-copy={t(locale, 'contact.copyEmail')}
          data-label-copied={t(locale, 'contact.copied')}
          aria-label={t(locale, 'contact.copyEmail')}
          class="grid h-9 w-9 shrink-0 place-items-center rounded-md border border-border text-muted transition-colors hover:border-accent hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        >
          {/* copy glyph */}
          <svg
            data-icon-copy
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            focusable="false"
          >
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
          {/* check glyph (revealed after copy) */}
          <svg
            data-icon-copied
            class="hidden text-accent"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            focusable="false"
          >
            <path d="M20 6 9 17l-5-5"></path>
          </svg>
        </button>
      </div>

      {/* Primary + secondary CTAs */}
      <div class="flex flex-wrap gap-3">
        <a
          href={mailto}
          class="inline-flex items-center gap-2 rounded-md bg-accent px-5 py-2.5 text-sm font-medium text-bg transition-opacity hover:opacity-90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        >
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect x="2" y="4" width="20" height="16" rx="2"></rect>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
          </svg>
          {t(locale, 'contact.emailMe')}
        </a>

        <a
          href={cvHref}
          class="inline-flex items-center gap-2 rounded-md border border-border px-5 py-2.5 text-sm font-medium text-fg transition-colors hover:border-accent hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        >
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <path d="M14 2v6h6"></path>
          </svg>
          {t(locale, 'contact.viewCv')}
        </a>
      </div>

      {/* Socials — full set, incl. HackerRank */}
      <div class="pt-1">
        <p
          class="mb-2 font-mono text-xs uppercase tracking-widest text-accent/70"
        >
          {t(locale, 'contact.elsewhere')}
        </p>
        <SocialLinks
          locale={locale}
          platforms={['github', 'linkedin', 'medium', 'youtube', 'hackerrank']}
          class="-ml-1.5"
        />
      </div>
    </div>
  </div>
</div>

<script>
  // Progressive enhancement: copy the email to the clipboard and show a brief
  // "Copied" confirmation. The mailto link is the no-JS fallback, so this is
  // purely additive and safe to fail silently if the Clipboard API is absent.
  const btn = document.querySelector<HTMLButtonElement>('[data-copy-email]');
  if (btn && navigator.clipboard) {
    const copyIcon = btn.querySelector<SVGElement>('[data-icon-copy]');
    const copiedIcon = btn.querySelector<SVGElement>('[data-icon-copied]');
    const labelCopy = btn.dataset.labelCopy ?? 'Copy';
    const labelCopied = btn.dataset.labelCopied ?? 'Copied';
    let timer: number | undefined;

    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.email ?? '');
      } catch {
        return;
      }
      copyIcon?.classList.add('hidden');
      copiedIcon?.classList.remove('hidden');
      btn.setAttribute('aria-label', labelCopied);
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        copiedIcon?.classList.add('hidden');
        copyIcon?.classList.remove('hidden');
        btn.setAttribute('aria-label', labelCopy);
      }, 1600);
    });
  }
</script>
