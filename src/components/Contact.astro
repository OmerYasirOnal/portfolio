---
/**
 * Contact - executive contact form + direct contact channels.
 *
 * Visitors can fill out the form (Name, Email, Phone/WhatsApp, Topic, Message)
 * to send an inquiry to `engomeryasironal@gmail.com` via `/api/contact`
 * (with automatic mailto fallback if the serverless API key is not configured),
 * or reach out directly via email, WhatsApp, and professional profiles.
 */
import { profile } from '../data/profile';
import { t, localizePath, type Locale } from '../data/i18n';
import SocialLinks from './SocialLinks.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const email = profile.email;
const mailto = `mailto:${email}`;
const whatsappHref = `https://wa.me/${profile.whatsapp}?text=${encodeURIComponent(
  t(locale, 'packages.whatsappPrefill'),
)}`;
const cvHref = localizePath(locale, '/cv');
const availability = t(locale, 'contact.availability');

const topics = [
  { value: 'web', label: t(locale, 'contact.form.topics.web') },
  { value: 'mobile', label: t(locale, 'contact.form.topics.mobile') },
  { value: 'brand', label: t(locale, 'contact.form.topics.brand') },
  { value: 'seo-aio', label: t(locale, 'contact.form.topics.seo') },
  { value: 'ai', label: t(locale, 'contact.form.topics.ai') },
  { value: 'other', label: t(locale, 'contact.form.topics.other') },
];
---

<div
  data-spotlight
  data-reveal
  class="relative overflow-hidden rounded-3xl border border-accent/25 bg-card/85 p-6 shadow-xl shadow-accent/5 backdrop-blur-xl sm:p-10"
  data-contact
>
  <div class="relative z-10 grid gap-10 lg:grid-cols-[1.3fr_0.9fr] lg:items-start">
    {/* Left column: Interactive contact form */}
    <div>
      <p class="max-w-xl text-base leading-relaxed text-muted">
        {t(locale, 'contact.intro')}
      </p>

      <form
        data-contact-form
        data-target-email={email}
        data-msg-sending={t(locale, 'contact.form.sending')}
        data-msg-success={t(locale, 'contact.form.success')}
        data-msg-fallback={t(locale, 'contact.form.fallback')}
        data-msg-error={t(locale, 'contact.form.error')}
        class="mt-6 space-y-4"
      >
        {/* Honeypot anti-spam field */}
        <div class="hidden" aria-hidden="true">
          <label>
            Website
            <input type="text" name="website" tabindex="-1" autocomplete="off" />
          </label>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label for="contact-name" class="block text-xs font-semibold text-fg">
              {t(locale, 'contact.form.name')} *
            </label>
            <input
              id="contact-name"
              name="name"
              type="text"
              required
              minlength="2"
              maxlength="120"
              placeholder={t(locale, 'contact.form.namePlaceholder')}
              class="mt-1.5 w-full rounded-2xl border border-accent/20 bg-bg/80 px-4 py-3 text-sm text-fg placeholder:text-muted/60 transition-colors focus:border-accent focus:outline-none"
            />
          </div>

          <div>
            <label for="contact-email" class="block text-xs font-semibold text-fg">
              {t(locale, 'contact.form.email')} *
            </label>
            <input
              id="contact-email"
              name="email"
              type="email"
              required
              maxlength="160"
              placeholder={t(locale, 'contact.form.emailPlaceholder')}
              class="mt-1.5 w-full rounded-2xl border border-accent/20 bg-bg/80 px-4 py-3 text-sm text-fg placeholder:text-muted/60 transition-colors focus:border-accent focus:outline-none"
            />
          </div>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label for="contact-phone" class="block text-xs font-semibold text-fg">
              {t(locale, 'contact.form.phone')}
            </label>
            <input
              id="contact-phone"
              name="phone"
              type="tel"
              maxlength="40"
              placeholder={t(locale, 'contact.form.phonePlaceholder')}
              class="mt-1.5 w-full rounded-2xl border border-accent/20 bg-bg/80 px-4 py-3 text-sm text-fg placeholder:text-muted/60 transition-colors focus:border-accent focus:outline-none"
            />
          </div>

          <div>
            <label for="contact-topic" class="block text-xs font-semibold text-fg">
              {t(locale, 'contact.form.topic')}
            </label>
            <select
              id="contact-topic"
              name="topic"
              class="mt-1.5 w-full rounded-2xl border border-accent/20 bg-bg/80 px-4 py-3 text-sm text-fg transition-colors focus:border-accent focus:outline-none"
            >
              {
                topics.map((tp) => (
                  <option value={tp.value}>{tp.label}</option>
                ))
              }
            </select>
          </div>
        </div>

        <div>
          <label for="contact-message" class="block text-xs font-semibold text-fg">
            {t(locale, 'contact.form.message')} *
          </label>
          <textarea
            id="contact-message"
            name="message"
            required
            rows="4"
            minlength="10"
            maxlength="4000"
            placeholder={t(locale, 'contact.form.messagePlaceholder')}
            class="mt-1.5 w-full rounded-2xl border border-accent/20 bg-bg/80 px-4 py-3 text-sm text-fg placeholder:text-muted/60 transition-colors focus:border-accent focus:outline-none"
          ></textarea>
        </div>

        <div class="flex flex-wrap items-center justify-between gap-4 pt-1">
          <button
            type="submit"
            data-submit-btn
            data-default-label={t(locale, 'contact.form.submit')}
            class="inline-flex cursor-pointer items-center gap-2 rounded-full bg-gradient-to-r from-emerald-600 via-emerald-500 to-teal-600 px-7 py-3.5 text-sm font-bold text-white shadow-lg shadow-emerald-600/25 transition-all hover:-translate-y-0.5 hover:shadow-xl hover:shadow-emerald-500/35 disabled:opacity-60 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
          >
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="m22 2-7 20-4-9-9-4Z" />
              <path d="M22 2 11 13" />
            </svg>
            <span data-submit-label>{t(locale, 'contact.form.submit')}</span>
          </button>

          <p
            data-form-status
            role="status"
            aria-live="polite"
            class="hidden text-xs font-semibold"
          ></p>
        </div>
      </form>
    </div>

    {/* Right column: Direct channels, availability & CV */}
    <div class="space-y-6 rounded-3xl border border-accent/20 bg-bg/75 p-6 backdrop-blur-md">
      <div>
        <h3 class="text-xs font-bold uppercase tracking-wider text-accent">
          {t(locale, 'contact.directTitle')}
        </h3>

        <p
          class="mt-3 inline-flex items-start gap-2.5 rounded-2xl border border-emerald-500/25 bg-emerald-500/[0.08] px-3.5 py-2.5 text-xs font-medium leading-relaxed text-emerald-900 dark:text-emerald-200"
        >
          <span
            class="relative mt-1 flex h-2 w-2 shrink-0"
            aria-hidden="true"
          >
            <span
              class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-500/60"
            ></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500"></span>
          </span>
          {availability}
        </p>
      </div>

      {/* Email address + copy button */}
      <div>
        <div class="flex items-center gap-2 rounded-2xl border border-accent/20 bg-card p-2.5 pl-4 shadow-2xs">
          <a
            href={mailto}
            class="min-w-0 flex-1 truncate text-sm font-semibold text-fg transition-colors hover:text-accent"
          >
            {email}
          </a>
          <button
            type="button"
            data-copy-email
            data-email={email}
            data-label-copy={t(locale, 'contact.copyEmail')}
            data-label-copied={t(locale, 'contact.copied')}
            aria-label={t(locale, 'contact.copyEmail')}
            class="grid h-8 w-8 shrink-0 cursor-pointer place-items-center rounded-xl border border-accent/25 text-muted transition-colors hover:border-accent hover:text-accent"
          >
            <svg
              data-icon-copy
              width="15"
              height="15"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
            </svg>
            <svg
              data-icon-copied
              class="hidden text-accent"
              width="15"
              height="15"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M20 6 9 17l-5-5"></path>
            </svg>
          </button>
        </div>
      </div>

      {/* Quick action buttons */}
      <div class="flex flex-wrap gap-2.5">
        <a
          href={whatsappHref}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-full bg-[#25D366] px-4.5 py-2.5 text-xs font-bold text-[#051c14] shadow-2xs transition-all hover:-translate-y-0.5 hover:opacity-95"
        >
          {t(locale, 'contact.whatsappMe')} ↗
        </a>

        <a
          href={cvHref}
          class="inline-flex items-center gap-2 rounded-full border border-accent/25 bg-card px-4.5 py-2.5 text-xs font-semibold text-fg shadow-2xs transition-all hover:-translate-y-0.5 hover:border-accent hover:text-accent"
        >
          {t(locale, 'contact.viewCv')}
        </a>
      </div>

      {/* Socials */}
      <div class="border-t border-accent/15 pt-4">
        <p class="mb-2 text-xs font-semibold uppercase tracking-wider text-muted">
          {t(locale, 'contact.elsewhere')}
        </p>
        <SocialLinks
          locale={locale}
          platforms={['github', 'linkedin', 'medium', 'youtube', 'hackerrank']}
          class="-ml-1.5"
        />
      </div>
    </div>
  </div>
</div>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-copy-email]');
  if (btn && navigator.clipboard) {
    const copyIcon = btn.querySelector<SVGElement>('[data-icon-copy]');
    const copiedIcon = btn.querySelector<SVGElement>('[data-icon-copied]');
    const labelCopy = btn.dataset.labelCopy ?? 'Copy';
    const labelCopied = btn.dataset.labelCopied ?? 'Copied';
    let timer: number | undefined;

    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.email ?? '');
      } catch {
        return;
      }
      copyIcon?.classList.add('hidden');
      copiedIcon?.classList.remove('hidden');
      btn.setAttribute('aria-label', labelCopied);
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        copiedIcon?.classList.add('hidden');
        copyIcon?.classList.remove('hidden');
        btn.setAttribute('aria-label', labelCopy);
      }, 1600);
    });
  }

  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  if (form) {
    const submitBtn = form.querySelector<HTMLButtonElement>('[data-submit-btn]');
    const submitLabel = form.querySelector<HTMLElement>('[data-submit-label]');
    const statusEl = form.querySelector<HTMLElement>('[data-form-status]');

    const openMailtoFallback = (payload: {
      name: string;
      email: string;
      phone: string;
      topicLabel: string;
      message: string;
    }) => {
      const targetEmail = form.dataset.targetEmail ?? 'engomeryasironal@gmail.com';
      const subject = `[omeryasironal.com] ${payload.topicLabel} - ${payload.name}`;
      const bodyLines = [
        `Ad Soyad / Name: ${payload.name}`,
        `E-posta / Email: ${payload.email}`,
        payload.phone ? `Telefon / Phone: ${payload.phone}` : '',
        `Konu / Topic: ${payload.topicLabel}`,
        '',
        payload.message,
      ].filter(Boolean);
      const href = `mailto:${targetEmail}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(bodyLines.join('\n'))}`;
      window.location.href = href;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!submitBtn || !submitLabel || !statusEl) return;

      const fd = new FormData(form);
      const website = String(fd.get('website') ?? '').trim();
      if (website) return;

      const name = String(fd.get('name') ?? '').trim();
      const email = String(fd.get('email') ?? '').trim();
      const phone = String(fd.get('phone') ?? '').trim();
      const topic = String(fd.get('topic') ?? 'other').trim();
      const message = String(fd.get('message') ?? '').trim();
      const topicSelect = form.querySelector<HTMLSelectElement>('select[name="topic"]');
      const topicLabel =
        topicSelect?.selectedOptions?.[0]?.textContent?.trim() ?? topic;

      submitBtn.disabled = true;
      submitLabel.textContent = form.dataset.msgSending ?? 'Sending...';
      statusEl.classList.add('hidden');

      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, email, phone, topic: topicLabel, message, website }),
        });

        const data = await res.json().catch(() => ({}));

        if (res.ok && data.ok) {
          statusEl.textContent = form.dataset.msgSuccess ?? 'Sent!';
          statusEl.className = 'text-xs font-semibold text-emerald-600 dark:text-emerald-400';
          form.reset();
        } else {
          openMailtoFallback({ name, email, phone, topicLabel, message });
          statusEl.textContent = form.dataset.msgFallback ?? '';
          statusEl.className = 'text-xs font-semibold text-accent';
        }
      } catch {
        openMailtoFallback({ name, email, phone, topicLabel, message });
        statusEl.textContent = form.dataset.msgFallback ?? '';
        statusEl.className = 'text-xs font-semibold text-accent';
      } finally {
        submitBtn.disabled = false;
        submitLabel.textContent = submitBtn.dataset.defaultLabel ?? 'Send';
      }
    });
  }
</script>
