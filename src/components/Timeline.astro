---
/**
 * Timeline - chronological list of work, consulting, and research experience.
 */
import { getCollection } from 'astro:content';
import type { Locale } from '../data/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const items = (await getCollection('experience')).sort(
  (a, b) => a.data.order - b.data.order,
);

const isPresent = (end: string) =>
  end.trim().toLowerCase() === 'present' || end.trim().toLowerCase() === 'devam';
---

<ol class="divide-y divide-border border-y border-border" role="list">
  {
    items.map((entry) => {
      const { role_en, role_tr, org, location, start, end, bullets_en, bullets_tr } = entry.data;
      const role = locale === 'tr' ? role_tr : role_en;
      const bullets = locale === 'tr' ? bullets_tr : bullets_en;
      const current = isPresent(end);
      return (
        <li class="grid gap-3 py-6 md:grid-cols-[11rem_1fr] md:gap-8">
          <p class="font-mono text-xs text-muted md:pt-1">
            <time>{start}</time> - {current ? <span class="text-accent">{end}</span> : <time>{end}</time>}
          </p>
          <div>
            <h3 class="text-lg font-semibold tracking-tight text-fg">{role}</h3>
            <p class="mt-0.5 text-sm text-muted">
              <span class="font-medium text-fg/90">{org}</span> · {location}
            </p>
            {bullets.length > 0 && (
              <ul class="mt-3 space-y-1.5 text-[0.95rem] leading-relaxed text-muted" role="list">
                {bullets.map((bullet) => (
                  <li class="relative pl-4">
                    <span aria-hidden="true" class="absolute left-0 top-[0.65em] h-1 w-1 rounded-full bg-accent" />
                    {bullet}
                  </li>
                ))}
              </ul>
            )}
          </div>
        </li>
      );
    })
  }
</ol>
