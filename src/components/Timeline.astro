---
/**
 * Timeline - chronological list of work, consulting, and research experience.
 */
import { getCollection } from 'astro:content';
import type { Locale } from '../data/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const items = (await getCollection('experience')).sort(
  (a, b) => a.data.order - b.data.order,
);

const isPresent = (end: string) =>
  end.trim().toLowerCase() === 'present' || end.trim().toLowerCase() === 'devam';
---

<ol class="relative ml-2 space-y-8 border-l-2 border-border pl-7 sm:pl-8" role="list">
  {
    items.map((entry) => {
      const { role_en, role_tr, org, location, start, end, bullets_en, bullets_tr } =
        entry.data;
      const role = locale === 'tr' ? role_tr : role_en;
      const bullets = locale === 'tr' ? bullets_tr : bullets_en;
      const current = isPresent(end);
      return (
        <li class="relative rounded-2xl border border-border bg-card p-5 shadow-2xs sm:p-6">
          {/* node on the rail */}
          <span
            aria-hidden="true"
            class:list={[
              'absolute -left-[2.3rem] top-6 grid h-3.5 w-3.5 place-items-center rounded-full border-2 bg-bg sm:-left-[2.55rem]',
              current ? 'border-accent' : 'border-border',
            ]}
          >
            {current && (
              <span class="h-1.5 w-1.5 rounded-full bg-accent" aria-hidden="true" />
            )}
          </span>

          <div class="flex flex-wrap items-center justify-between gap-2">
            <h3 class="text-base font-bold tracking-tight text-fg sm:text-lg">
              {role}
            </h3>

            <span
              class:list={[
                'inline-flex items-center rounded-full px-3 py-0.5 text-xs font-semibold',
                current
                  ? 'bg-accent/10 text-accent'
                  : 'border border-border bg-bg text-muted',
              ]}
            >
              <time>{start}</time>
              <span aria-hidden="true" class="mx-1.5">-</span>
              {current ? <span>{end}</span> : <time>{end}</time>}
            </span>
          </div>

          <p class="mt-1 text-sm font-medium text-muted">
            <span class="text-fg/90">{org}</span>
            <span aria-hidden="true" class="mx-1.5 text-border">·</span>
            <span>{location}</span>
          </p>

          {bullets.length > 0 && (
            <ul class="mt-3.5 space-y-2 text-sm leading-relaxed text-muted" role="list">
              {bullets.map((bullet) => (
                <li class="relative pl-4">
                  <span
                    aria-hidden="true"
                    class="absolute left-0 top-[0.55em] h-1.5 w-1.5 rounded-full bg-accent/70"
                  />
                  {bullet}
                </li>
              ))}
            </ul>
          )}
        </li>
      );
    })
  }
</ol>
