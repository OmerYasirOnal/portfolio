---
/**
 * SiteHeader - sticky executive navigation bar shared across the home page and sub-pages.
 */
import { profile } from '../data/profile';
import { t, localizePath, type Locale } from '../data/i18n';
import LangToggle from './LangToggle.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  locale: Locale;
  /** Current page path in the current locale (for the LangToggle twin route). */
  path: string;
}

const { locale, path } = Astro.props;

const home = localizePath(locale, '/');

const navLinks = [
  { key: 'nav.services', href: `${home}#services` },
  { key: 'nav.work', href: `${home}#work` },
  { key: 'nav.about', href: `${home}#about` },
  { key: 'nav.writing', href: localizePath(locale, '/writing') },
  { key: 'nav.cv', href: localizePath(locale, '/cv') },
];
---

<header id="top" class="sticky top-3 z-40 px-4 sm:top-4 sm:px-6">
  <nav
    class="mx-auto flex max-w-6xl items-center justify-between gap-4 rounded-full border border-accent/25 bg-card/80 px-4 py-2.5 shadow-lg shadow-accent/5 backdrop-blur-xl sm:px-6 sm:py-3"
    aria-label="Primary"
  >
    <a
      href={home}
      class="group flex items-center gap-3 text-fg transition-colors hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
    >
      <span
        class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-gradient-to-br from-emerald-500 to-teal-600 text-xs font-bold tracking-tight text-white shadow-sm shadow-emerald-500/30 transition-transform duration-300 group-hover:scale-105"
        aria-hidden="true"
      >
        ÖY
      </span>
      <span class="flex flex-col">
        <span class="text-sm font-bold tracking-tight text-fg sm:text-base">
          {profile.name}
        </span>
        <span class="hidden text-[0.7rem] font-medium text-accent lg:inline">
          {locale === 'tr' ? 'Bilgisayar Mühendisi' : 'Computer Engineer'}
        </span>
      </span>
    </a>

    <div class="flex items-center gap-1.5 sm:gap-2">
      <ul class="mr-1 hidden items-center gap-0.5 md:flex" role="list">
        {
          navLinks.map((item) => (
            <li>
              <a
                href={item.href}
                class="rounded-full px-3.5 py-1.5 text-sm font-medium text-muted transition-all hover:bg-accent/10 hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
              >
                {t(locale, item.key)}
              </a>
            </li>
          ))
        }
      </ul>

      <LangToggle locale={locale} path={path} />
      <ThemeToggle locale={locale} />

      <a
        href={`${home}#contact`}
        class="ml-1 inline-flex items-center gap-1.5 rounded-full bg-gradient-to-r from-emerald-600 to-teal-600 px-4 py-2 text-xs font-semibold text-white shadow-sm shadow-emerald-600/25 transition-all hover:-translate-y-0.5 hover:shadow-md hover:shadow-emerald-500/35 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent sm:px-4.5 sm:text-sm"
      >
        <span class="h-1.5 w-1.5 rounded-full bg-emerald-200" aria-hidden="true"></span>
        {t(locale, 'nav.cta')}
      </a>
    </div>
  </nav>
</header>
