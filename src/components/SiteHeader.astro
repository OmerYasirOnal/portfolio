---
/**
 * SiteHeader - sticky, solid top bar with a hairline. Logo + name on the left,
 * five primary links, language/theme switches and one primary CTA on desktop.
 * On mobile the CTA lives in the sticky bottom bar instead.
 */
import { profile } from '../data/profile';
import { t, localizePath, type Locale } from '../data/i18n';
import LangToggle from './LangToggle.astro';
import ThemeToggle from './ThemeToggle.astro';
import WhatsAppButton from './WhatsAppButton.astro';
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import type { ContactTopic } from '../lib/contact';

interface Props {
  locale: Locale;
  /** Current page path in the current locale (for the LangToggle twin route). */
  path: string;
  contactTopic?: ContactTopic;
}

const { locale, path, contactTopic = 'general' } = Astro.props;

const home = localizePath(locale, '/');
const navLinks = [
  { key: 'nav.services', href: localizePath(locale, '/services') },
  { key: 'nav.work', href: localizePath(locale, '/projects') },
  { key: 'nav.about', href: localizePath(locale, '/about') },
  { key: 'nav.writing', href: localizePath(locale, '/writing') },
  { key: 'nav.contact', href: localizePath(locale, '/contact') },
];

const norm = (p: string) => (p.endsWith('/') ? p : `${p}/`);
const current = norm(path);
const isActive = (href: string) => current.startsWith(norm(href));
---

<header id="top" class="site-header sticky top-0 z-40">
  <nav class="container-page flex h-16 items-center justify-between gap-2 sm:gap-4 md:h-[4.25rem]" aria-label="Primary">
    <a href={home} class="flex min-w-0 items-center gap-2.5 sm:gap-3">
      <Logo size={36} class="h-8 w-8 shrink-0 text-fg sm:h-9 sm:w-9" />
      <span class="flex min-w-0 flex-col leading-tight">
        <span class="truncate text-[0.95rem] font-semibold tracking-tight text-fg">
          {profile.name}
        </span>
        <span class="truncate text-xs text-muted">
          {locale === 'tr' ? 'Bilgisayar Mühendisi' : 'Computer Engineer'}
        </span>
      </span>
    </a>

    <div class="flex shrink-0 items-center gap-1.5 sm:gap-2">
      <ul class="mr-3 hidden items-center gap-1 lg:flex" role="list">
        {
          navLinks.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class:list={[
                  'rounded-md px-3 py-2 text-[0.92rem] font-medium transition-colors hover:text-fg',
                  isActive(item.href) ? 'text-fg underline decoration-accent decoration-2 underline-offset-[8px]' : 'text-muted',
                ]}
              >
                {t(locale, item.key)}
              </a>
            </li>
          ))
        }
      </ul>

      <LangToggle locale={locale} path={path} />
      <ThemeToggle locale={locale} />

      <span class="ml-1 hidden md:block">
        <WhatsAppButton locale={locale} topic={contactTopic} location="header" label={t(locale, 'cta.quoteShort')} size="sm" />
      </span>

      <button
        type="button"
        data-menu-btn
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label={t(locale, 'nav.openMenu')}
        data-label-open={t(locale, 'nav.openMenu')}
        data-label-close={t(locale, 'nav.closeMenu')}
        class="grid h-10 w-10 place-items-center rounded-lg border border-border text-fg lg:hidden"
      >
        <span data-icon-open><Icon name="menu" size={20} /></span>
        <span data-icon-close class="hidden"><Icon name="close" size={20} /></span>
      </button>
    </div>
  </nav>

  <div id="mobile-nav" data-menu hidden class="border-t border-border bg-bg lg:hidden">
    <ul class="container-page flex flex-col py-2" role="list">
      {
        navLinks.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class="flex items-center justify-between border-b border-border py-3.5 text-base font-medium text-fg"
            >
              {t(locale, item.key)}
              <Icon name="arrow" size={16} class="text-muted" />
            </a>
          </li>
        ))
      }
      {profile.instagram.url && (
        <li>
          <a href={profile.instagram.url} target="_blank" rel="noopener noreferrer" data-track="instagram_click" data-track-location="mobile_menu" class="flex items-center justify-between border-b border-border py-3.5 text-base font-medium text-fg">
            <span class="inline-flex items-center gap-2"><Icon name="instagram" size={18} /> Instagram @{profile.instagram.handle}</span>
            <Icon name="arrow-up-right" size={16} class="text-muted" />
          </a>
        </li>
      )}
      <li>
        <a href={localizePath(locale, '/cv')} class="flex items-center justify-between py-3.5 text-base font-medium text-fg">
          {t(locale, 'nav.cv')}
          <Icon name="arrow" size={16} class="text-muted" />
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-btn]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  if (btn && menu) {
    const set = (open: boolean) => {
      menu.hidden = !open;
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', (open ? btn.dataset.labelClose : btn.dataset.labelOpen) ?? '');
      btn.querySelector('[data-icon-open]')?.classList.toggle('hidden', open);
      btn.querySelector('[data-icon-close]')?.classList.toggle('hidden', !open);
    };
    btn.addEventListener('click', () => set(Boolean(menu.hidden)));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) {
        set(false);
        btn.focus();
      }
    });
  }
</script>
