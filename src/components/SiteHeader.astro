---
/**
 * SiteHeader - sticky top bar. Name + title on the left, five primary links,
 * language/theme switches and an always-visible WhatsApp CTA on desktop.
 * On mobile the CTA lives in the sticky bottom bar instead.
 */
import { profile } from '../data/profile';
import { t, localizePath, type Locale } from '../data/i18n';
import LangToggle from './LangToggle.astro';
import ThemeToggle from './ThemeToggle.astro';
import WhatsAppButton from './WhatsAppButton.astro';
import Icon from './Icon.astro';
import type { ContactTopic } from '../lib/contact';

interface Props {
  locale: Locale;
  /** Current page path in the current locale (for the LangToggle twin route). */
  path: string;
  contactTopic?: ContactTopic;
}

const { locale, path, contactTopic = 'general' } = Astro.props;

const home = localizePath(locale, '/');
const navLinks = [
  { key: 'nav.services', href: localizePath(locale, '/services') },
  { key: 'nav.work', href: localizePath(locale, '/projects') },
  { key: 'nav.about', href: localizePath(locale, '/about') },
  { key: 'nav.writing', href: localizePath(locale, '/writing') },
  { key: 'nav.contact', href: localizePath(locale, '/contact') },
];

const norm = (p: string) => (p.endsWith('/') ? p : `${p}/`);
const current = norm(path);
const isActive = (href: string) => current.startsWith(norm(href));
---

<header id="top" class="sticky top-0 z-40 border-b border-border/80 bg-bg/90 backdrop-blur-md">
  <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6" aria-label="Primary">
    <a href={home} class="group flex min-w-0 items-center gap-3">
      <span
        class="grid h-9 w-9 shrink-0 place-items-center rounded-lg bg-ink font-mono text-[0.7rem] font-semibold text-on-ink"
        aria-hidden="true">ÖY</span
      >
      <span class="flex min-w-0 flex-col leading-tight">
        <span class="truncate text-[0.95rem] font-semibold tracking-tight text-fg group-hover:text-accent">
          {profile.name}
        </span>
        <span class="truncate font-mono text-[0.6rem] uppercase text-muted sm:text-[0.68rem] sm:tracking-wider">
          {locale === 'tr' ? 'Bilgisayar Mühendisi' : 'Computer Engineer'}
        </span>
      </span>
    </a>

    <div class="flex items-center gap-1.5">
      <ul class="mr-2 hidden items-center lg:flex" role="list">
        {
          navLinks.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class:list={[
                  'rounded-md px-3 py-2 text-sm font-medium transition-colors hover:text-accent',
                  isActive(item.href) ? 'text-fg underline decoration-accent decoration-2 underline-offset-[6px]' : 'text-muted',
                ]}
              >
                {t(locale, item.key)}
              </a>
            </li>
          ))
        }
      </ul>

      <LangToggle locale={locale} path={path} />
      <ThemeToggle locale={locale} />

      <span class="ml-1 hidden md:block">
        <WhatsAppButton locale={locale} topic={contactTopic} location="header" label={t(locale, 'cta.whatsappShort')} class="!px-4 !py-2" />
      </span>

      <button
        type="button"
        data-menu-btn
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label={t(locale, 'nav.openMenu')}
        data-label-open={t(locale, 'nav.openMenu')}
        data-label-close={t(locale, 'nav.closeMenu')}
        class="grid h-10 w-10 place-items-center rounded-lg border border-border text-fg lg:hidden"
      >
        <span data-icon-open><Icon name="menu" size={20} /></span>
        <span data-icon-close class="hidden"><Icon name="close" size={20} /></span>
      </button>
    </div>
  </nav>

  <div id="mobile-nav" data-menu hidden class="border-t border-border bg-bg lg:hidden">
    <ul class="mx-auto flex max-w-6xl flex-col px-4 py-3 sm:px-6" role="list">
      {
        navLinks.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class="flex items-center justify-between border-b border-border/70 py-3.5 text-base font-medium text-fg"
            >
              {t(locale, item.key)}
              <Icon name="arrow" size={16} class="text-muted" />
            </a>
          </li>
        ))
      }
      <li>
        <a href={localizePath(locale, '/cv')} class="flex items-center justify-between py-3.5 text-base font-medium text-fg">
          {t(locale, 'nav.cv')}
          <Icon name="arrow" size={16} class="text-muted" />
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-btn]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  if (btn && menu) {
    const set = (open: boolean) => {
      menu.hidden = !open;
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', (open ? btn.dataset.labelClose : btn.dataset.labelOpen) ?? '');
      btn.querySelector('[data-icon-open]')?.classList.toggle('hidden', open);
      btn.querySelector('[data-icon-close]')?.classList.toggle('hidden', !open);
    };
    btn.addEventListener('click', () => set(Boolean(menu.hidden)));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) {
        set(false);
        btn.focus();
      }
    });
  }
</script>
