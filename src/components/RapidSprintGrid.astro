---
import { rapidSprints } from '../data/packages';
import { profile } from '../data/profile';
import { t, type Locale } from '../data/i18n';

interface Props {
  locale: Locale;
  compact?: boolean;
}

const { locale, compact = false } = Astro.props;
const priceFormatter = new Intl.NumberFormat(locale === 'tr' ? 'tr-TR' : 'en-US');
const hint = t(locale, 'social.opensNewTab');
---

<ul class="grid gap-5 md:grid-cols-2" role="list">
  {
    rapidSprints.map((sprint) => {
      const whatsappHref = `https://wa.me/${profile.whatsapp}?text=${encodeURIComponent(
        t(locale, `sprints.whatsappPrefill.${sprint.id}`),
      )}`;

      return (
        <li
          class:list={[
            'relative flex h-full flex-col overflow-hidden rounded-2xl border p-6',
            sprint.highlighted
              ? 'border-accent bg-card'
              : 'border-border bg-card/60',
          ]}
        >
          {sprint.highlighted && (
            <span class="absolute right-0 top-0 rounded-bl-xl bg-accent px-3 py-1.5 font-mono text-[0.68rem] font-semibold uppercase tracking-wide text-bg">
              {t(locale, 'sprints.featured')}
            </span>
          )}

          <p class="font-mono text-xs uppercase tracking-[0.14em] text-accent">
            {sprint.eyebrow[locale]}
          </p>
          <h3 class="mt-3 pr-16 text-xl font-bold tracking-tight text-fg">
            {sprint.name[locale]}
          </h3>
          <p class="mt-2 max-w-xl text-sm leading-relaxed text-muted">
            {sprint.tagline[locale]}
          </p>

          <div class="mt-5 flex flex-wrap items-end gap-x-3 gap-y-1">
            <span class="text-3xl font-bold tracking-tight text-fg">
              {priceFormatter.format(sprint.price)} TL
            </span>
            <span class="pb-1 font-mono text-xs text-muted">
              / {sprint.timeline[locale]}
            </span>
          </div>

          {!compact && (
            <>
              <ul class="mt-6 flex-1 space-y-2.5" role="list">
                {sprint.features.map((feature) => (
                  <li class="flex items-start gap-2 text-sm leading-relaxed text-muted">
                    <svg
                      class="mt-0.5 h-4 w-4 shrink-0 text-accent"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M20 6 9 17l-5-5" />
                    </svg>
                    <span>{feature[locale]}</span>
                  </li>
                ))}
              </ul>
              <p class="mt-5 border-t border-border/70 pt-4 text-xs leading-relaxed text-muted">
                <strong class="font-medium text-fg">{t(locale, 'sprints.scopeLabel')}:</strong>{' '}
                {sprint.exclusions[locale]}
              </p>
            </>
          )}

          <a
            href={whatsappHref}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${t(locale, 'sprints.cta')} — ${sprint.name[locale]} (${hint})`}
            class:list={[
              'mt-6 inline-flex w-fit items-center justify-center rounded-md px-5 py-2.5 text-sm font-medium transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent',
              sprint.highlighted
                ? 'bg-accent text-bg hover:opacity-90'
                : 'border border-border text-fg hover:border-accent hover:text-accent',
            ]}
          >
            {t(locale, 'sprints.cta')}
          </a>
        </li>
      );
    })
  }
</ul>
