---
/**
 * SkillGroups — the "Skills" section as titled groups of monospace chips.
 *
 * Data is read straight from `profile.skillGroups` (single source of truth);
 * nothing is hard-coded here. The group title is locale-selected (`title_en` /
 * `title_tr`); the individual skill items are proper nouns / tech names and are
 * intentionally the same in both locales.
 *
 * Visual: a responsive grid of groups. Each group reads like a config block —
 * a monospace, accent-prefixed heading over a wrap of chips. Chips are inert
 * (non-interactive), so no focus/hover affordance is needed and there is no
 * animation to disable under prefers-reduced-motion.
 */
import type { Locale } from '../data/i18n';
import { profile } from '../data/profile';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const groups = profile.skillGroups;
---

<ul class="grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-3" role="list">
  {
    groups.map((group, i) => {
      const title = locale === 'tr' ? group.title_tr : group.title_en;
      return (
        <li>
          <h3 class="flex items-baseline gap-2 text-sm font-semibold tracking-tight text-fg">
            <span
              class="font-mono text-xs text-accent dark:text-accent/70 tabular-nums"
              aria-hidden="true"
            >
              {String(i + 1).padStart(2, '0')}
            </span>
            {title}
          </h3>

          <ul class="mt-3 flex flex-wrap gap-1.5" role="list">
            {group.items.map((item) => (
              <li class="rounded-md border border-border bg-card px-2.5 py-1 font-mono text-xs leading-none text-muted">
                {item}
              </li>
            ))}
          </ul>
        </li>
      );
    })
  }
</ul>
