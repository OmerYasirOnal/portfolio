---
/**
 * SkillGroups - executive capability cards covering mobile, web, brand/SEO/AIO,
 * AI, backend, and infrastructure.
 */
import type { Locale } from '../data/i18n';
import { profile } from '../data/profile';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const groups = profile.skillGroups;
---

<ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3" role="list">
  {
    groups.map((group) => {
      const title = locale === 'tr' ? group.title_tr : group.title_en;
      const summary = locale === 'tr' ? group.summary_tr : group.summary_en;
      const items = locale === 'tr' && group.items_tr ? group.items_tr : group.items;
      return (
        <li class="flex h-full flex-col rounded-2xl border border-border bg-card p-6 shadow-2xs">
          <h3 class="text-base font-bold tracking-tight text-fg sm:text-lg">
            {title}
          </h3>
          {summary && (
            <p class="mt-1.5 text-xs leading-relaxed text-muted sm:text-sm">
              {summary}
            </p>
          )}

          <ul class="mt-4 space-y-2 border-t border-border/60 pt-4" role="list">
            {items.map((item) => (
              <li class="flex items-start gap-2 text-xs font-medium leading-relaxed text-fg/90 sm:text-sm">
                <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true" />
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </li>
      );
    })
  }
</ul>
