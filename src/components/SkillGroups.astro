---
/**
 * SkillGroups - executive capability cards covering mobile, web, brand/SEO/AIO,
 * AI, backend, and infrastructure.
 */
import type { Locale } from '../data/i18n';
import { profile } from '../data/profile';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const groups = profile.skillGroups;
---

<ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3" role="list">
  {
    groups.map((group, idx) => {
      const title = locale === 'tr' ? group.title_tr : group.title_en;
      const summary = locale === 'tr' ? group.summary_tr : group.summary_en;
      const items = locale === 'tr' && group.items_tr ? group.items_tr : group.items;
      return (
        <li
          
          class="flex h-full flex-col rounded-2xl border border-border bg-card p-6"
        >
          <div class="relative z-10 flex items-center justify-between gap-2">
            <span class="rounded-full bg-accent/10 px-2.5 py-0.5 font-mono text-[0.7rem] font-bold text-accent">
              0{idx + 1}
            </span>
            
          </div>

          <h3 class="mt-3 text-base font-semibold tracking-tight text-fg sm:text-lg">
            {title}
          </h3>
          {summary && (
            <p class="relative z-10 mt-1.5 text-xs leading-relaxed text-muted sm:text-sm">
              {summary}
            </p>
          )}

          <ul class="relative z-10 mt-5 flex flex-wrap gap-2 border-t border-border pt-4" role="list">
            {items.map((item) => (
              <li class="rounded-md bg-bg px-2 py-1 font-mono text-[0.68rem] text-muted">
                {item}
              </li>
            ))}
          </ul>
        </li>
      );
    })
  }
</ul>
