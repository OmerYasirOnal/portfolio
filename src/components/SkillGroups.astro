---
/**
 * SkillGroups - executive capability cards covering mobile, web, brand/SEO/AIO,
 * AI, backend, and infrastructure.
 */
import type { Locale } from '../data/i18n';
import { profile } from '../data/profile';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const groups = profile.skillGroups;
---

<ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3" role="list" data-reveal>
  {
    groups.map((group, idx) => {
      const title = locale === 'tr' ? group.title_tr : group.title_en;
      const summary = locale === 'tr' ? group.summary_tr : group.summary_en;
      const items = locale === 'tr' && group.items_tr ? group.items_tr : group.items;
      return (
        <li
          data-spotlight
          class="group relative flex h-full flex-col overflow-hidden rounded-3xl border border-accent/20 bg-card/80 p-6 shadow-sm backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-accent/55 hover:shadow-lg hover:shadow-accent/5"
        >
          <div class="relative z-10 flex items-center justify-between gap-2">
            <span class="rounded-full bg-accent/10 px-2.5 py-0.5 font-mono text-[0.7rem] font-bold text-accent">
              0{idx + 1}
            </span>
            <span class="h-1.5 w-1.5 rounded-full bg-accent/60 transition-transform duration-300 group-hover:scale-150 group-hover:bg-accent" aria-hidden="true" />
          </div>

          <h3 class="relative z-10 mt-3 text-base font-bold tracking-tight text-fg transition-colors group-hover:text-accent sm:text-lg">
            {title}
          </h3>
          {summary && (
            <p class="relative z-10 mt-1.5 text-xs leading-relaxed text-muted sm:text-sm">
              {summary}
            </p>
          )}

          <ul class="relative z-10 mt-5 flex flex-wrap gap-2 border-t border-accent/15 pt-4" role="list">
            {items.map((item) => (
              <li class="rounded-full border border-accent/20 bg-bg/80 px-3 py-1.5 text-xs font-semibold text-fg/90 transition-all duration-200 hover:-translate-y-0.5 hover:border-accent hover:text-accent">
                {item}
              </li>
            ))}
          </ul>
        </li>
      );
    })
  }
</ul>
