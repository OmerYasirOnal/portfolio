---
/**
 * Logo - the ÖY mark (O ring, square umlaut dots, node-graph Y) as inline SVG.
 * Quiet, flat version: the ring follows the surrounding text colour
 * (currentColor) and the Y, dots and nodes use the accent token, so the mark
 * adapts to light, dark and the ink footer without gradients.
 */
interface Props {
  size?: number;
  class?: string;
  title?: string;
}
const { size = 36, class: className = '', title } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 64 64"
  class:list={['logo-mark', className]}
  role={title ? 'img' : undefined}
  aria-label={title}
  aria-hidden={title ? undefined : 'true'}
  focusable="false"
>
  <circle cx="32" cy="36" r="18" fill="none" stroke="currentColor" stroke-width="5"></circle>
  <rect x="21.5" y="5.5" width="6" height="6" rx="1.4" class="logo-accent"></rect>
  <rect x="36.5" y="5.5" width="6" height="6" rx="1.4" class="logo-accent"></rect>
  <path
    d="M24.5 27.5 L32 36 L39.5 27.5 M32 36 V46"
    fill="none"
    class="logo-accent-stroke"
    stroke-width="4"
    stroke-linecap="round"
    stroke-linejoin="round"></path>
  <circle cx="24.5" cy="27.5" r="2.6" class="logo-accent"></circle>
  <circle cx="39.5" cy="27.5" r="2.6" class="logo-accent"></circle>
  <circle cx="32" cy="46" r="2.6" class="logo-accent"></circle>
</svg>

<style>
  .logo-accent { fill: var(--logo-accent, var(--color-accent)); }
  .logo-accent-stroke { stroke: var(--logo-accent, var(--color-accent)); }
  /* On the ink footer the deep accent is too dark: use the bright brand green. */
  :global(.bg-ink) .logo-mark { --logo-accent: #34d399; }
</style>
