---
/**
 * MobileContactBar - sticky bottom bar on small screens: WhatsApp first,
 * email second. Hidden on md+ where the header CTA is always visible.
 */
import Icon from './Icon.astro';
import { whatsappHref, mailtoHref, type ContactTopic } from '../lib/contact';
import { t, type Locale } from '../data/i18n';

interface Props {
  locale: Locale;
  topic?: ContactTopic;
}

const { locale, topic = 'general' } = Astro.props;
---

<div class="h-20 md:hidden" aria-hidden="true"></div>
<nav
  aria-label={t(locale, 'cta.quickContact')}
  class="fixed inset-x-0 bottom-0 z-40 border-t border-border bg-bg/95 px-4 pb-[max(0.75rem,env(safe-area-inset-bottom))] pt-3 backdrop-blur-md md:hidden"
>
  <div class="mx-auto flex max-w-md gap-2.5">
    <a
      href={whatsappHref(locale, topic)}
      target="_blank"
      rel="noopener noreferrer"
      data-track="whatsapp_click"
      data-track-location="mobile_bar"
      data-track-topic={topic}
      class="flex flex-1 items-center justify-center gap-2 rounded-full bg-accent px-4 py-3 text-sm font-semibold text-on-accent"
    >
      <Icon name="whatsapp" size={18} />
      {t(locale, 'cta.whatsappShort')}
    </a>
    <a
      href={mailtoHref(locale)}
      data-track="email_click"
      data-track-location="mobile_bar"
      class="flex items-center justify-center gap-2 rounded-full border border-fg/20 bg-card px-4 py-3 text-sm font-semibold text-fg"
    >
      <Icon name="mail" size={17} />
      {t(locale, 'cta.emailShort')}
    </a>
  </div>
</nav>
