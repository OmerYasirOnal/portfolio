---
/**
 * ProjectCaseStudy - structured, locale-correct case study for a project
 * detail page, including optional visual showcase preview.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { t, type Locale } from '../data/i18n';

interface Props {
  entry: CollectionEntry<'projects'>;
  locale: Locale;
}

const { entry, locale } = Astro.props;
const { data } = entry;

const problem = locale === 'en' ? data.problem_en : data.problem_tr;
const whatIDid = locale === 'en' ? data.what_i_did_en : data.what_i_did_tr;
const highlights = locale === 'en' ? data.highlights_en : data.highlights_tr;

const showcaseImages = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/showcase/*.{jpg,jpeg,png,webp}',
  { eager: true },
);
const imageMeta = data.image
  ? showcaseImages[`../assets/showcase/${data.image}`]?.default
  : undefined;
---

{
  imageMeta && (
    <div class="mt-8 overflow-hidden rounded-xl border border-border bg-card shadow-sm">
      <Image
        src={imageMeta}
        alt={data.title}
        width={1280}
        height={800}
        densities={[1, 2]}
        class="w-full object-cover object-top"
      />
    </div>
  )
}

<div class="prose mt-10">
  {
    problem && (
      <>
        <h2>{t(locale, 'project.problem')}</h2>
        <p>{problem}</p>
      </>
    )
  }
  {
    whatIDid && (
      <>
        <h2>{t(locale, 'project.whatIDid')}</h2>
        <p>{whatIDid}</p>
      </>
    )
  }
  {
    highlights.length > 0 && (
      <>
        <h2>{t(locale, 'project.highlights')}</h2>
        <ul>
          {highlights.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </>
    )
  }
</div>

<style>
  .prose {
    color: var(--color-muted);
    line-height: 1.75;
  }
  .prose :global(h2) {
    color: var(--color-fg);
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
  }
  .prose :global(h2:first-child) {
    margin-top: 0;
  }
  .prose :global(p) {
    margin-top: 1rem;
    margin-bottom: 1rem;
  }
  .prose :global(ul) {
    margin-top: 1rem;
    margin-bottom: 1rem;
    padding-left: 1.25rem;
    list-style-position: outside;
    list-style-type: disc;
  }
  .prose :global(li) {
    margin-top: 0.375rem;
  }
  .prose :global(li::marker) {
    color: var(--color-accent);
  }
  .prose :global(strong) {
    color: var(--color-fg);
    font-weight: 600;
  }
</style>
