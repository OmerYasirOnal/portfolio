---
/**
 * About — a two-column portrait + prose block for the home page.
 *
 * All copy is read from `profile` (the about paragraph + signal badges) and the
 * i18n dictionary — nothing is hard-coded. The left column is a framed portrait
 * rendered through Astro's `<Image>` (optimized, responsive, no layout shift):
 * the real headshot sits inside a dev-tools frame with corner ticks. The frame
 * is decorative and static — inert under prefers-reduced-motion.
 */
import { Image } from 'astro:assets';
import { profile } from '../data/profile';
import type { Locale } from '../data/i18n';
import portrait from '../assets/omer-yasir-onal.jpg';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const about = profile.about[locale];
const badges = profile.badges.map((b) => b[locale]);
---

<div class="grid items-start gap-10 md:grid-cols-[minmax(0,18rem)_1fr] md:gap-12 lg:gap-16">
  {/* Portrait — the real headshot inside a dev-tools frame. */}
  <figure class="mx-auto w-full max-w-[18rem] md:mx-0">
    <div
      class="relative aspect-[4/5] overflow-hidden rounded-xl border border-border bg-card"
    >
      {/* corner ticks — dev-tools framing (drawn above the image) */}
      <span
        aria-hidden="true"
        class="pointer-events-none absolute left-2 top-2 z-10 h-3 w-3 border-l border-t border-accent/60"
      ></span>
      <span
        aria-hidden="true"
        class="pointer-events-none absolute right-2 top-2 z-10 h-3 w-3 border-r border-t border-accent/60"
      ></span>
      <span
        aria-hidden="true"
        class="pointer-events-none absolute bottom-2 left-2 z-10 h-3 w-3 border-b border-l border-accent/60"
      ></span>
      <span
        aria-hidden="true"
        class="pointer-events-none absolute bottom-2 right-2 z-10 h-3 w-3 border-b border-r border-accent/60"
      ></span>

      <Image
        src={portrait}
        alt="Ömer Yasir Önal"
        width={720}
        height={720}
        densities={[1, 2]}
        class="h-full w-full object-cover object-center"
      />
    </div>
    <figcaption class="mt-2 text-center font-mono text-[0.7rem] text-muted/70 md:text-left">
      <span class="text-accent/70">~/</span>{profile.name}
    </figcaption>
  </figure>

  {/* Prose + signal badges. */}
  <div>
    <p class="max-w-2xl text-base leading-relaxed text-muted sm:text-lg">
      {about}
    </p>

    <ul class="mt-7 flex flex-wrap gap-2" role="list">
      {
        badges.map((badge) => (
          <li
            class="inline-flex items-center gap-1.5 rounded-md border border-border bg-card/60 px-3 py-1 font-mono text-xs text-fg"
          >
            <svg
              width="13"
              height="13"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="text-accent"
              aria-hidden="true"
              focusable="false"
            >
              <path d="m5 12 5 5L20 7" />
            </svg>
            {badge}
          </li>
        ))
      }
    </ul>
  </div>
</div>
