---
/**
 * About - executive biography, credentials, and academic background.
 */
import { Image } from 'astro:assets';
import { profile } from '../data/profile';
import type { Locale } from '../data/i18n';
import portrait from '../assets/omer-yasir-onal.jpg';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const about = profile.about[locale];
const badges = profile.badges.map((b) => b[locale]);
const edu = profile.education;
---

<div
  data-spotlight
  data-reveal
  class="grid items-center gap-10 rounded-3xl border border-accent/25 bg-card/80 p-6 shadow-lg shadow-accent/5 backdrop-blur-xl sm:p-10 md:grid-cols-[minmax(0,16.5rem)_1fr] md:gap-12"
>
  {/* Portrait */}
  <figure class="relative z-10 mx-auto w-full max-w-[16.5rem] md:mx-0">
    <div class="group relative aspect-[4/5] overflow-hidden rounded-3xl border border-accent/30 bg-bg shadow-lg shadow-emerald-950/10">
      <Image
        src={portrait}
        alt={profile.name}
        width={640}
        height={800}
        densities={[1, 2]}
        class="h-full w-full object-cover object-top transition-transform duration-700 group-hover:scale-[1.03]"
      />
    </div>
    <figcaption class="mt-3.5 text-center md:text-left">
      <p class="text-sm font-bold text-fg">{profile.name}</p>
      <p class="mt-0.5 text-xs font-medium text-accent">
        {locale === 'tr' ? edu.degree_tr : edu.degree_en} · {locale === 'tr' ? edu.school_tr : edu.school_en}
      </p>
    </figcaption>
  </figure>

  {/* Prose + interactive credential capsules */}
  <div class="relative z-10">
    <p class="max-w-2xl text-base leading-relaxed text-muted sm:text-lg">
      {about}
    </p>

    <ul class="mt-7 grid gap-3 sm:grid-cols-2" role="list">
      {
        badges.map((badge) => (
          <li class="flex items-center gap-3 rounded-2xl border border-accent/20 bg-bg/75 px-4 py-3 text-xs font-semibold text-fg backdrop-blur-md transition-all duration-300 hover:-translate-y-0.5 hover:border-accent/50 hover:shadow-md hover:shadow-accent/5 sm:text-sm">
            <span class="grid h-6 w-6 shrink-0 place-items-center rounded-full bg-gradient-to-br from-emerald-500/20 to-teal-500/20 text-accent">
              <svg
                width="13"
                height="13"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                focusable="false"
              >
                <path d="m5 12 5 5L20 7" />
              </svg>
            </span>
            <span>{badge}</span>
          </li>
        ))
      }
    </ul>
  </div>
</div>
