---
/**
 * About - executive biography, credentials, and academic background.
 */
import { Image } from 'astro:assets';
import { profile } from '../data/profile';
import type { Locale } from '../data/i18n';
import portrait from '../assets/omer-yasir-onal.jpg';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const about = profile.about[locale];
const badges = profile.badges.map((b) => b[locale]);
const edu = profile.education;
---

<div class="grid items-start gap-10 rounded-2xl border border-border bg-card p-6 shadow-2xs sm:p-8 md:grid-cols-[minmax(0,16rem)_1fr] md:gap-12">
  {/* Portrait */}
  <figure class="mx-auto w-full max-w-[16rem] md:mx-0">
    <div class="aspect-[4/5] overflow-hidden rounded-2xl border border-border bg-bg shadow-xs">
      <Image
        src={portrait}
        alt={profile.name}
        width={640}
        height={800}
        densities={[1, 2]}
        class="h-full w-full object-cover object-center"
      />
    </div>
    <figcaption class="mt-3 text-center md:text-left">
      <p class="text-sm font-bold text-fg">{profile.name}</p>
      <p class="mt-0.5 text-xs font-medium text-muted">
        {locale === 'tr' ? edu.degree_tr : edu.degree_en} · {locale === 'tr' ? edu.school_tr : edu.school_en}
      </p>
    </figcaption>
  </figure>

  {/* Prose + credential badges */}
  <div>
    <p class="max-w-2xl text-base leading-relaxed text-muted sm:text-lg">
      {about}
    </p>

    <ul class="mt-7 grid gap-3 sm:grid-cols-2" role="list">
      {
        badges.map((badge) => (
          <li class="flex items-center gap-2.5 rounded-xl border border-border bg-bg/70 px-4 py-3 text-xs font-semibold text-fg sm:text-sm">
            <span class="grid h-5 w-5 shrink-0 place-items-center rounded-full bg-accent/12 text-accent">
              <svg
                width="12"
                height="12"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                focusable="false"
              >
                <path d="m5 12 5 5L20 7" />
              </svg>
            </span>
            {badge}
          </li>
        ))
      }
    </ul>
  </div>
</div>
