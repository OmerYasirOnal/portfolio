---
/**
 * WritingList - personal essays, technical articles, and peer-reviewed publications.
 */
import { getCollection } from 'astro:content';
import { t, localizePath, type Locale } from '../data/i18n';

interface Props {
  locale: Locale;
  home?: boolean;
}

const { locale, home = false } = Astro.props;

interface Row {
  title: string;
  href: string;
  external: boolean;
  source: string;
  date: string;
  lang: string;
  order: number;
  home: boolean;
}

const writing = await getCollection('writing');
const posts = await getCollection('posts', (e) => !e.data.draft && e.data.lang === locale);

const allArticles: Row[] = [
  ...writing.map((e) => ({
    title: e.data.title,
    href: e.data.url,
    external: true,
    source: e.data.source,
    date: e.data.date,
    lang: e.data.lang,
    order: e.data.order,
    home: e.data.home,
  })),
  ...posts.map((e) => ({
    title: e.data.title,
    href: localizePath(locale, `/writing/${e.id}`),
    external: false,
    source: t(locale, 'writing.sourceSelf'),
    date: e.data.date,
    lang: e.data.lang,
    order: 99,
    home: e.data.home,
  })),
].sort((a, b) => {
  if (a.date !== b.date) return a.date < b.date ? 1 : -1;
  return a.order - b.order;
});

const articles = home ? allArticles.filter((row) => row.home) : allArticles;
const truncated = home && allArticles.length > articles.length;
const seeAllHref = localizePath(locale, '/writing');

const dateFmt = new Intl.DateTimeFormat(locale === 'tr' ? 'tr-TR' : 'en-US', {
  month: 'long',
  year: 'numeric',
});
const formatDate = (iso: string) => dateFmt.format(new Date(`${iso}T00:00:00`));

const publications = (await getCollection('publications')).sort(
  (a, b) => b.data.year - a.data.year,
);

const hint = t(locale, 'social.opensNewTab');

const EXTERNAL_ICON = [
  'M15 3h6v6',
  'M10 14 21 3',
  'M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6',
];
---

<div class="space-y-12" data-reveal>
  {
    home && (
      <p class="max-w-3xl text-base leading-relaxed text-muted">
        {t(locale, 'writing.intro')}
      </p>
    )
  }

  {/* Articles & Personal Essays */}
  {
    articles.length > 0 && (
      <section aria-labelledby="writing-articles">
        <h3
          id="writing-articles"
          class="mb-4 text-xs font-bold uppercase tracking-wider text-accent"
        >
          {t(locale, 'writing.articles')}
        </h3>
        <ul class="grid gap-5 sm:grid-cols-2" role="list">
          {articles.map((row) => (
            <li>
              <a
                href={row.href}
                target={row.external ? '_blank' : undefined}
                rel={row.external ? 'noopener noreferrer' : undefined}
                aria-label={row.external ? `${row.title} - ${row.source} (${hint})` : undefined}
                data-spotlight
                class="group relative flex h-full flex-col justify-between overflow-hidden rounded-3xl border border-accent/20 bg-card/80 p-6 shadow-sm backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-accent/55 hover:shadow-lg hover:shadow-accent/5 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
              >
                <div class="relative z-10">
                  <div class="flex items-center justify-between gap-2 text-xs font-medium text-muted">
                    <time datetime={row.date}>{formatDate(row.date)}</time>
                    <span class="inline-flex items-center gap-1 rounded-full border border-accent/20 bg-bg/80 px-2.5 py-0.5 text-[0.7rem] font-semibold text-muted">
                      {row.source}
                      {row.external && (
                        <svg
                          width="11"
                          height="11"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          class="text-accent"
                          aria-hidden="true"
                          focusable="false"
                        >
                          {EXTERNAL_ICON.map((d) => (
                            <path d={d} />
                          ))}
                        </svg>
                      )}
                    </span>
                  </div>

                  <p class="mt-3 text-base font-bold leading-snug text-fg transition-colors group-hover:text-accent">
                    {row.title}
                  </p>
                </div>

                <div class="relative z-10 mt-4 flex items-center justify-between border-t border-accent/15 pt-3 text-xs font-semibold text-accent">
                  <span>{row.lang === 'tr' ? 'Türkçe Makale' : 'English Article'}</span>
                  <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">
                    →
                  </span>
                </div>
              </a>
            </li>
          ))}
        </ul>
        {truncated && (
          <a
            href={seeAllHref}
            class="group mt-6 inline-flex items-center gap-2 rounded-full border border-accent/30 bg-card/80 px-5 py-2.5 text-sm font-semibold text-accent shadow-2xs backdrop-blur-md transition-all hover:-translate-y-0.5 hover:border-accent hover:bg-accent hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
          >
            {t(locale, 'writing.seeAll')}
            <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">
              →
            </span>
          </a>
        )}
      </section>
    )
  }

  {/* Academic Publications */}
  {
    publications.length > 0 && (
      <section aria-labelledby="writing-publications">
        <h3
          id="writing-publications"
          class="mb-4 text-xs font-bold uppercase tracking-wider text-accent"
        >
          {t(locale, 'writing.publications')}
        </h3>
        <ul class="space-y-4" role="list">
          {publications.map((entry) => {
            const title = locale === 'tr' ? entry.data.title_tr : entry.data.title_en;
            const meta = (
              <p class="mt-2.5 flex flex-wrap items-center gap-2 text-xs font-medium text-muted">
                <span class="rounded-full border border-accent/25 bg-accent/10 px-3 py-0.5 font-semibold text-accent">
                  {entry.data.venue}
                </span>
                <span aria-hidden="true" class="text-accent/50">·</span>
                <span>{entry.data.year}</span>
              </p>
            );
            return (
              <li
                data-spotlight
                class="relative overflow-hidden rounded-3xl border border-accent/25 bg-card/80 p-6 shadow-sm backdrop-blur-xl transition-all duration-300 hover:-translate-y-0.5 hover:border-accent/60 hover:shadow-lg hover:shadow-accent/5"
              >
                {entry.data.url ? (
                  <a
                    href={entry.data.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`${title} - ${entry.data.venue} (${hint})`}
                    class="group relative z-10 block focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
                  >
                    <p class="text-base font-bold leading-snug text-fg transition-colors group-hover:text-accent sm:text-lg">
                      {title} ↗
                    </p>
                    {meta}
                  </a>
                ) : (
                  <div class="relative z-10">
                    <p class="text-base font-bold leading-snug text-fg sm:text-lg">{title}</p>
                    {meta}
                  </div>
                )}
              </li>
            );
          })}
        </ul>
      </section>
    )}
</div>
