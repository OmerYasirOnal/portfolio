---
/**
 * Icon - references a <symbol> from IconSprite (rendered once per page in
 * Base), so each icon costs ~80 bytes instead of its full path data.
 */
import type { IconName } from '../lib/icons';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 18, class: className = '' } = Astro.props;
---

<svg width={size} height={size} aria-hidden="true" focusable="false" class={className}><use href={`#i-${name}`}></use></svg>
