---
/**
 * WhatsAppButton - the primary conversion control. Opens wa.me with a
 * topic-specific prefilled message and emits a `whatsapp_click` event.
 */
import Icon from './Icon.astro';
import { whatsappHref, type ContactTopic } from '../lib/contact';
import { t, type Locale } from '../data/i18n';

interface Props {
  locale: Locale;
  topic?: ContactTopic;
  /** Where on the page the button sits (analytics dimension). */
  location: string;
  label?: string;
  /** primary: accent fill · secondary: outlined · light: for the dark footer. */
  variant?: 'primary' | 'secondary' | 'outline' | 'light';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}

const {
  locale,
  topic = 'general',
  location,
  label = t(locale, 'cta.whatsapp'),
  variant = 'primary',
  size = 'md',
  class: className = '',
} = Astro.props;

const variants = {
  primary: 'btn-primary',
  secondary: 'btn-secondary',
  outline: 'btn-secondary',
  light: 'btn-light',
};
const sizes = { sm: 'btn-sm', md: '', lg: 'btn-lg' };
---

<a
  href={whatsappHref(locale, topic)}
  target="_blank"
  rel="noopener noreferrer"
  data-track="whatsapp_click"
  data-track-location={location}
  data-track-topic={topic}
  class:list={['btn', variants[variant], sizes[size], className]}
>
  <Icon name="whatsapp" size={size === 'lg' ? 19 : size === 'sm' ? 16 : 18} />
  <span>{label}</span>
</a>
