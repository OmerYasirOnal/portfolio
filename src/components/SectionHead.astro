---
/**
 * SectionHead - optional eyebrow, heading, optional lead and a right-aligned
 * link. Plain and consistent: no numbering, no mono type.
 */
import Icon from './Icon.astro';

interface Props {
  /** Small uppercase eyebrow above the heading (optional). */
  label?: string;
  title: string;
  intro?: string;
  link?: { href: string; text: string };
  /** Heading level: h2 by default, h1 for page heads. */
  as?: 'h1' | 'h2';
  id?: string;
  /** Center the block (used for short closing sections). */
  center?: boolean;
  class?: string;
}

const { label, title, intro, link, as: Tag = 'h2', id, center = false, class: className = '' } = Astro.props;
---

<header
  class:list={[
    'mb-10 grid gap-5 md:mb-12',
    center ? 'justify-items-center text-center' : 'md:grid-cols-[1fr_auto] md:items-end',
    className,
  ]}
>
  <div class:list={['max-w-3xl', center && 'mx-auto']}>
    {label && <p class="eyebrow">{label}</p>}
    <Tag id={id} class:list={[Tag === 'h1' ? 'h-display' : 'h-section', label && 'mt-3']}>
      {title}
    </Tag>
    {intro && <p class:list={['lead mt-4', center && 'mx-auto']}>{intro}</p>}
  </div>
  {
    link && (
      <a href={link.href} class="link-arrow">
        {link.text}
        <Icon name="arrow" size={15} />
      </a>
    )
  }
</header>
