---
/**
 * Hero — the top of the home page. All copy comes from `profile` + the i18n
 * dictionary (nothing hard-coded): the availability status, name, role, the
 * default positioning tagline (taglines[locale][0]), the two CTAs, and the
 * social icons. A single accent glow sits behind the text (decorative, static —
 * no motion, so it is inert under prefers-reduced-motion).
 */
import { profile } from '../data/profile';
import { t, localizePath, type Locale } from '../data/i18n';
import SocialLinks from './SocialLinks.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const role = profile.role[locale];
const tagline = profile.taglines[locale][0];
const resumeHref = localizePath(locale, '/cv');
---

<section class="relative isolate overflow-hidden">
  {/* Decorative accent glow — behind everything, ignored by AT + pointer. */}
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -top-32 left-1/2 -z-10 h-[32rem] w-[32rem] -translate-x-1/2 rounded-full bg-accent/20 blur-[120px]"
  >
  </div>

  <div class="mx-auto max-w-3xl px-6 pb-16 pt-20 sm:pt-28">
    {/* Availability status — mono, with a live dot. */}
    <p
      class="inline-flex items-center gap-2 rounded-full border border-border bg-card/60 px-3 py-1 font-mono text-xs text-muted"
    >
      <span class="relative flex h-2 w-2">
        <span
          class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400/70"
        ></span>
        <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-400"></span>
      </span>
      {t(locale, 'hero.status')}
    </p>

    <h1
      class="mt-6 text-4xl font-bold tracking-tight text-fg sm:text-6xl"
    >
      {profile.name}
    </h1>

    <p class="mt-3 font-mono text-lg text-accent sm:text-xl">
      {role}
    </p>

    <p class="mt-6 max-w-2xl text-balance text-base leading-relaxed text-muted sm:text-lg">
      {tagline}
    </p>

    <div class="mt-9 flex flex-wrap items-center gap-x-4 gap-y-3">
      <a
        href="#work"
        class="inline-flex items-center gap-2 rounded-md bg-accent px-5 py-2.5 text-sm font-medium text-bg transition-opacity hover:opacity-90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      >
        {t(locale, 'hero.viewWork')}
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 12h14" />
          <path d="m12 5 7 7-7 7" />
        </svg>
      </a>

      <a
        href={resumeHref}
        class="inline-flex items-center gap-2 rounded-md border border-border px-5 py-2.5 text-sm font-medium text-fg transition-colors hover:border-accent hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      >
        {t(locale, 'hero.resume')}
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M12 3v12" />
          <path d="m7 10 5 5 5-5" />
          <path d="M5 21h14" />
        </svg>
      </a>

      <div class="sm:ml-2">
        <SocialLinks locale={locale} />
      </div>
    </div>
  </div>
</section>
