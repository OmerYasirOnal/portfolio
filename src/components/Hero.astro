---
/**
 * Hero - top of the home page.
 * Presents Ömer Yasir Önal's corporate positioning, interactive capability pills,
 * primary CTAs (contact form, projects, services, CV), and social links.
 */
import { profile } from '../data/profile';
import { t, localizePath, type Locale } from '../data/i18n';
import SocialLinks from './SocialLinks.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const role = profile.role[locale];
const tagline = profile.taglines[locale][0];
const resumeHref = localizePath(locale, '/cv');
const packagesHref = localizePath(locale, '/packages');

const highlights = [
  { key: 'hero.pillars.mobile', href: '#services' },
  { key: 'hero.pillars.web', href: '#services' },
  { key: 'hero.pillars.brand', href: '#services' },
  { key: 'hero.pillars.seo', href: '#services' },
  { key: 'hero.pillars.ai', href: '#work' },
];
---

<section class="relative isolate overflow-hidden border-b border-border/50">
  {/* Subtle corporate ambient light */}
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -top-40 left-1/2 -z-10 h-[34rem] w-[48rem] -translate-x-1/2 rounded-full bg-accent/12 blur-[130px]"
  >
  </div>

  <div class="mx-auto max-w-5xl px-6 pb-16 pt-16 sm:pb-20 sm:pt-24">
    {/* Availability status pill */}
    <p
      class="inline-flex items-center gap-2.5 rounded-full border border-border bg-card/80 px-3.5 py-1.5 font-mono text-xs text-muted shadow-xs"
    >
      <span class="relative flex h-2 w-2">
        <span
          class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400/70"
        ></span>
        <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-400"></span>
      </span>
      {t(locale, 'hero.status')}
    </p>

    <h1
      class="mt-6 text-4xl font-bold tracking-tight text-fg sm:text-6xl"
    >
      {profile.name}
    </h1>

    <p class="mt-3 font-mono text-base font-medium text-accent sm:text-xl">
      {role}
    </p>

    <p class="mt-6 max-w-3xl text-balance text-base leading-relaxed text-muted sm:text-lg">
      {tagline}
    </p>

    {/* Interactive service area pills */}
    <ul class="mt-7 flex flex-wrap gap-2" role="list">
      {
        highlights.map((item) => (
          <li>
            <a
              href={item.href}
              class="inline-flex items-center gap-1.5 rounded-lg border border-border bg-card/70 px-3 py-1.5 text-xs font-medium text-fg transition-all hover:-translate-y-0.5 hover:border-accent/60 hover:text-accent"
            >
              <span class="h-1.5 w-1.5 rounded-full bg-accent" aria-hidden="true" />
              {t(locale, item.key)}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="mt-9 flex flex-wrap items-center gap-x-3.5 gap-y-3">
      <a
        href="#contact"
        class="inline-flex items-center gap-2 rounded-lg bg-accent px-5 py-2.5 text-sm font-semibold text-bg shadow-xs transition-opacity hover:opacity-90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      >
        {t(locale, 'hero.contactCta')}
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 12h14" />
          <path d="m12 5 7 7-7 7" />
        </svg>
      </a>

      <a
        href="#work"
        class="inline-flex items-center gap-2 rounded-lg border border-accent/60 bg-card/50 px-5 py-2.5 text-sm font-medium text-accent transition-colors hover:bg-accent hover:text-bg focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      >
        {t(locale, 'hero.viewWork')}
      </a>

      <a
        href={packagesHref}
        class="inline-flex items-center gap-2 rounded-lg border border-border bg-card/40 px-4 py-2.5 text-sm font-medium text-fg transition-colors hover:border-accent hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      >
        {t(locale, 'hero.viewPackages')}
      </a>

      <a
        href={resumeHref}
        class="inline-flex items-center gap-2 rounded-lg border border-border bg-card/40 px-4 py-2.5 text-sm font-medium text-fg transition-colors hover:border-accent hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      >
        {t(locale, 'hero.resume')}
        <svg
          width="15"
          height="15"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M12 3v12" />
          <path d="m7 10 5 5 5-5" />
          <path d="M5 21h14" />
        </svg>
      </a>

      <div class="sm:ml-1">
        <SocialLinks locale={locale} />
      </div>
    </div>
  </div>
</section>
