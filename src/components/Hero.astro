---
/**
 * Hero - executive, client-facing hero section with portrait, clear value
 * proposition, interactive solution pills, and trust credentials.
 */
import { Image } from 'astro:assets';
import { profile } from '../data/profile';
import { t, localizePath, type Locale } from '../data/i18n';
import SocialLinks from './SocialLinks.astro';
import portrait from '../assets/omer-yasir-onal.jpg';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const tagline = profile.taglines[locale][0];
const resumeHref = localizePath(locale, '/cv');
const packagesHref = localizePath(locale, '/packages');

const highlights = [
  { key: 'hero.pillars.mobile', href: '#services' },
  { key: 'hero.pillars.web', href: '#services' },
  { key: 'hero.pillars.brand', href: '#services' },
  { key: 'hero.pillars.seo', href: '#services' },
  { key: 'hero.pillars.ai', href: '#work' },
];

const credentials = [
  {
    label: t(locale, 'hero.stat.products.label'),
    value: t(locale, 'hero.stat.products.value'),
  },
  {
    label: t(locale, 'hero.stat.clients.label'),
    value: t(locale, 'hero.stat.clients.value'),
  },
  {
    label: t(locale, 'hero.stat.research.label'),
    value: t(locale, 'hero.stat.research.value'),
  },
];
---

<section class="relative isolate overflow-hidden border-b border-border/70">
  {/* Subtle warm executive ambient glow */}
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -top-36 left-1/2 -z-10 h-[32rem] w-[54rem] -translate-x-1/2 rounded-full bg-accent/8 blur-[130px]"
  >
  </div>

  <div class="mx-auto max-w-6xl px-6 pb-16 pt-12 sm:pb-20 sm:pt-16 lg:pt-20">
    <div class="grid items-center gap-12 lg:grid-cols-[1.35fr_0.85fr] lg:gap-14">
      {/* Left column: Value proposition, solution areas, and CTAs */}
      <div>
        <div class="inline-flex items-center gap-2.5 rounded-full border border-border bg-card px-3.5 py-1.5 text-xs font-medium text-muted shadow-2xs">
          <span class="relative flex h-2 w-2" aria-hidden="true">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-500/60"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500"></span>
          </span>
          {t(locale, 'hero.status')}
        </div>

        <p class="mt-6 text-xs font-semibold uppercase tracking-wider text-accent sm:text-sm">
          {t(locale, 'hero.eyebrow')}
        </p>

        <h1 class="mt-2.5 text-3xl font-bold tracking-tight text-fg sm:text-5xl sm:leading-[1.12]">
          <span class="sr-only">{profile.name} - </span>
          {t(locale, 'hero.headline')}
        </h1>

        <p class="mt-5 max-w-2xl text-base leading-relaxed text-muted sm:text-lg">
          {tagline}
        </p>

        {/* Solution area pills */}
        <ul class="mt-6 flex flex-wrap gap-2" role="list">
          {
            highlights.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="inline-flex items-center gap-2 rounded-full border border-border bg-card px-3.5 py-1.5 text-xs font-medium text-fg shadow-2xs transition-all hover:-translate-y-0.5 hover:border-accent hover:text-accent"
                >
                  <span class="h-1.5 w-1.5 rounded-full bg-accent" aria-hidden="true" />
                  {t(locale, item.key)}
                </a>
              </li>
            ))
          }
        </ul>

        {/* Primary and secondary actions */}
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a
            href="#contact"
            class="inline-flex items-center gap-2 rounded-xl bg-accent px-6 py-3 text-sm font-semibold text-bg shadow-xs transition-opacity hover:opacity-90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
          >
            {t(locale, 'hero.contactCta')}
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M5 12h14" />
              <path d="m12 5 7 7-7 7" />
            </svg>
          </a>

          <a
            href="#work"
            class="inline-flex items-center gap-2 rounded-xl border border-border bg-card px-5 py-3 text-sm font-semibold text-fg shadow-2xs transition-colors hover:border-accent hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
          >
            {t(locale, 'hero.viewWork')}
          </a>

          <a
            href={packagesHref}
            class="inline-flex items-center gap-1.5 rounded-xl px-4 py-3 text-sm font-medium text-muted transition-colors hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
          >
            {t(locale, 'hero.viewPackages')}
          </a>

          <a
            href={resumeHref}
            class="inline-flex items-center gap-1.5 rounded-xl px-3 py-3 text-sm font-medium text-muted transition-colors hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
          >
            {t(locale, 'hero.resume')}
          </a>
        </div>
      </div>

      {/* Right column: Executive portrait & credential card */}
      <aside class="mx-auto w-full max-w-md lg:max-w-none">
        <div class="overflow-hidden rounded-2xl border border-border bg-card p-5 shadow-sm sm:p-6">
          <div class="flex items-center gap-4">
            <div class="h-20 w-20 shrink-0 overflow-hidden rounded-2xl border border-border bg-bg sm:h-24 sm:w-24">
              <Image
                src={portrait}
                alt={profile.name}
                width={320}
                height={320}
                densities={[1, 2]}
                class="h-full w-full object-cover object-center"
              />
            </div>
            <div class="min-w-0">
              <p class="text-lg font-bold tracking-tight text-fg sm:text-xl">
                {profile.name}
              </p>
              <p class="mt-0.5 text-sm font-medium text-accent">
                {locale === 'tr' ? 'Bilgisayar Mühendisi' : 'Computer Engineer'}
              </p>
              <p class="mt-1 text-xs text-muted">
                {t(locale, 'hero.portraitCaption')}
              </p>
            </div>
          </div>

          <dl class="mt-5 divide-y divide-border/70 border-y border-border/70">
            {
              credentials.map((cred) => (
                <div class="py-3">
                  <dt class="text-[0.7rem] font-semibold uppercase tracking-wider text-muted">
                    {cred.label}
                  </dt>
                  <dd class="mt-0.5 text-sm font-semibold text-fg">
                    {cred.value}
                  </dd>
                </div>
              ))
            }
          </dl>

          <div class="mt-4 flex items-center justify-between gap-2">
            <SocialLinks locale={locale} />
            <a
              href={resumeHref}
              class="text-xs font-semibold text-accent transition-colors hover:text-fg"
            >
              {t(locale, 'hero.resume')} →
            </a>
          </div>
        </div>
      </aside>
    </div>
  </div>
</section>
