---
/**
 * PackageFaq - the FAQ block on `/packages`, matched by FAQPage JSON-LD.
 *
 * Data comes straight from `packageFaqs` (single source of truth); the same
 * question/answer strings feed the structured data on the page, so the visible
 * copy and the schema.org markup can never diverge (a Google requirement for
 * FAQ rich results). Uses native `<details>`/`<summary>` accordions - no client
 * JS, keyboard-accessible, and inert under prefers-reduced-motion.
 */
import { packageFaqs } from '../data/packages';
import { t, type Locale } from '../data/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<section class="mx-auto max-w-4xl px-6 pb-20" data-reveal>
  <h2 class="text-2xl font-bold tracking-tight text-fg sm:text-3xl">
    {t(locale, 'packages.faqTitle')}
  </h2>

  <div class="mt-8 rounded-3xl border border-accent/20 bg-card/80 p-6 shadow-sm backdrop-blur-xl sm:p-8">
    <div class="divide-y divide-accent/15">
      {
        packageFaqs.map((faq) => (
          <details class="group py-4 first:pt-0 last:pb-0">
            <summary class="flex cursor-pointer items-center justify-between gap-4 text-left text-base font-semibold text-fg transition-colors hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent [&::-webkit-details-marker]:hidden">
              <span>{faq.question[locale]}</span>
              <span class="grid h-7 w-7 shrink-0 place-items-center rounded-full bg-accent/10 text-accent transition-transform duration-200 group-open:rotate-45">
                <svg
                  class="h-3.5 w-3.5"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  focusable="false"
                >
                  <path d="M12 5v14" />
                  <path d="M5 12h14" />
                </svg>
              </span>
            </summary>
            <p class="mt-3 max-w-2xl text-sm leading-relaxed text-muted">{faq.answer[locale]}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
