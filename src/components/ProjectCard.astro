---
/**
 * ProjectCard - a single project surfaced on the home grid / projects index.
 *
 * Supports optional visual showcase thumbnails (`src/assets/showcase/*.jpg`),
 * group classification (`product` vs `client`), status pill, stack chips, and
 * direct external action buttons (App Store, Live Site, GitHub) alongside the
 * internal case-study link.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { t, localizePath, type Locale } from '../data/i18n';

interface Props {
  locale: Locale;
  entry: CollectionEntry<'projects'>;
}

const { locale, entry } = Astro.props;
const { data } = entry;

const tagline = locale === 'en' ? data.tagline_en : data.tagline_tr;
const status = locale === 'en' ? data.status_en : data.status_tr;
const detailHref = localizePath(locale, `/projects/${entry.id}`);

// Dynamically resolve optional showcase image from src/assets/showcase/
const showcaseImages = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/showcase/*.{jpg,jpeg,png,webp}',
  { eager: true },
);
const imageMeta = data.image
  ? showcaseImages[`../assets/showcase/${data.image}`]?.default
  : undefined;

type LinkKey = 'appstore' | 'live' | 'repo' | 'other';
const LINK_ORDER: LinkKey[] = ['appstore', 'live', 'repo', 'other'];

const links = LINK_ORDER.filter((k) => data.links?.[k]).map((k) => ({
  key: k,
  href: data.links![k] as string,
  label: t(locale, `link.${k}`),
}));

const hint = t(locale, 'social.opensNewTab');
const groupLabel =
  data.group === 'client' ? t(locale, 'work.filterClient') : t(locale, 'work.filterProduct');
---

<article
  data-project-card
  data-group={data.group}
  class="group relative flex h-full flex-col overflow-hidden rounded-xl border border-border bg-card/80 shadow-xs transition-all duration-200 hover:-translate-y-1 hover:border-accent/60 hover:bg-card"
>
  {
    imageMeta && (
      <div class="relative aspect-[16/10] w-full overflow-hidden border-b border-border bg-bg">
        <Image
          src={imageMeta}
          alt={data.title}
          width={720}
          height={450}
          densities={[1, 2]}
          class="h-full w-full object-cover object-top transition-transform duration-300 group-hover:scale-[1.02]"
        />
        <span class="absolute left-3 top-3 rounded-md border border-border/80 bg-bg/90 px-2.5 py-1 font-mono text-[0.68rem] font-medium text-fg backdrop-blur-xs">
          {groupLabel}
        </span>
      </div>
    )
  }

  <div class="flex flex-1 flex-col p-5">
    <div class="flex flex-wrap items-center justify-between gap-2">
      <p class="font-mono text-[0.7rem] uppercase tracking-widest text-muted">
        <span class="text-accent/80">/</span>{t(locale, `category.${data.category}`)}
      </p>

      <p
        class="inline-flex items-center gap-1.5 rounded-full border border-border bg-bg/70 px-2.5 py-0.5 font-mono text-[0.68rem] text-muted"
      >
        <span class="h-1.5 w-1.5 rounded-full bg-emerald-400" aria-hidden="true"></span>
        {status}
      </p>
    </div>

    <h3 class="mt-3 text-lg font-bold tracking-tight text-fg transition-colors group-hover:text-accent">
      <a
        href={detailHref}
        class="before:absolute before:inset-0 before:rounded-xl before:content-[''] focus-visible:outline-none focus-visible:before:outline focus-visible:before:outline-2 focus-visible:before:outline-offset-2 focus-visible:before:outline-accent"
      >
        {data.title}
      </a>
    </h3>

    <p class="mt-1.5 text-sm leading-relaxed text-muted">{tagline}</p>

    {/* stack chips */}
    <ul class="mt-4 flex flex-wrap gap-1.5" role="list">
      {
        data.stack.slice(0, 6).map((tech) => (
          <li class="rounded-md border border-border/80 bg-bg/50 px-2 py-0.5 font-mono text-[0.68rem] text-muted">
            {tech}
          </li>
        ))
      }
    </ul>

    {/* Action links row at the bottom */}
    <div class="relative z-10 mt-auto flex flex-wrap items-center justify-between gap-2 pt-5">
      <div class="flex flex-wrap items-center gap-2">
        {
          links.map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${data.title} - ${link.label} (${hint})`}
              class="inline-flex items-center gap-1.5 rounded-md border border-border bg-bg/80 px-2.5 py-1 font-mono text-xs font-medium text-fg transition-colors hover:border-accent hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
            >
              <span>{link.label}</span>
              <span aria-hidden="true" class="text-accent">↗</span>
            </a>
          ))
        }
      </div>

      <span class="font-mono text-xs font-medium text-accent group-hover:underline">
        {t(locale, 'work.inspect')} →
      </span>
    </div>
  </div>
</article>
