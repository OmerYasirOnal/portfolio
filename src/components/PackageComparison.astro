---
/**
 * PackageComparison — a side-by-side matrix of the three tiers on `/packages`.
 *
 * Every cell is read from `packageTiers` (single source of truth) — price,
 * timeline, page count, and brand-identity scope — so the table can never
 * disagree with the cards above it. The highlighted tier's column is accented
 * to match its card. The table scrolls horizontally inside its own container
 * on narrow screens so the page body never overflows.
 */
import { packageTiers } from '../data/packages';
import { t, type Locale } from '../data/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const priceFormatter = new Intl.NumberFormat(locale === 'tr' ? 'tr-TR' : 'en-US');

const rows = [
  { key: 'packages.compare.price', cell: (i: number) => `${priceFormatter.format(packageTiers[i].priceFrom)} TL` },
  { key: 'packages.compare.timeline', cell: (i: number) => packageTiers[i].timeline[locale] },
  { key: 'packages.compare.pages', cell: (i: number) => packageTiers[i].pages[locale] },
  { key: 'packages.compare.brand', cell: (i: number) => packageTiers[i].brandScope[locale] },
];
---

<section class="mx-auto max-w-5xl px-6 pb-16">
  <h2 class="text-2xl font-bold tracking-tight text-fg sm:text-3xl">
    {t(locale, 'packages.compareTitle')}
  </h2>

  <div class="mt-8 overflow-x-auto">
    <table class="w-full min-w-[36rem] border-collapse text-left">
      <thead>
        <tr class="border-b border-border">
          <th scope="col" class="py-3 pr-4 text-sm font-medium text-muted">
            {t(locale, 'packages.compare.plan')}
          </th>
          {
            packageTiers.map((tier) => (
              <th
                scope="col"
                class:list={[
                  'py-3 pl-4 text-sm font-semibold',
                  tier.highlighted ? 'text-accent' : 'text-fg',
                ]}
              >
                {tier.name[locale]}
              </th>
            ))
          }
        </tr>
      </thead>
      <tbody>
        {
          rows.map((row) => (
            <tr class="border-b border-border/60">
              <th scope="row" class="py-3 pr-4 text-sm font-medium text-muted">
                {t(locale, row.key)}
              </th>
              {packageTiers.map((tier, i) => (
                <td
                  class:list={[
                    'py-3 pl-4 text-sm',
                    tier.highlighted ? 'font-medium text-fg' : 'text-muted',
                  ]}
                >
                  {row.cell(i)}
                </td>
              ))}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</section>
