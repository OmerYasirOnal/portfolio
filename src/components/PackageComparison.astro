---
/**
 * PackageComparison - side-by-side matrix of the four service pillars on `/packages`.
 */
import { packageTiers } from '../data/packages';
import { t, type Locale } from '../data/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const rows = [
  { key: 'packages.compare.timeline', cell: (i: number) => packageTiers[i].timeline[locale] },
  { key: 'packages.compare.pages', cell: (i: number) => packageTiers[i].pages[locale] },
  { key: 'packages.compare.brand', cell: (i: number) => packageTiers[i].brandScope[locale] },
];
---

<section class="mx-auto max-w-6xl px-6 pb-16">
  <h2 class="text-2xl font-bold tracking-tight text-fg sm:text-3xl">
    {t(locale, 'packages.compareTitle')}
  </h2>

  <div class="mt-8 overflow-x-auto rounded-2xl border border-border bg-card p-4 shadow-2xs sm:p-6">
    <table class="w-full min-w-[44rem] border-collapse text-left">
      <thead>
        <tr class="border-b border-border">
          <th scope="col" class="py-3 pr-4 text-sm font-semibold text-muted">
            {t(locale, 'packages.compare.plan')}
          </th>
          {
            packageTiers.map((tier) => (
              <th
                scope="col"
                class:list={[
                  'py-3 pl-4 text-sm font-bold',
                  tier.highlighted ? 'text-accent' : 'text-fg',
                ]}
              >
                {tier.name[locale]}
              </th>
            ))
          }
        </tr>
      </thead>
      <tbody>
        {
          rows.map((row) => (
            <tr class="border-b border-border/60 last:border-b-0">
              <th scope="row" class="py-3.5 pr-4 text-sm font-medium text-muted">
                {t(locale, row.key)}
              </th>
              {packageTiers.map((tier, i) => (
                <td
                  class:list={[
                    'py-3.5 pl-4 text-sm',
                    tier.highlighted ? 'font-semibold text-fg' : 'text-muted',
                  ]}
                >
                  {row.cell(i)}
                </td>
              ))}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</section>
