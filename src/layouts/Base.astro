---
import '../styles/global.css';
import { t } from '../data/i18n';
import { canonicalHref, hreflangLinks } from '../lib/seo';
import { RSS_TITLE } from '../lib/feed';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  lang?: 'en' | 'tr';
  path: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  robots?: string;
  /** External canonical URL override (republished content). Default: self. */
  canonicalUrl?: string;
}

const {
  title,
  description,
  lang = 'tr',
  path,
  ogImage,
  ogType = 'website',
  robots = 'index, follow',
  canonicalUrl,
} = Astro.props;
const canonical = canonicalUrl ?? canonicalHref(path, Astro.site!);
const alternates = canonicalUrl ? [] : hreflangLinks(lang, path, Astro.site!);
const ogImageUrl = ogImage ? new URL(ogImage, Astro.site).toString() : undefined;
const ogIsGeneratedCard = ogImage?.startsWith('/og/') ?? false;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Ömer Yasir Önal" />
    <meta name="robots" content={robots} />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f1f7f4" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#040d09" />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={RSS_TITLE}
      href={new URL('/rss.xml', Astro.site!).toString()}
    />
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Ömer Yasir Önal" />
    <meta property="og:locale" content={lang === 'tr' ? 'tr_TR' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'tr' ? 'en_US' : 'tr_TR'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {ogImageUrl && <meta property="og:image:alt" content={title} />}
    {ogImageUrl && ogIsGeneratedCard && <meta property="og:image:width" content="1200" />}
    {ogImageUrl && ogIsGeneratedCard && <meta property="og:image:height" content="630" />}

    <!-- Twitter -->
    <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}

    <script is:inline>
      // No-flash theme: luminous sage-emerald light is default; honor stored dark choice.
      try {
        const stored = localStorage.getItem('theme');
        const root = document.documentElement;
        if (stored === 'dark') {
          root.classList.add('dark');
          root.style.colorScheme = 'dark';
        } else {
          root.classList.remove('dark');
          root.style.colorScheme = 'light';
        }
      } catch (_) {
        document.documentElement.classList.remove('dark');
      }
    </script>

    <slot name="head" />
  </head>
  <body class="relative min-h-screen overflow-x-hidden font-sans bg-bg text-fg antialiased selection:bg-accent/20 selection:text-accent">
    {/* Global Futuristic Emerald & Sage Aurora Backdrop */}
    <div aria-hidden="true" class="pointer-events-none fixed inset-0 -z-10 overflow-hidden">
      <div class="bg-futuristic-mesh absolute inset-0 opacity-75 dark:opacity-50"></div>
      <div
        class="animate-aurora-1 absolute -left-32 -top-36 h-[34rem] w-[38rem] rounded-full bg-emerald-500/12 blur-[130px] dark:bg-emerald-500/16"
      ></div>
      <div
        class="animate-aurora-2 absolute -right-32 top-[22%] h-[30rem] w-[36rem] rounded-full bg-teal-500/10 blur-[140px] dark:bg-teal-400/12"
      ></div>
      <div
        class="animate-aurora-1 absolute bottom-[-10rem] left-1/3 h-[28rem] w-[42rem] rounded-full bg-emerald-600/8 blur-[150px] dark:bg-emerald-500/10"
      ></div>
    </div>

    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-card focus:px-4 focus:py-2 focus:text-fg focus:outline focus:outline-2 focus:outline-accent"
    >
      {t(lang, 'a11y.skip')}
    </a>
    <slot />

    <script>
      // Cursor-tracking spotlight for [data-spotlight] surfaces
      document.querySelectorAll<HTMLElement>('[data-spotlight]').forEach((card) => {
        card.addEventListener('pointermove', (e) => {
          const rect = card.getBoundingClientRect();
          card.style.setProperty('--mouse-x', `${e.clientX - rect.left}px`);
          card.style.setProperty('--mouse-y', `${e.clientY - rect.top}px`);
        });
      });

      // Scroll-triggered reveal animation for [data-reveal] elements
      const revealEls = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if (revealEls.length > 0 && 'IntersectionObserver' in window) {
        document.documentElement.classList.add('reveal-ready');
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.08, rootMargin: '0px 0px -40px 0px' },
        );
        revealEls.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
