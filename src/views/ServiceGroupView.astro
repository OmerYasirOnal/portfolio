---
/**
 * ServiceGroupView - /services/<group>: every service in the group with its
 * scope and honest notes, proof from real work, concept designs where
 * relevant, FAQ and a quote form preselected for the group.
 */
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SectionHead from '../components/SectionHead.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ConceptCard from '../components/ConceptCard.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import ContactChannels from '../components/ContactChannels.astro';
import ContactForm from '../components/ContactForm.astro';
import Icon from '../components/Icon.astro';
import { localizePath, pick, t, type Locale } from '../data/i18n';
import { serviceGroups, type ServiceGroup } from '../data/services';
import { concepts } from '../data/concepts';
import { breadcrumbJsonLd, canonicalHref, faqPageJsonLd, jsonLdScript, serviceListJsonLd } from '../lib/seo';
import { ogPagePath } from '../lib/og';

interface Props {
  locale: Locale;
  group: ServiceGroup;
}

const { locale, group: g } = Astro.props;
const L = (tr: string, en: string) => pick(locale, { tr, en });
const path = localizePath(locale, `/services/${g.id}`);
const url = canonicalHref(path, Astro.site!);

const projects = await getCollection('projects', (e) => !e.data.draft);
const work = g.work.map((slug) => projects.find((p) => p.id === slug)).filter((p) => p !== undefined);

const conceptIds: Record<string, string[]> = {
  'web-software': ['restaurant', 'dental', 'boutique'],
  'ads-growth': [],
  'content-video': ['salon'],
};
const groupConcepts = concepts.filter((c) => conceptIds[g.id].includes(c.id));
const others = serviceGroups.filter((x) => x.id !== g.id);

const formService: Record<string, string> = { 'web-software': 'web', 'ads-growth': 'google-ads', 'content-video': 'content' };

const serviceLd = serviceListJsonLd(
  g.services.map((s) => ({
    name: pick(locale, s.name),
    description: pick(locale, s.summary),
    url: `${url}#${s.id}`,
    category: pick(locale, g.short),
  })),
  Astro.site,
);
const faqLd = faqPageJsonLd(g.faqs.map((f) => ({ question: pick(locale, f.question), answer: pick(locale, f.answer) })));
const crumbs = breadcrumbJsonLd([
  { name: t(locale, 'nav.home'), url: canonicalHref(localizePath(locale, '/'), Astro.site!) },
  { name: t(locale, 'nav.services'), url: canonicalHref(localizePath(locale, '/services'), Astro.site!) },
  { name: pick(locale, g.short), url },
]);
---

<Base
  title={`${pick(locale, g.seoTitle)} | Ömer Yasir Önal`}
  description={pick(locale, g.description)}
  path={path}
  lang={locale}
  ogImage={ogPagePath(`services-${g.id}`, locale)}
  contactTopic={g.topic}
  pageEvent={{ name: 'service_view', params: { service_group: g.id } }}
>
  <script slot="head" type="application/ld+json" is:inline set:html={jsonLdScript(serviceLd)} />
  <script slot="head" type="application/ld+json" is:inline set:html={jsonLdScript(faqLd)} />
  <script slot="head" type="application/ld+json" is:inline set:html={jsonLdScript(crumbs)} />
  <SiteHeader locale={locale} path={path} contactTopic={g.topic} />

  <main id="main">
    <section class="container-page pb-12 pt-10 md:pt-14">
      <nav aria-label="Breadcrumb" class="mb-8 text-sm text-muted">
        <a href={localizePath(locale, '/services')} class="hover:text-accent">{t(locale, 'nav.services')}</a>
        <span aria-hidden="true"> / </span>
        <span aria-current="page" class="text-fg">{pick(locale, g.short)}</span>
      </nav>
      <div class="grid gap-10 md:grid-cols-[1.4fr_1fr] md:items-end">
        <div>
          <p class="eyebrow">{pick(locale, g.short)}</p>
          <h1 class="h-display mt-3">{pick(locale, g.title)}</h1>
          <p class="lead mt-5">{pick(locale, g.intro)}</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <WhatsAppButton locale={locale} topic={g.topic} location="service_hero" size="lg" />
            <a href="#teklif" class="btn btn-secondary btn-lg">
              {L('Form ile yaz', 'Use the form')}
            </a>
          </div>
        </div>
        <aside class="card p-6">
          <p class="label">{L('Çalışma şeklim', 'My approach')}</p>
          <p class="mt-3 text-[0.95rem] leading-relaxed text-fg">{pick(locale, g.angle)}</p>
        </aside>
      </div>

      <div class="mt-10 flex flex-wrap items-center gap-x-3 gap-y-2">
        <p class="label" id="on-this-page">{L('Bu sayfada', 'On this page')}</p>
        <ul class="flex flex-wrap gap-2" role="list" aria-labelledby="on-this-page">
          {g.services.map((s) => (
            <li><a href={`#${s.id}`} class="chip px-3 py-1 text-sm text-fg hover:border-border-strong">{pick(locale, s.name)}</a></li>
          ))}
        </ul>
      </div>
    </section>

    <div class="container-page space-y-5 pb-20 md:pb-24">
      {
        g.services.map((s) => (
          <section id={s.id} class="card scroll-mt-24 p-6 sm:p-8" aria-labelledby={`${s.id}-h`}>
            <div class="grid gap-8 lg:grid-cols-[1fr_1.2fr]">
              <div>
                <h2 id={`${s.id}-h`} class="text-2xl font-semibold tracking-tight text-fg">{pick(locale, s.name)}</h2>
                <p class="mt-3 text-[0.95rem] leading-relaxed text-muted">{pick(locale, s.summary)}</p>
                {s.note && (
                  <p class="mt-5 rounded-lg bg-accent-soft p-4 text-sm leading-relaxed text-fg">{pick(locale, s.note)}</p>
                )}
                <div class="mt-6">
                  <WhatsAppButton
                    locale={locale}
                    topic={s.topic}
                    location={`service_${s.id}`}
                    label={L('Bu hizmet için yaz', 'Ask about this')}
                    variant="secondary"
                    size="sm"
                  />
                </div>
              </div>
              <ul class="grid content-start gap-x-6 gap-y-3 sm:grid-cols-2" role="list">
                {s.items.map((it) => (
                  <li class="flex gap-2.5 text-[0.95rem] leading-relaxed text-fg">
                    <Icon name="check" size={16} class="mt-1 shrink-0 text-accent" />
                    {pick(locale, it)}
                  </li>
                ))}
              </ul>
            </div>
          </section>
        ))
      }
    </div>

    {
      work.length > 0 && (
        <section class="section section-alt">
          <div class="container-page">
            <SectionHead
              label={L('Örnek işler', 'Examples')}
              title={L('Bu alanda yaptıklarım', 'What I have done in this area')}
              link={{ href: localizePath(locale, '/projects'), text: L('Tüm çalışmalar', 'All work') }}
            />
            <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
              {work.map((entry) => <ProjectCard locale={locale} entry={entry} />)}
            </div>
          </div>
        </section>
      )
    }

    {
      groupConcepts.length > 0 && (
        <section class="section">
          <div class="container-page">
            <SectionHead
              label={L('Konsept tasarımlar', 'Concept designs')}
              title={L('Farklı sektörler için kurgu örnekleri', 'Layouts for different sectors')}
              intro={L('Sektöre göre nasıl bir yapı kurduğumu gösteren tasarım çalışmaları.', 'Design studies showing how I structure a site or account for a sector.')}
            />
            <div class:list={['grid gap-5', groupConcepts.length === 1 ? 'max-w-md' : 'md:grid-cols-2 lg:grid-cols-3']}>
              {groupConcepts.map((c) => <ConceptCard concept={c} locale={locale} />)}
            </div>
          </div>
        </section>
      )
    }

    <section class:list={['section', groupConcepts.length > 0 && 'border-t border-border']} aria-labelledby="faq-h">
      <div class="container-page"><div class="max-w-3xl">
        <h2 id="faq-h" class="h-section">{t(locale, 'packages.faqTitle')}</h2>
        <div class="mt-8 divide-y divide-border border-y border-border">
          {
            g.faqs.map((f) => (
              <details class="group py-5">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-[1.05rem] font-semibold text-fg [&::-webkit-details-marker]:hidden">
                  {pick(locale, f.question)}
                  <span class="shrink-0 text-xl leading-none text-accent transition-transform group-open:rotate-45" aria-hidden="true">+</span>
                </summary>
                <p class="mt-3 text-[0.95rem] leading-relaxed text-muted">{pick(locale, f.answer)}</p>
              </details>
            ))
          }
        </div>
      </div></div>
    </section>

    <section id="teklif" class="section section-alt scroll-mt-24" aria-labelledby="teklif-h">
      <div class="container-page grid gap-10 md:grid-cols-[1fr_1.1fr]">
        <div>
          <p class="eyebrow">{t(locale, 'nav.contact')}</p>
          <h2 id="teklif-h" class="h-section mt-3">{L('Kısaca anlatın, size özel teklif hazırlayayım.', 'Tell me briefly and I will prepare a tailored quote.')}</h2>
          <div class="mt-8"><ContactChannels locale={locale} topic={g.topic} location={`service_${g.id}_contact`} tone="light" /></div>
        </div>
        <div class="card p-6 sm:p-8">
          <ContactForm locale={locale} service={formService[g.id]} location={`service_${g.id}`} />
        </div>
      </div>
    </section>

    <nav class="section" aria-label={L('Diğer hizmetler', 'Other services')}>
      <div class="container-page">
        <p class="label">{L('Diğer hizmetler', 'Other services')}</p>
        <ul class="mt-4 grid gap-4 sm:grid-cols-2" role="list">
          {others.map((o) => (
            <li>
              <a href={localizePath(locale, `/services/${o.id}`)} class="card card-link flex items-center justify-between gap-4 p-5">
                <span>
                  <span class="h-card block">{pick(locale, o.short)}</span>
                  <span class="mt-1 block text-sm text-muted">{pick(locale, o.cardSummary)}</span>
                </span>
                <Icon name="arrow" size={18} class="shrink-0 text-accent" />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </nav>
  </main>

  <SiteFooter locale={locale} hideCta />
</Base>
