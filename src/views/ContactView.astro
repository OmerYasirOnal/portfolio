---
/**
 * ContactView - /contact: topic-specific WhatsApp shortcuts, direct channels
 * and the short quote form.
 */
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ContactChannels from '../components/ContactChannels.astro';
import ContactForm from '../components/ContactForm.astro';
import Icon from '../components/Icon.astro';
import { localizePath, pick, t, type Locale } from '../data/i18n';
import { whatsappHref, type ContactTopic } from '../lib/contact';
import { breadcrumbJsonLd, canonicalHref, jsonLdScript } from '../lib/seo';
import { ogPagePath } from '../lib/og';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const L = (tr: string, en: string) => pick(locale, { tr, en });
const path = localizePath(locale, '/contact');

const shortcuts: { topic: ContactTopic; label: string }[] = [
  { topic: 'web', label: L('Web sitesi yaptırmak istiyorum', 'I need a website') },
  { topic: 'google-ads', label: L('Google Ads desteği istiyorum', 'I need help with Google Ads') },
  { topic: 'meta-ads', label: L('Instagram / Facebook reklamı', 'Instagram / Facebook ads') },
  { topic: 'seo', label: L('Google’da görünür olmak istiyorum', 'I want to be found on Google') },
  { topic: 'content', label: L('Instagram içeriği istiyorum', 'I need Instagram content') },
  { topic: 'video', label: L('Tanıtım videosu istiyorum', 'I want a promo video') },
  { topic: 'software', label: L('Özel yazılım / uygulama', 'Custom software / app') },
  { topic: 'automation', label: L('Yapay zekâ ile otomasyon', 'AI automation') },
];

const contactLd = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: t(locale, 'nav.contact'),
  url: canonicalHref(path, Astro.site!),
  about: { '@id': `${new URL(Astro.site!).origin}/#person` },
};
const crumbs = breadcrumbJsonLd([
  { name: t(locale, 'nav.home'), url: canonicalHref(localizePath(locale, '/'), Astro.site!) },
  { name: t(locale, 'nav.contact'), url: canonicalHref(path, Astro.site!) },
]);
---

<Base
  title={L('İletişim ve Teklif | Ömer Yasir Önal', 'Contact and Quotes | Ömer Yasir Önal')}
  description={L(
    'Web sitesi, reklam yönetimi, SEO, Reels veya video için WhatsApp’tan yazın, e-posta gönderin ya da kısa teklif formunu doldurun.',
    'Message me on WhatsApp, send an email or fill in the short quote form for websites, ads, SEO, Reels or video.',
  )}
  path={path}
  lang={locale}
  ogImage={ogPagePath('contact', locale)}
  hideContactBar
>
  <script slot="head" type="application/ld+json" is:inline set:html={jsonLdScript(contactLd)} />
  <script slot="head" type="application/ld+json" is:inline set:html={jsonLdScript(crumbs)} />
  <SiteHeader locale={locale} path={path} />

  <main id="main" class="mx-auto max-w-6xl px-4 pt-14 sm:px-6">
    <p class="label">{t(locale, 'nav.contact')}</p>
    <h1 class="mt-3 max-w-3xl text-4xl font-semibold leading-[1.08] tracking-tight text-fg sm:text-5xl">
      {L('Projenizi konuşalım.', 'Let’s talk about your project.')}
    </h1>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-muted">
      {L(
        'En hızlı yol WhatsApp. Aşağıdan konunuza uygun mesajı seçin, hazır metinle açılsın. Yazmayı tercih ederseniz e-posta ya da form da olur.',
        'WhatsApp is the fastest way. Pick your topic below and the chat opens with a ready message. Email or the form work too.',
      )}
    </p>

    <section class="mt-12" aria-labelledby="wa-h">
      <h2 id="wa-h" class="label">{L('Konuya göre WhatsApp', 'WhatsApp by topic')}</h2>
      <ul class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-4" role="list">
        {
          shortcuts.map((s) => (
            <li>
              <a
                href={whatsappHref(locale, s.topic)}
                target="_blank"
                rel="noopener noreferrer"
                data-track="whatsapp_click"
                data-track-location="contact_shortcut"
                data-track-topic={s.topic}
                class="group flex h-full items-center justify-between gap-3 rounded-xl border border-border bg-card p-4 text-[0.95rem] font-medium text-fg hover:border-accent"
              >
                {s.label}
                <Icon name="whatsapp" size={18} class="shrink-0 text-accent" />
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mt-14 grid gap-10 rounded-2xl border border-border bg-card p-6 sm:p-10 md:grid-cols-[1fr_1.15fr]">
      <div>
        <h2 class="text-2xl font-semibold tracking-tight text-fg">{L('Doğrudan iletişim', 'Direct contact')}</h2>
        <div class="mt-6"><ContactChannels locale={locale} location="contact_page" /></div>
        <p class="mt-6 text-sm leading-relaxed text-muted">
          {L('İstanbul’dayım; Türkiye’nin her yerinden ve yurt dışından uzaktan çalışıyorum.', 'Based in Istanbul, working remotely with clients across Türkiye and abroad.')}
        </p>
      </div>
      <div>
        <h2 class="text-2xl font-semibold tracking-tight text-fg">{L('Kısa teklif formu', 'Short quote form')}</h2>
        <div class="mt-6"><ContactForm locale={locale} location="contact_page" /></div>
      </div>
    </section>
  </main>

  <SiteFooter locale={locale} hideCta />
</Base>
