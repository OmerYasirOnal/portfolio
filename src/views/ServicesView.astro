---
/**
 * ServicesView - /services hub: the three groups with every service, how
 * pricing works (scope-based quotes, packages only on some sector pages), and
 * the process.
 */
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SectionHead from '../components/SectionHead.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import Icon from '../components/Icon.astro';
import { localizePath, pick, t, type Locale } from '../data/i18n';
import { serviceGroups, processSteps } from '../data/services';
import { landings } from '../data/landings';
import { breadcrumbJsonLd, canonicalHref, jsonLdScript, serviceListJsonLd } from '../lib/seo';
import { ogPagePath } from '../lib/og';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const L = (tr: string, en: string) => pick(locale, { tr, en });
const path = localizePath(locale, '/services');
const url = canonicalHref(path, Astro.site!);

const title = L('Hizmetler: Web Sitesi, Reklam ve Sosyal Medya | Ömer Yasir Önal', 'Services: Websites, Ads and Social Media | Ömer Yasir Önal');
const description = L(
  'Web sitesi ve yazılım, reklam ve arama görünürlüğü, sosyal medya ve video: kurumsal site, Google Ads ve Meta reklamları, SEO, Reels ve video kurgusu. Kapsama göre teklif.',
  'Websites & software, ads & search visibility, social media & video: business sites, Google Ads and Meta ads, SEO, Reels and video editing. Quoted by scope.',
);

/** Sector pages in this locale that show fixed packages (linked from the pricing note). */
const packagePages = landings.filter((l) => l.locale === locale && l.packages && l.packages.length > 0);

const serviceLd = serviceListJsonLd(
  serviceGroups.flatMap((g) =>
    g.services.map((s) => ({
      name: pick(locale, s.name),
      description: pick(locale, s.summary),
      url: `${canonicalHref(localizePath(locale, `/services/${g.id}`), Astro.site!)}#${s.id}`,
      category: pick(locale, g.short),
    })),
  ),
  Astro.site,
);
const crumbs = breadcrumbJsonLd([
  { name: t(locale, 'nav.home'), url: canonicalHref(localizePath(locale, '/'), Astro.site!) },
  { name: t(locale, 'nav.services'), url },
]);
---

<Base title={title} description={description} path={path} lang={locale} ogImage={ogPagePath('services', locale)}>
  <script slot="head" type="application/ld+json" is:inline set:html={jsonLdScript(serviceLd)} />
  <script slot="head" type="application/ld+json" is:inline set:html={jsonLdScript(crumbs)} />
  <SiteHeader locale={locale} path={path} />

  <main id="main">
    <section class="container-page pb-12 pt-14 md:pt-20">
      <SectionHead
        as="h1"
        label={t(locale, 'nav.services')}
        title={L('Web sitesi, reklam ve sosyal medya hizmetleri', 'Website, advertising and social media services')}
        intro={L(
          'Hizmetleri üç başlıkta topladım. Birini ya da birkaçını birlikte seçebilirsiniz. Kapsam ve fiyat, ilk görüşmeden sonra yazılı olarak netleşir.',
          'Services are grouped in three areas. Pick one or combine several. Scope and price are agreed in writing after the first conversation.',
        )}
      />
    </section>

    <div class="container-page space-y-6 pb-20 md:pb-24">
      {
        serviceGroups.map((g) => (
          <section class="card p-6 sm:p-8" aria-labelledby={`g-${g.id}`}>
            <div class="grid gap-8 lg:grid-cols-[1fr_1.4fr]">
              <div>
                <h2 id={`g-${g.id}`} class="text-2xl font-semibold tracking-tight text-fg">{pick(locale, g.short)}</h2>
                <p class="mt-3 text-[0.95rem] leading-relaxed text-muted">{pick(locale, g.cardSummary)}</p>
                <a href={localizePath(locale, `/services/${g.id}`)} class="btn btn-secondary btn-sm mt-6">
                  {L('Detaylar ve örnek işler', 'Details and examples')}
                  <Icon name="arrow" size={15} />
                </a>
              </div>
              <ul class="divide-y divide-border border-y border-border" role="list">
                {g.services.map((s) => (
                  <li>
                    <a href={`${localizePath(locale, `/services/${g.id}`)}#${s.id}`} class="group grid gap-1 py-4 sm:grid-cols-[1fr_auto] sm:gap-4">
                      <span>
                        <span class="block font-semibold text-fg group-hover:text-accent">{pick(locale, s.name)}</span>
                        <span class="mt-1 block text-sm leading-relaxed text-muted">{pick(locale, s.summary)}</span>
                      </span>
                      <Icon name="arrow" size={15} class="mt-1 hidden text-accent sm:block" />
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </section>
        ))
      }
    </div>

    <section class="section section-alt" aria-labelledby="pricing-h">
      <div class="container-page grid gap-10 md:grid-cols-[1fr_1.4fr]">
        <div>
          <p class="eyebrow">{L('Fiyatlandırma', 'Pricing')}</p>
          <h2 id="pricing-h" class="h-section mt-3">{L('Kapsama göre teklif', 'Quoted by scope')}</h2>
        </div>
        <div class="space-y-5 text-[0.95rem] leading-relaxed text-muted">
          <p class="text-fg">
            {L(
              'Genel işler kapsama göre fiyatlanır; bazı sektör sayfalarında hazır paketler var. Reklam bütçesi yönetim ücretinden ayrıdır ve doğrudan Google’a veya Meta’ya ödenir.',
              'General work is priced by scope; some sector pages offer fixed packages. Ad spend is separate from the management fee and is paid directly to Google or Meta.',
            )}
          </p>
          <p>
            {L(
              'Kısa bir görüşmeden sonra kapsamı, takvimi ve fiyatı yazılı olarak gönderiyorum.',
              'After a short conversation I send the scope, timeline and price in writing.',
            )}
          </p>
          <ul class="space-y-2 text-fg" role="list">
            <li class="flex gap-2"><Icon name="check" size={16} class="mt-1 shrink-0 text-accent" />{L('Tek seferlik işler (site, video, SEO denetimi) ve aylık işler (reklam yönetimi, içerik) ayrı fiyatlanır.', 'One-off jobs (site, video, SEO audit) and monthly work (ads, content) are priced separately.')}</li>
            <li class="flex gap-2"><Icon name="check" size={16} class="mt-1 shrink-0 text-accent" />{L('Sıralama, satış veya ciro garantisi vermiyorum; ne yaptığımı ve ne değiştiğini raporluyorum.', 'No ranking, sales or revenue guarantees; I report what I did and what changed.')}</li>
          </ul>
          {
            packagePages.length > 0 && (
              <div>
                <p class="label">{L('Hazır paketi olan sayfalar', 'Pages with fixed packages')}</p>
                <ul class="mt-2 space-y-1.5" role="list">
                  {packagePages.map((l) => (
                    <li>
                      <a href={`${l.slug}/#paketler`} class="link-arrow">
                        {l.serviceName}
                        <Icon name="arrow" size={14} />
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }
          <div class="pt-2"><WhatsAppButton locale={locale} location="services_pricing" /></div>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="process-h">
      <div class="container-page">
        <SectionHead id="process-h" label={L('Süreç', 'Process')} title={L('Nasıl çalışıyorum?', 'How I work')} />
        <ol class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4" role="list">
          {
            processSteps.map((s, i) => (
              <li class="border-t border-border pt-5">
                <span class="inline-flex size-8 items-center justify-center rounded-full bg-accent-soft text-sm font-semibold text-accent" aria-hidden="true">{i + 1}</span>
                <h3 class="h-card mt-4">{pick(locale, s.title)}</h3>
                <p class="mt-2 text-[0.95rem] leading-relaxed text-muted">{pick(locale, s.description)}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>
  </main>

  <SiteFooter locale={locale} />
</Base>
