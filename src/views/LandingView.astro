---
/**
 * LandingView - single-language offer page (src/data/landings.ts): light hero,
 * client Reels or sample covers, deliverables, packages, related client work,
 * process, FAQ and a light contact block.
 * No mirror route, so canonical is the page itself and the language toggle
 * points at the other locale's home page.
 */
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import ContactChannels from '../components/ContactChannels.astro';
import SectionHead from '../components/SectionHead.astro';
import Icon from '../components/Icon.astro';
import { pick } from '../data/i18n';
import { processSteps } from '../data/services';
import { reels } from '../data/social';
import { profile } from '../data/profile';
import type { Landing } from '../data/landings';
import { faqPageJsonLd, jsonLdScript, breadcrumbJsonLd } from '../lib/seo';

interface Props {
  landing: Landing;
}

const { landing: d } = Astro.props;
const locale = d.locale;
const L = (tr: string, en: string) => pick(locale, { tr, en });
const site = new URL(Astro.site!).origin;
const url = `${site}${d.slug}/`;
const home = locale === 'tr' ? '/' : '/en/';
const shown = d.reelIds.map((id) => reels.find((r) => r.id === id)!).filter(Boolean);
const hasCovers = !!d.covers && d.covers.length > 0;
const hasPackages = !!d.packages && d.packages.length > 0;

const monthly = (unit: string) => /^(aylık|per month)$/i.test(unit);
const offers = (d.packages ?? []).map((p) => ({
  '@type': 'Offer',
  name: p.name,
  description: p.text,
  price: p.amount,
  priceCurrency: p.currency,
  ...(monthly(p.unit)
    ? { priceSpecification: { '@type': 'UnitPriceSpecification', price: p.amount, priceCurrency: p.currency, unitCode: 'MON', referenceQuantity: { '@type': 'QuantitativeValue', value: 1, unitCode: 'MON' } } }
    : {}),
  url: `${url}#paketler`,
}));
const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: d.serviceName,
  description: d.description,
  url,
  areaServed: locale === 'tr' ? { '@type': 'City', name: 'Istanbul' } : 'Worldwide',
  availableLanguage: locale === 'tr' ? ['tr', 'en'] : ['en', 'tr'],
  provider: { '@id': `${site}/#person` },
  ...(offers.length ? { offers } : {}),
};
---

<Base title={d.seoTitle} description={d.description} path={d.slug} lang={locale} canonicalUrl={url} contactTopic={d.topic}>
  <script slot="head" type="application/ld+json" is:inline set:html={jsonLdScript(serviceLd)} />
  <script slot="head" type="application/ld+json" is:inline set:html={jsonLdScript(faqPageJsonLd(d.faqs.map((f) => ({ question: f.q, answer: f.a }))))} />
  <script slot="head" type="application/ld+json" is:inline set:html={jsonLdScript(breadcrumbJsonLd([{ name: profile.name, url: `${site}${home}` }, { name: d.serviceName, url }]))} />

  <SiteHeader locale={locale} path={home} contactTopic={d.topic} />

  <main id="main">
    {/* ---------- Hero ---------- */}
    <section class="section">
      <div class="container-page">
        <div class="max-w-3xl">
          <p class="eyebrow">{d.eyebrow}</p>
          <h1 class="h-display mt-4">{d.h1}</h1>
          <p class="lead mt-6">{d.intro}</p>
          <div class="mt-9 flex flex-wrap gap-3">
            <WhatsAppButton locale={locale} topic={d.topic} location={`landing${d.slug}`} label={d.ctaLabel} size="lg" />
            <a href="#examples" class="btn btn-secondary btn-lg">{L('Örnekleri inceleyin', 'See examples')}</a>
          </div>
        </div>
      </div>
    </section>

    {/* ---------- Examples: sample covers and/or client Reels ---------- */}
    <section id="examples" class="section section-alt scroll-mt-20">
      <div class="container-page" data-reveal>
        <SectionHead
          label={hasCovers ? L('Örnekler', 'Examples') : L('Yayındaki işler', 'Live work')}
          title={hasCovers ? L('Sizin için hazırlanabilecek içeriklerden örnekler', 'Examples of what I could make for you') : L('Müşterilerim için hazırladığım videolar', 'Videos I made for clients')}
        />
        {hasCovers && (
          <>
            <ul class="grid grid-cols-2 gap-4 sm:gap-6 lg:grid-cols-4" role="list">
              {d.covers!.map((c) => (
                <li>
                  <div class="phone phone--plain"><span class="phone__screen block"><img src={c.src} alt={c.alt} width="540" height="960" loading="lazy" decoding="async" /></span></div>
                </li>
              ))}
            </ul>
            {d.coversNote && <p class="mt-6 max-w-2xl text-sm leading-relaxed text-muted">{d.coversNote}</p>}
          </>
        )}
        {shown.length > 0 && (
          <ul class:list={['grid grid-cols-2 gap-4 sm:gap-6 lg:grid-cols-4', hasCovers && 'mt-10']} role="list">
            {shown.map((r) => (
              <li>
                <a href={r.ready && r.project ? `${locale === 'en' ? '/en' : ''}/projects/${r.project}/` : r.url} target={r.ready ? undefined : '_blank'} rel={r.ready ? undefined : 'noopener noreferrer'} class="phone block" aria-label={pick(locale, r.title)}>
                  <span class="phone__screen block"><video data-autoplay muted loop playsinline preload="none" poster={r.poster} src={r.preview}></video></span>
                </a>
                <p class="mt-3 text-sm font-semibold leading-snug text-fg">{pick(locale, r.title)}</p>
                <p class="mt-1 text-xs leading-snug text-muted">{pick(locale, r.kind)}</p>
              </li>
            ))}
          </ul>
        )}
      </div>
    </section>

    {/* ---------- Deliverables ---------- */}
    <section class="section">
      <div class="container-page" data-reveal>
        <SectionHead label={L('Kapsam', 'Scope')} title={L('Ne alıyorsunuz?', 'What you get')} />
        <ul class="grid gap-5 sm:grid-cols-2" role="list">
          {d.deliverables.map((x) => (
            <li class="card flex gap-4 p-6">
              <span class="grid h-9 w-9 shrink-0 place-items-center rounded-lg bg-accent-soft text-accent" aria-hidden="true"><Icon name="check" size={18} /></span>
              <div>
                <h3 class="h-card">{x.title}</h3>
                <p class="mt-2 text-[0.95rem] leading-relaxed text-muted">{x.text}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    {/* ---------- Packages ---------- */}
    {hasPackages && (
      <section id="paketler" class="section section-alt scroll-mt-20">
        <div class="container-page" data-reveal>
          <SectionHead label={L('Paketler', 'Packages')} title={L('Paketler ve fiyatlar', 'Packages and prices')} />
          <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4" role="list">
            {d.packages!.map((p, i) => (
              <li>
                <div class:list={['card flex h-full flex-col p-6', p.featured && 'border-accent']}>
                  <div class:list={['mb-3 h-6', !p.featured && 'hidden lg:block']}>{p.featured && <span class="status">{L('Önerilen', 'Recommended')}</span>}</div>
                  <h3 class="h-card">{p.name}</h3>
                  <p class="mt-3 text-3xl font-semibold tracking-tight text-fg">{p.price}<span class="ml-1.5 align-middle text-sm font-normal text-muted">{p.unit}</span></p>
                  <p class="mt-3 flex-1 text-[0.92rem] leading-relaxed text-muted">{p.text}</p>
                  <div class="mt-5"><WhatsAppButton locale={locale} topic={d.topic} location={`package-${i + 1}`} label={L('Bu paketi sor', 'Ask about this')} variant={p.featured ? 'primary' : 'secondary'} /></div>
                </div>
              </li>
            ))}
          </ul>
          {d.packagesNote && <p class="mt-6 max-w-3xl text-sm leading-relaxed text-muted">{d.packagesNote}</p>}
        </div>
      </section>
    )}

    {/* ---------- Related client work ---------- */}
    <section class:list={['section', !hasPackages && 'border-t border-border']}>
      <div class="container-page" data-reveal>
        <SectionHead label={L('Referanslar', 'References')} title={L('Benzer işler', 'Related work')} />
        <ul class:list={['grid gap-5', d.proof.length >= 3 ? 'md:grid-cols-3' : 'md:grid-cols-2']} role="list">
          {d.proof.map((p) => (
            <li>
              <a href={p.href} class="card card-link group flex h-full flex-col p-6">
                <h3 class="h-card group-hover:text-accent">{p.title}</h3>
                <p class="mt-2 text-[0.95rem] leading-relaxed text-muted">{p.text}</p>
                <span class="link-arrow mt-auto pt-5">{L('İncele', 'View')} <Icon name="arrow" size={14} /></span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    {/* ---------- Process ---------- */}
    <section class="section section-alt">
      <div class="container-page" data-reveal>
        <SectionHead label={L('Süreç', 'Process')} title={L('Çalışma süreci', 'How I work')} />
        <ol class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4" role="list">
          {processSteps.map((s, i) => (
            <li class="border-t border-border pt-5">
              <span class="grid h-8 w-8 place-items-center rounded-full bg-accent-soft text-sm font-semibold text-accent" aria-hidden="true">{i + 1}</span>
              <h3 class="h-card mt-4">{pick(locale, s.title)}</h3>
              <p class="mt-2 text-[0.95rem] leading-relaxed text-muted">{pick(locale, s.description)}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    {/* ---------- FAQ ---------- */}
    <section class="section">
      <div class="container-page">
        <div class="max-w-3xl">
          <SectionHead title={L('Sık sorulan sorular', 'Frequently asked questions')} />
          <div class="divide-y divide-border border-y border-border">
            {d.faqs.map((f, i) => (
              <details class="group py-5" open={i === 0}>
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-[1.05rem] font-semibold text-fg">
                  {f.q}
                  <span class="grid h-7 w-7 shrink-0 place-items-center text-xl leading-none text-accent transition-transform duration-200 group-open:rotate-45" aria-hidden="true">+</span>
                </summary>
                <p class="mt-3 text-[0.98rem] leading-relaxed text-muted">{f.a}</p>
              </details>
            ))}
          </div>
        </div>
      </div>
    </section>

    {/* ---------- Contact ---------- */}
    <section class="section section-alt">
      <div class="container-page grid gap-10 md:grid-cols-[1fr_1.1fr] md:gap-16">
        <div>
          <p class="eyebrow">{L('İletişim', 'Contact')}</p>
          <h2 class="h-section mt-3">{L('Projenizi konuşalım', 'Let’s talk about your project')}</h2>
          <p class="lead mt-4">{L('Ne istediğinizi kısaca yazın. En hızlı yol WhatsApp; e-posta da olur. Genellikle bir iş günü içinde dönüş yapıyorum.', 'Tell me briefly what you need. WhatsApp is fastest; email works too. I usually reply within one working day (Istanbul, GMT+3).')}</p>
        </div>
        <ContactChannels locale={locale} location={`landing${d.slug}`} topic={d.topic} tone="light" />
      </div>
    </section>
  </main>

  <SiteFooter locale={locale} hideCta flush />
</Base>
