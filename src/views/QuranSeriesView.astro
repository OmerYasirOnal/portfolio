---
/**
 * QuranSeriesView - /kuran-reels: every Kur'an Reels episode, grouped by surah
 * in revelation (nüzul) order. Built for search: one page per episode, linked
 * from here and from the project page. Not linked from home, header or footer.
 */
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Icon from '../components/Icon.astro';
import { localizePath, pick, t, type Locale } from '../data/i18n';
import { profile } from '../data/profile';
import { episodesOfSurah, quranEpisodes, quranSurahs, surahLabel } from '../data/quran-reels';
import { ogProjectPath } from '../lib/og';
import { breadcrumbJsonLd, canonicalHref, jsonLdScript } from '../lib/seo';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const L = (tr: string, en: string) => pick(locale, { tr, en });
const site = Astro.site!;
const hint = t(locale, 'social.opensNewTab');
const path = localizePath(locale, '/kuran-reels');
const url = canonicalHref(path, site);
const projectPath = localizePath(locale, '/projects/kuran-reels/');
const igUrl = profile.instagram.url || 'https://www.instagram.com/omeryasironal/';

const epHref = (slug: string) => localizePath(locale, `/kuran-reels/${slug}/`);
const epTitle = (e: (typeof quranEpisodes)[number]) => (locale === 'en' ? e.shortEn : e.shortTr);
const surahNames = quranSurahs.map((s) => surahLabel(locale, { surahTr: s.nameTr, surahEn: s.nameEn }).replace(/ Suresi$/, ''));
const nameList = surahNames.join(', ');

const listLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: L("Nüzul sırasıyla Kur'an Reels", "Qur'an Reels in revelation order"),
  itemListOrder: 'https://schema.org/ItemListOrderAscending',
  numberOfItems: quranEpisodes.length,
  itemListElement: quranEpisodes.map((e, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: `${surahLabel(locale, e)} ${e.range}: ${epTitle(e)}`,
    url: canonicalHref(epHref(e.slug), site),
  })),
};
const crumbs = breadcrumbJsonLd([
  { name: t(locale, 'nav.home'), url: canonicalHref(localizePath(locale, '/'), site) },
  { name: L("Kur'an Reels", "Qur'an Reels"), url },
]);
---

<Base
  title={L("Nüzul Sırasıyla Kur'an Reels: Tüm Bölümler | Ömer Yasir Önal", "Qur'an Reels in Revelation Order: All Episodes | Ömer Yasir Önal")}
  description={L(
    `Kur'an'ı nüzul sırasıyla anlattığım kısa Reels serisinin bölümleri (${nameList}). Her bölümde video, açıklama ve ayetlerin Arapça metni.`,
    `Short Reels on the Qur'an in revelation order (${nameList}): video, description and Arabic text.`,
  )}
  path={path}
  lang={locale}
  ogImage={ogProjectPath(locale, 'kuran-reels')}
  hideContactBar
>
  <script slot="head" type="application/ld+json" is:inline set:html={jsonLdScript(listLd)} />
  <script slot="head" type="application/ld+json" is:inline set:html={jsonLdScript(crumbs)} />
  <SiteHeader locale={locale} path={path} />

  <main id="main">
    <div class="container-page pb-6 pt-14 md:pt-20">
      <header class="max-w-3xl">
        <p class="eyebrow">{L("Kur'an Reels", "Qur'an Reels")}</p>
        <h1 class="h-display mt-3">{L("Nüzul sırasıyla Kur'an Reels", "Qur'an Reels in revelation order")}</h1>
        <p class="lead mt-4">
          {
            L(
              "Kur'an'ı nüzul sırasıyla kısa Reels videolarla anlattığım kendi Instagram serim. Türkçe ses, İngilizce altyazı. Her bölüm tek bir soru ve anahtar bir Arapça kelime etrafında kurulu; iki dakikanın altında kendi başına açılıp kapanıyor.",
              'My own Instagram series that explains the Qur’an in revelation order through short Reels, with Turkish voice and English subtitles. Each episode is built around a single question and a key Arabic word, so it opens and closes on its own in under two minutes.',
            )
          }
        </p>
        <p class="mt-3 text-sm text-muted">
          {
            L(
              `${quranEpisodes.length} bölüm, ${quranSurahs.length} sure. Her bölümün sayfasında video, açıklama ve ayetlerin Arapça metni yer alıyor.`,
              `${quranEpisodes.length} episodes, ${quranSurahs.length} surahs. Each episode page has the video, a description and the Arabic text.`,
            )
          }
        </p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a href={projectPath} class="btn btn-secondary">
            {L('Proje sayfası', 'Project page')}
            <Icon name="arrow" size={15} />
          </a>
          <a
            href={igUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-secondary"
            data-track="instagram_click"
            data-track-location="quran_series"
            aria-label={`Instagram @omeryasironal (${hint})`}
          >
            <Icon name="instagram" size={16} />
            @omeryasironal
          </a>
        </div>
      </header>
    </div>

    {
      quranSurahs.map((s, si) => {
        const eps = episodesOfSurah(s.no);
        const name = surahLabel(locale, { surahTr: s.nameTr, surahEn: s.nameEn });
        return (
          <section
            id={`sure-${s.no}`}
            class:list={['section scroll-mt-24', si % 2 === 0 ? 'section-alt' : '']}
            aria-labelledby={`sure-${s.no}-h`}
          >
            <div class="container-page">
              <header class="mb-8">
                <p class="label">
                  {L(`Nüzul sırası ${s.nuzul} · Mushaf ${s.no}`, `Revelation order ${s.nuzul} · Chapter ${s.no}`)}
                </p>
                <h2 id={`sure-${s.no}-h`} class="h-section mt-2">{name}</h2>
              </header>
              <ul class="grid grid-cols-2 gap-4 sm:grid-cols-3 sm:gap-6 lg:grid-cols-4" role="list">
                {eps.map((e) => (
                  <li>
                    <a href={epHref(e.slug)} class="card card-link block h-full p-3">
                      <div class="phone phone--plain">
                        <div class="phone__screen">
                          <img src={e.cover} width="540" height="960" alt="" loading="lazy" decoding="async" />
                        </div>
                      </div>
                      <span class="label mt-3 block px-1">
                        {L('Ayet', e.ayahFrom === e.ayahTo ? 'Verse' : 'Verses')} {e.range}
                      </span>
                      <span class="h-card mt-1 block px-1 pb-1 text-base">{epTitle(e)}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </section>
        );
      })
    }
  </main>

  <SiteFooter locale={locale} />
</Base>
