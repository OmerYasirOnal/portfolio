---
/**
 * ProjectDetailView - /projects/<slug>: outcome first (tagline + live link),
 * then screenshot or videos, then problem / what I did / highlights, then the
 * technology for those who want it, and a contact prompt.
 */
import type { CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ProjectCaseStudy from '../components/ProjectCaseStudy.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import Icon from '../components/Icon.astro';
import { t, localizePath, pick, type Locale } from '../data/i18n';
import { ogProjectPath } from '../lib/og';
import { creativeWorkJsonLd, breadcrumbJsonLd, canonicalHref, jsonLdScript } from '../lib/seo';
import type { ContactTopic } from '../lib/contact';

interface Props {
  locale: Locale;
  entry: CollectionEntry<'projects'>;
}

const { locale, entry } = Astro.props;
const { data } = entry;
const L = (tr: string, en: string) => pick(locale, { tr, en });
const path = localizePath(locale, `/projects/${entry.id}`);
const tagline = locale === 'en' ? data.tagline_en : data.tagline_tr;
const status = locale === 'en' ? data.status_en : data.status_tr;

type LinkKey = 'appstore' | 'live' | 'repo' | 'other';
const LINK_ORDER: LinkKey[] = ['live', 'appstore', 'repo', 'other'];
const links = LINK_ORDER.filter((k) => data.links?.[k]).map((k) => ({
  key: k,
  href: data.links![k] as string,
  label: (data.links![k] as string).includes('instagram.com') ? L('Instagram’da izle', 'Watch on Instagram') : t(locale, `link.${k}`),
}));
const hint = t(locale, 'social.opensNewTab');

const topic: ContactTopic =
  data.category === 'Content' ? 'video' : data.category === 'Web' && data.group === 'client' ? 'web' : data.category === 'Mobile' ? 'mobile' : 'general';

const url = canonicalHref(path, Astro.site!);
const workLd = creativeWorkJsonLd(
  { title: data.title, description: tagline, category: data.category, url, stack: data.stack },
  Astro.site!,
);
const videoLd = data.videos.map((v) => ({
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: locale === 'tr' ? v.title_tr : v.title_en,
  description: tagline,
  thumbnailUrl: new URL(v.poster, Astro.site).toString(),
  contentUrl: new URL(v.src, Astro.site).toString(),
  uploadDate: '2026-11-12',
  creator: { '@id': `${new URL(Astro.site!).origin}/#person` },
  ...(v.url ? { url: v.url } : {}),
}));
const crumbs = breadcrumbJsonLd([
  { name: t(locale, 'nav.work'), url: canonicalHref(localizePath(locale, '/projects'), Astro.site!) },
  { name: data.title, url },
]);
---

<Base
  title={`${data.title} | ${L('Çalışmalar', 'Work')} | Ömer Yasir Önal`}
  description={tagline}
  path={path}
  lang={locale}
  ogImage={ogProjectPath(locale, entry.id)}
  ogType="article"
  contactTopic={topic}
>
  <script slot="head" type="application/ld+json" is:inline set:html={jsonLdScript(workLd)} />
  <script slot="head" type="application/ld+json" is:inline set:html={jsonLdScript(crumbs)} />
  {videoLd.length > 0 && <script slot="head" type="application/ld+json" is:inline set:html={jsonLdScript(videoLd)} />}
  <SiteHeader locale={locale} path={path} contactTopic={topic} />

  <main id="main">
    <article class="mx-auto max-w-4xl px-4 pt-10 sm:px-6">
      <nav aria-label="Breadcrumb" class="font-mono text-xs text-muted">
        <a href={localizePath(locale, '/projects')} class="hover:text-accent">{t(locale, 'nav.work')}</a>
        <span aria-hidden="true"> / </span>
        <span aria-current="page" class="text-fg">{data.title}</span>
      </nav>

      <header class="mt-8 border-b border-border pb-8">
        <p class="label">{t(locale, `category.${data.category}`)} · {status}</p>
        <h1 class="mt-3 text-4xl font-semibold leading-[1.08] tracking-tight text-fg sm:text-5xl">{data.title}</h1>
        <p class="mt-4 text-lg leading-relaxed text-muted sm:text-xl">{tagline}</p>
        {
          links.length > 0 && (
            <div class="mt-7 flex flex-wrap gap-3">
              {links.map((link, idx) => (
                <a
                  href={link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${link.label} (${hint})`}
                  class:list={[
                    'inline-flex items-center gap-2 rounded-full px-5 py-3 text-sm font-semibold transition-colors',
                    idx === 0
                      ? 'bg-ink text-on-ink dark:bg-on-ink dark:text-ink'
                      : 'border border-fg/20 bg-card text-fg hover:border-accent hover:text-accent',
                  ]}
                >
                  {link.label}
                  <Icon name="arrow-up-right" size={14} />
                </a>
              ))}
            </div>
          )
        }
      </header>

      {
        data.videos.length > 0 && (
          <div class="mt-8 grid gap-5 sm:grid-cols-2">
            {data.videos.map((v) => (
              <figure class="overflow-hidden rounded-2xl border border-border bg-ink">
                <video
                  src={v.src}
                  poster={v.poster}
                  controls
                  playsinline
                  preload="none"
                  class="aspect-[9/16] w-full object-cover"
                  aria-label={locale === 'tr' ? v.title_tr : v.title_en}
                />
                <figcaption class="flex items-center justify-between gap-3 bg-card px-4 py-3 text-sm font-medium text-fg">
                  <span>{locale === 'tr' ? v.title_tr : v.title_en}</span>
                  {v.url && (
                    <a href={v.url} target="_blank" rel="noopener noreferrer" class="inline-flex shrink-0 items-center gap-1.5 font-semibold text-accent hover:underline" aria-label={`${L('Instagram’da izle', 'Watch on Instagram')} (${hint})`}>
                      <Icon name="instagram" size={15} /> {L('Instagram', 'Instagram')}
                    </a>
                  )}
                </figcaption>
              </figure>
            ))}
          </div>
        )
      }

      <ProjectCaseStudy entry={entry} locale={locale} showImage={data.videos.length === 0 || data.category !== 'Content'} />

      <section class="mt-12 border-t border-border pt-8">
        <h2 class="label">{t(locale, 'project.stack')}</h2>
        <ul class="mt-4 flex flex-wrap gap-2" role="list">
          {data.stack.map((tech) => <li class="rounded-md bg-card px-2.5 py-1.5 font-mono text-xs text-muted ring-1 ring-border">{tech}</li>)}
        </ul>
      </section>

      <aside class="mt-14 flex flex-col gap-5 rounded-2xl border border-border bg-card p-6 sm:flex-row sm:items-center sm:justify-between sm:p-8">
        <p class="text-lg font-semibold tracking-tight text-fg">{L('Benzer bir işe mi ihtiyacınız var?', 'Need something similar?')}</p>
        <WhatsAppButton locale={locale} topic={topic} location="project_detail" />
      </aside>
    </article>
  </main>

  <SiteFooter locale={locale} />
</Base>
