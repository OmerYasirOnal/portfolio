---
/**
 * ProjectDetailView - /projects/<slug>: outcome first (tagline + live link),
 * then screenshot or videos, then problem / what I did / highlights, then the
 * technology for those who want it, and a contact prompt.
 */
import type { CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ProjectCaseStudy from '../components/ProjectCaseStudy.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import Icon from '../components/Icon.astro';
import { t, localizePath, pick, type Locale } from '../data/i18n';
import { ogProjectPath } from '../lib/og';
import { creativeWorkJsonLd, breadcrumbJsonLd, canonicalHref, jsonLdScript } from '../lib/seo';
import type { ContactTopic } from '../lib/contact';
import { quranEpisodes, surahLabel } from '../data/quran-reels';

interface Props {
  locale: Locale;
  entry: CollectionEntry<'projects'>;
}

const { locale, entry } = Astro.props;
const { data } = entry;
const L = (tr: string, en: string) => pick(locale, { tr, en });
const path = localizePath(locale, `/projects/${entry.id}`);
const tagline = locale === 'en' ? data.tagline_en : data.tagline_tr;
const status = locale === 'en' ? data.status_en : data.status_tr;
// stack_en is optional; the cast keeps this valid whether or not the schema declares it yet.
const stackEn = (data as typeof data & { stack_en?: string[] }).stack_en;
const stack = locale === 'en' && stackEn?.length ? stackEn : data.stack;
// Short taglines make thin meta descriptions: add status and stack.
const metaDescription =
  tagline.length >= 90 ? tagline : `${tagline} ${data.title}: ${status}. ${L('Teknolojiler', 'Built with')}: ${stack.slice(0, 4).join(', ')}.`;

type LinkKey = 'appstore' | 'live' | 'repo' | 'other';
const LINK_ORDER: LinkKey[] = ['live', 'appstore', 'repo', 'other'];
const links = LINK_ORDER.filter((k) => data.links?.[k]).map((k) => ({
  key: k,
  href: data.links![k] as string,
  label: (data.links![k] as string).includes('instagram.com') ? L('Instagram’da izle', 'Watch on Instagram') : t(locale, `link.${k}`),
}));
const hint = t(locale, 'social.opensNewTab');
// The Kur'an Reels project links its per-episode pages (revelation order).
const episodes = entry.id === 'kuran-reels' ? quranEpisodes : [];

const topic: ContactTopic =
  data.category === 'Content' ? 'video' : data.category === 'Web' && data.group === 'client' ? 'web' : data.category === 'Mobile' ? 'mobile' : 'general';

const url = canonicalHref(path, Astro.site!);
const workLd = creativeWorkJsonLd(
  { title: data.title, description: tagline, category: data.category, url, stack },
  Astro.site!,
);
const videoLd = data.videos.map((v) => ({
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: locale === 'tr' ? v.title_tr : v.title_en,
  description: tagline,
  thumbnailUrl: new URL(v.poster, Astro.site).toString(),
  contentUrl: new URL(v.src, Astro.site).toString(),
  uploadDate: '2026-11-12',
  creator: { '@id': `${new URL(Astro.site!).origin}/#person` },
  ...(v.url ? { url: v.url } : {}),
}));
const crumbs = breadcrumbJsonLd([
  { name: t(locale, 'nav.work'), url: canonicalHref(localizePath(locale, '/projects'), Astro.site!) },
  { name: data.title, url },
]);
---

<Base
  title={`${data.title} | ${L('Çalışmalar', 'Work')} | Ömer Yasir Önal`}
  description={metaDescription}
  path={path}
  lang={locale}
  ogImage={ogProjectPath(locale, entry.id)}
  ogType="article"
  contactTopic={topic}
>
  <script slot="head" type="application/ld+json" is:inline set:html={jsonLdScript(workLd)} />
  <script slot="head" type="application/ld+json" is:inline set:html={jsonLdScript(crumbs)} />
  {videoLd.length > 0 && <script slot="head" type="application/ld+json" is:inline set:html={jsonLdScript(videoLd)} />}
  <SiteHeader locale={locale} path={path} contactTopic={topic} />

  <main id="main">
    <article class="container-page max-w-4xl pb-20 pt-10 md:pb-24 md:pt-14">
      <nav aria-label="Breadcrumb" class="text-sm text-muted">
        <a href={localizePath(locale, '/projects')} class="hover:text-fg hover:underline">{t(locale, 'nav.work')}</a>
        <span aria-hidden="true" class="mx-1.5">/</span>
        <span aria-current="page" class="text-fg">{data.title}</span>
      </nav>

      <header class="mt-8 border-b border-border pb-10">
        <p class="label">{t(locale, `category.${data.category}`)} · {status}</p>
        <h1 class="h-display mt-3">{data.title}</h1>
        <p class="lead mt-4">{tagline}</p>
        {
          links.length > 0 && (
            <div class="mt-8 flex flex-wrap gap-3">
              {links.map((link, idx) => (
                <a
                  href={link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${link.label} (${hint})`}
                  class:list={['btn', idx === 0 ? 'btn-primary' : 'btn-secondary']}
                >
                  {link.label}
                  <Icon name="arrow-up-right" size={15} />
                </a>
              ))}
            </div>
          )
        }
      </header>

      {
        data.videos.length > 0 && (
          <div class:list={['mt-10 grid grid-cols-2 gap-4 sm:gap-6', data.videos.length === 4 ? 'lg:grid-cols-4' : 'lg:grid-cols-3']}>
            {data.videos.map((v) => (
              <figure>
                <div class="phone">
                  <div class="phone__screen">
                    <video
                      src={v.src}
                      poster={v.poster}
                      controls
                      playsinline
                      preload="none"
                      aria-label={locale === 'tr' ? v.title_tr : v.title_en}
                    />
                  </div>
                </div>
                <figcaption class="mt-3 flex flex-col items-start gap-1 text-sm">
                  <span class="font-medium text-fg">{locale === 'tr' ? v.title_tr : v.title_en}</span>
                  {v.url && (
                    <a href={v.url} target="_blank" rel="noopener noreferrer" class="link-arrow shrink-0" aria-label={`${L('Instagram’da izle', 'Watch on Instagram')} (${hint})`}>
                      <Icon name="instagram" size={15} /> Instagram
                    </a>
                  )}
                </figcaption>
              </figure>
            ))}
          </div>
        )
      }

      <ProjectCaseStudy entry={entry} locale={locale} showImage={data.videos.length === 0 || data.category !== 'Content'} />

      {
        episodes.length > 0 && (
          <section class="mt-12 border-t border-border pt-8" aria-labelledby="episodes-h">
            <h2 id="episodes-h" class="h-card">{L('Bölümler (nüzul sırasıyla)', 'Episodes (revelation order)')}</h2>
            <ol class="mt-4 divide-y divide-border border-y border-border" role="list">
              {episodes.map((e) => (
                <li>
                  <a href={localizePath(locale, `/kuran-reels/${e.slug}/`)} class="flex flex-wrap items-baseline gap-x-3 gap-y-1 py-3 text-sm hover:text-accent">
                    <span class="label w-36 shrink-0">{surahLabel(locale, e)} {e.range}</span>
                    <span class="font-medium">{locale === 'en' ? e.shortEn : e.shortTr}</span>
                  </a>
                </li>
              ))}
            </ol>
            <a href={localizePath(locale, '/kuran-reels/')} class="link-arrow mt-4">
              {L('Tüm bölümler', 'All episodes')}
              <Icon name="arrow" size={15} />
            </a>
          </section>
        )
      }

      <section class="mt-12 border-t border-border pt-8">
        <h2 class="label">{t(locale, 'project.stack')}</h2>
        <ul class="mt-4 flex flex-wrap gap-2" role="list">
          {stack.map((tech) => <li class="chip">{tech}</li>)}
        </ul>
      </section>

      <aside class="card mt-14 flex flex-col gap-5 p-6 sm:flex-row sm:items-center sm:justify-between sm:p-8">
        <div>
          <p class="h-card">{L('Benzer bir işe mi ihtiyacınız var?', 'Need something similar?')}</p>
          <p class="mt-1.5 text-sm text-muted">{L('Kısaca anlatın, kapsamı birlikte netleştirelim.', 'Tell me briefly and we can pin down the scope together.')}</p>
        </div>
        <WhatsAppButton locale={locale} topic={topic} location="project_detail" class="shrink-0" />
      </aside>
    </article>
  </main>

  <SiteFooter locale={locale} />
</Base>
