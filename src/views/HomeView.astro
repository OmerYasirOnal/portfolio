---
/**
 * HomeView - calm, client-first home page shared by / (tr) and /en/ (en).
 *
 * Flow: hero (intro, CTAs, verified facts, portrait) -> client strip ->
 * services -> selected work (A2 Reklam case, client projects, engineering) ->
 * client videos -> process -> about -> FAQ -> contact.
 *
 * All copy is server-rendered and readable with JS and motion off. The only
 * motion is the section fade-in ([data-reveal]) and in-view autoplay of the
 * muted reel previews (src/lib/motion.ts).
 */
import { Image, getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SectionHead from '../components/SectionHead.astro';
import ProjectCard from '../components/ProjectCard.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import ContactChannels from '../components/ContactChannels.astro';
import ContactForm from '../components/ContactForm.astro';
import Icon from '../components/Icon.astro';
import portrait from '../assets/omer-yasir-onal.jpg';
import { localizePath, pick, t, type Locale } from '../data/i18n';
import { profile } from '../data/profile';
import { serviceGroups, processSteps } from '../data/services';
import { reels, type Reel } from '../data/social';
import { personJsonLd, webSiteJsonLd, faqPageJsonLd, jsonLdScript } from '../lib/seo';
import { ogHomePath } from '../lib/og';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const L = (tr: string, en: string) => pick(locale, { tr, en });
const path = localizePath(locale, '/');
const origin = new URL(Astro.site!).origin;

const all = await getCollection('projects', (e) => !e.data.draft);
const bySlug = (slug: string) => all.find((e) => e.id === slug)!;
const clients = ['a2reklam', 'ozsaye', 'parladeniz'].map(bySlug);
const engineering = ['odak', 'unisum', 'akis'].map(bySlug);

const heroWidths = [360, 540, 720, 819];
const heroSizes = '(min-width: 1024px) 26rem, (min-width: 768px) 36vw, min(20rem, 90vw)';
const heroImg = await getImage({ src: portrait, widths: heroWidths, sizes: heroSizes });

const groupIcon = { 'web-software': 'code', 'ads-growth': 'megaphone', 'content-video': 'film' } as const;

const title = L(
  'Ömer Yasir Önal | Web Sitesi, Reklam, Sosyal Medya ve Video İçerik · Bilgisayar Mühendisi',
  'Ömer Yasir Önal | Websites, Ads, Social Media and Video Content · Computer Engineer',
);
const description = L(
  'Bilgisayar Mühendisi Ömer Yasir Önal: kurumsal web sitesi ve yazılım, Google Ads ve Meta (Instagram/Facebook) reklamları, sosyal medya hesap yönetimi, yapay zekâ destekli Reels ve video üretimi, SEO ve yapay zekâ aramalarında görünürlük. İstanbul.',
  'Computer Engineer Ömer Yasir Önal: business websites and software, Google Ads and Meta (Instagram/Facebook) ads, social media management, AI-assisted Reels and video, SEO and visibility in AI search. Istanbul.',
);

/* Verified facts only (see design spec). */
const facts = [
  { value: '3', text: L('yayındaki müşteri sitesi', 'live client websites') },
  { value: '2', text: L('App Store uygulaması', 'apps on the App Store') },
  { value: 'IEEE', text: L('SIU 2025 bildirisi', 'SIU 2025 paper') },
  { value: 'TÜBİTAK', text: L('2209-A araştırma projesi', '2209-A research project') },
];

/* A2 Reklam case: what was done, worded so it stays true over time. */
const a2Work = [
  {
    icon: 'code',
    title: L('Web sitesi', 'Website'),
    text: L('Astro ve Cloudflare ile üç dilli site, İstanbul ilçe sayfaları ve teknik SEO.', 'A three-language site on Astro and Cloudflare, Istanbul district pages and technical SEO.'),
  },
  {
    icon: 'chart',
    title: L('Ölçüm', 'Tracking'),
    text: L('Arama, WhatsApp ve form dönüşümlerinin ölçümü (Google Tag Manager ve Analytics).', 'Tracking calls, WhatsApp messages and form submissions (Google Tag Manager and Analytics).'),
  },
  {
    icon: 'google',
    title: 'Google Ads',
    text: L('Arama kampanyaları, bütçe ve arama terimi yönetimi.', 'Search campaigns, budget and search-term management.'),
  },
  {
    icon: 'film',
    title: L('Video içerik', 'Video content'),
    text: L('Gerçek proje hikâyeleri, yapay zekâ ile üretilen sahneler, sanal sunucu ve logo animasyonu.', 'Real project stories, AI-generated scenes, a virtual presenter and a logo animation.'),
  },
] as const;

/* Client reels only (no personal account), brand names instead of handles. */
const brandName: Partial<Record<Reel['account'], string>> = {
  a2_reklam: 'A2 Reklam',
  psikologsacidesahin: 'Öz & Saye Psikoloji',
};
const reelOrder = ['a2-aksaray', 'sacide-kaygi', 'a2-3hata', 'a2-sunucu', 'a2-logo'];
const clientReels = reels
  .filter((r) => r.account === 'a2_reklam' || r.account === 'psikologsacidesahin')
  .sort((a, b) => {
    const ia = reelOrder.indexOf(a.id);
    const ib = reelOrder.indexOf(b.id);
    return (ia === -1 ? 99 : ia) - (ib === -1 ? 99 : ib);
  })
  .slice(0, 4);

const faqs = [
  {
    q: L('Ömer Yasir Önal hangi hizmetleri veriyor?', 'What services does Ömer Yasir Önal offer?'),
    a: L(
      'Kurumsal web sitesi, yönetim paneli ve mobil uygulama geliştirme; Google Ads ve Meta (Instagram / Facebook) reklam yönetimi; SEO ve yapay zekâ aramalarında görünürlük; sosyal medya hesap yönetimi ve yapay zekâ destekli kısa video, gönderi ve sanal sunucu üretimi. İstanbul merkezli, Türkiye geneline uzaktan.',
      'Business websites, admin panels and mobile apps; Google Ads and Meta (Instagram / Facebook) ads management; SEO and visibility in AI search; social media management and AI-assisted short videos, posts and virtual presenters. Based in Istanbul, working remotely across Türkiye.',
    ),
  },
  {
    q: L('Sosyal medya hesabımı yönetebilir misiniz?', 'Can you run my social media account?'),
    a: L(
      'Evet. Aylık içerik takvimi, Reels ve gönderi üretimi, açıklama ve harekete geçirici mesajlar, profil düzeni ve Meta reklamlarıyla birlikte planlama yapıyorum. Her içerik yayından önce onayınıza gelir; takipçi satın alma ya da etkileşim garantisi yoktur.',
      'Yes. I run a monthly content calendar, produce Reels and posts, write captions and calls to action, tidy the profile and plan it together with Meta ads. Every piece is approved by you first; no bought followers or engagement guarantees.',
    ),
  },
  {
    q: L('Yapay zekâ ile üretilen videolar profesyonel görünür mü?', 'Do AI-made videos look professional?'),
    a: L(
      'Senaryo, kurgu, seslendirme ve son kontrol insan elinde; yapay zekâ görüntü ve sahne üretiminde araç olarak kullanılıyor. A2 Reklam için hazırladığım ve Instagram’da yayınlanan Reels bu çalışmanın örnekleri. Platform kurallarına göre yapay zekâ etiketi kullanılır.',
      'Script, editing, voice and final review are done by a person; AI is a tool for visuals and scenes. The Reels I made for A2 Reklam, published on Instagram, are examples of this work. AI labels are applied per platform rules.',
    ),
  },
  {
    q: L('Fiyatlar nasıl belirleniyor?', 'How is pricing set?'),
    a: L(
      'Genel işler kapsama göre fiyatlanır; bazı sektör sayfalarında hazır paketler var. Reklam bütçesi yönetim ücretinden ayrıdır ve doğrudan Google’a veya Meta’ya ödenir. Teklif için WhatsApp’tan işinizi kısaca anlatmanız yeterli.',
      'General work is priced by scope; some industry pages have ready-made packages. Ad spend is separate from the management fee and is paid directly to Google or Meta. For a quote, a short WhatsApp message about your business is enough.',
    ),
  },
];

const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': `${origin}/#service`,
  name: L('Ömer Yasir Önal · Web, Reklam ve Video İçerik', 'Ömer Yasir Önal · Web, Ads and Video Content'),
  url: `${origin}${path}`,
  logo: `${origin}/brand/logo-512.png`,
  image: `${origin}/brand/logo-512.png`,
  founder: { '@id': `${origin}/#person` },
  areaServed: [{ '@type': 'City', name: 'Istanbul' }, { '@type': 'Country', name: 'Türkiye' }],
  address: { '@type': 'PostalAddress', addressLocality: 'Istanbul', addressCountry: 'TR' },
  telephone: `+${profile.whatsapp}`,
  email: profile.email,
  sameAs: [profile.instagram.url, profile.links.linkedin.url, profile.links.github.url].filter(Boolean),
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: L('Hizmetler', 'Services'),
    itemListElement: serviceGroups.flatMap((g) =>
      g.services.map((s) => ({
        '@type': 'Offer',
        itemOffered: { '@type': 'Service', name: pick(locale, s.name), description: pick(locale, s.summary) },
      })),
    ),
  },
};
---

<Base title={title} description={description} path={path} lang={locale} ogImage={ogHomePath(locale)}>
  <link slot="head" rel="preload" as="image" imagesrcset={heroImg.srcSet.attribute} imagesizes={heroSizes} media="(min-width: 768px)" fetchpriority="high" />
  <script slot="head" type="application/ld+json" is:inline set:html={jsonLdScript(personJsonLd(Astro.site, locale))} />
  <script slot="head" type="application/ld+json" is:inline set:html={jsonLdScript(webSiteJsonLd(Astro.site))} />
  <script slot="head" type="application/ld+json" is:inline set:html={jsonLdScript(serviceLd)} />
  <script slot="head" type="application/ld+json" is:inline set:html={jsonLdScript(faqPageJsonLd(faqs.map((f) => ({ question: f.q, answer: f.a }))))} />

  <SiteHeader locale={locale} path={path} />

  <main id="main">
    {/* ---------- Hero ---------- */}
    <section class="bg-bg" aria-labelledby="hero-title">
      <div class="container-page grid items-center gap-8 pb-16 pt-12 md:grid-cols-[1.4fr_1fr] md:gap-14 md:pb-20 md:pt-20">
        <div>
          <p class="eyebrow">{L('Bilgisayar Mühendisi · İstanbul', 'Computer Engineer · Istanbul')}</p>
          <h1 id="hero-title" class="h-display mt-4 max-w-2xl">
            {L('İşletmeniz için web sitesi, reklam yönetimi ve video içerik.', 'Websites, ad management and video content for your business.')}
          </h1>
          <p class="lead mt-6">
            {L(
              'Serbest çalışan bir bilgisayar mühendisiyim. Web sitenizi kuruyor, Google ve Instagram reklamlarınızı yönetiyor, sosyal medyanız için kısa videolar hazırlıyorum. İşi baştan sona kendim yapıyorum; doğrudan benimle görüşürsünüz.',
              'I’m a freelance computer engineer. I build your website, manage your Google and Instagram ads and make short videos for your social media. I do the work myself, so you deal directly with me.',
            )}
          </p>

          <div class="mt-8 flex flex-wrap items-center gap-3">
            <WhatsAppButton locale={locale} location="hero" size="lg" />
            <a href={localizePath(locale, '/services')} class="btn btn-secondary btn-lg">
              {L('Hizmetleri İnceleyin', 'View services')}
            </a>
          </div>

          <ul class="mt-12 grid max-w-2xl grid-cols-2 gap-px overflow-hidden rounded-xl border border-border bg-border sm:grid-cols-4" role="list">
            {facts.map((f) => (
              <li class="bg-bg px-4 py-4">
                <p class="text-xl font-semibold tracking-tight text-fg">{f.value}</p>
                <p class="mt-1 text-xs leading-snug text-muted">{f.text}</p>
              </li>
            ))}
          </ul>
        </div>

        <figure class="mx-auto w-full max-w-[13rem] overflow-hidden rounded-xl border border-border bg-surface md:max-w-none">
          <Image
            src={portrait}
            alt={L('Ömer Yasir Önal, Bilgisayar Mühendisi', 'Ömer Yasir Önal, Computer Engineer')}
            widths={heroWidths}
            sizes={heroSizes}
            loading="eager"
            class="aspect-[4/5] h-full w-full object-cover object-top"
          />
        </figure>
      </div>

      {/* Client strip: text only */}
      <div class="border-t border-border">
        <div class="container-page flex flex-col gap-2 py-6 sm:flex-row sm:items-center sm:gap-6">
          <p class="label shrink-0">{L('Yayındaki işlerden', 'From live work')}</p>
          <ul class="flex flex-col gap-1 text-[0.95rem] font-medium text-fg sm:flex-row sm:flex-wrap sm:items-center sm:gap-x-3 sm:gap-y-1" role="list">
            {clients.map((c, i) => (
              <li class="flex items-center gap-3">
                {i > 0 && <span class="hidden text-muted sm:inline" aria-hidden="true">·</span>}
                <a href={localizePath(locale, `/projects/${c.id}`)} class="hover:text-accent hover:underline">{c.data.title}</a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    {/* ---------- Services ---------- */}
    <section id="services" class="section section-alt scroll-mt-20">
      <div class="container-page">
        <SectionHead
          label={L('Hizmetler', 'Services')}
          title={L('Üç hizmet alanı', 'Three service areas')}
          intro={L(
            'Web sitesi, reklam ve içerik işlerini ayrı ayrı ya da birlikte üstlenebilirim.',
            'I can take on websites, ads and content separately or together.',
          )}
          link={{ href: localizePath(locale, '/services'), text: L('Tüm hizmetler', 'All services') }}
        />
        <ul class="grid gap-5 md:grid-cols-3" role="list" data-reveal>
          {
            serviceGroups.map((g) => (
              <li>
                <a href={localizePath(locale, `/services/${g.id}`)} class="card card-link flex h-full flex-col p-6 sm:p-7">
                  <span class="grid h-11 w-11 place-items-center rounded-lg bg-accent-soft text-accent">
                    <Icon name={groupIcon[g.id]} size={20} />
                  </span>
                  <h3 class="h-card mt-5">{pick(locale, g.short)}</h3>
                  <p class="mt-2 text-[0.95rem] leading-relaxed text-muted">{pick(locale, g.cardSummary)}</p>
                  <ul class="mt-5 space-y-2 border-t border-border pt-5 text-sm text-fg" role="list">
                    {g.services.slice(0, 6).map((s) => (
                      <li class="flex items-start gap-2">
                        <Icon name="check" size={15} class="mt-0.5 shrink-0 text-accent" />
                        {pick(locale, s.name)}
                      </li>
                    ))}
                  </ul>
                  <span class="link-arrow mt-auto pt-6">
                    {L('Detaylar', 'Details')}
                    <Icon name="arrow" size={15} />
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    {/* ---------- Selected work ---------- */}
    <section id="work" class="section scroll-mt-20">
      <div class="container-page">
        <SectionHead
          label={L('Çalışmalar', 'Work')}
          title={L('Seçili çalışmalar', 'Selected work')}
          intro={L(
            'Müşteriler için kurduğum siteler, yönettiğim reklamlar ve hazırladığım içerikler.',
            'Websites I built, ads I manage and content I made for clients.',
          )}
          link={{ href: localizePath(locale, '/projects'), text: L('Tüm çalışmalar', 'All work') }}
        />

        {/* Featured case: A2 Reklam */}
        <article class="card grid gap-10 p-6 sm:p-8 lg:grid-cols-[1fr_1.1fr] lg:gap-14" aria-labelledby="a2-title" data-reveal>
          <div>
            <p class="label">{L('Tabela firması · İstanbul', 'Signage company · Istanbul')}</p>
            <h3 id="a2-title" class="h-section mt-3">{L('Örnek çalışma: A2 Reklam', 'Case study: A2 Reklam')}</h3>
            <p class="mt-4 text-[1.02rem] leading-relaxed text-muted">
              {L(
                'Bir tabela firması için web sitesi, ölçüm, Google Ads ve video içerik bir arada.',
                'Website, tracking, Google Ads and video content for a signage company.',
              )}
            </p>
            <div class="mt-7 flex flex-wrap gap-3">
              <a href={localizePath(locale, '/projects/a2reklam-video')} class="btn btn-primary">
                {L('Çalışmayı inceleyin', 'View the case')} <Icon name="arrow" size={15} />
              </a>
              <a href="https://a2reklam.com" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
                a2reklam.com <Icon name="arrow-up-right" size={14} />
              </a>
            </div>
          </div>

          <ul class="divide-y divide-border border-y border-border" role="list">
            {
              a2Work.map((s) => (
                <li class="flex gap-4 py-4">
                  <span class="grid h-9 w-9 shrink-0 place-items-center rounded-lg bg-accent-soft text-accent">
                    <Icon name={s.icon} size={18} />
                  </span>
                  <div class="min-w-0">
                    <h4 class="font-semibold text-fg">{s.title}</h4>
                    <p class="mt-1 text-[0.95rem] leading-relaxed text-muted">{s.text}</p>
                  </div>
                </li>
              ))
            }
          </ul>
        </article>

        <div class="mt-6 grid gap-6 md:grid-cols-2 lg:grid-cols-3" data-reveal>
          {clients.map((entry) => (
            <ProjectCard locale={locale} entry={entry} size="md" eager={false} />
          ))}
        </div>

        <div class="card mt-6 p-6 sm:p-8" data-reveal>
          <div class="grid gap-6 md:grid-cols-[16rem_1fr]">
            <div>
              <p class="label">{L('Mühendislik tarafı', 'The engineering side')}</p>
              <p class="mt-3 text-[0.95rem] leading-relaxed text-muted">
                {L('Müşteri işlerinin arkasındaki teknik birikim: kendi ürünlerim ve yapay zekâ çalışmalarım.', 'The technical depth behind the client work: my own products and AI projects.')}
              </p>
            </div>
            <ul class="-my-4 divide-y divide-border" role="list">
              {
                engineering.map((e) => (
                  <li>
                    <a href={localizePath(locale, `/projects/${e.id}`)} class="group grid gap-1 py-4 sm:grid-cols-[9rem_1fr_auto] sm:items-baseline sm:gap-5">
                      <span class="font-semibold text-fg group-hover:text-accent">{e.data.title}</span>
                      <span class="text-sm text-muted">{locale === 'tr' ? e.data.status_tr : e.data.status_en}</span>
                      <Icon name="arrow" size={15} class="hidden text-accent sm:block" />
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </section>

    {/* ---------- Client videos ---------- */}
    <section id="reels" class="section scroll-mt-20 border-t border-border" aria-labelledby="reels-title">
      <div class="container-page">
        <SectionHead
          id="reels-title"
          label={L('Video içerik', 'Video content')}
          title={L('Sosyal medya videoları', 'Social media videos')}
          intro={L(
            'Müşterilerim için hazırladığım kısa videolardan örnekler. Senaryo, seslendirme ve kurgu bende; görsel üretimde yapay zekâyı araç olarak kullanıyorum.',
            'A few of the short videos I made for clients. Script, voice-over and editing are mine; I use AI as a tool for the visuals.',
          )}
          link={{ href: localizePath(locale, '/projects/a2reklam-video'), text: L('Video çalışmasını inceleyin', 'See the video work') }}
        />

        <ul class="grid grid-cols-2 gap-4 sm:gap-6 lg:grid-cols-4" role="list" data-reveal>
          {
            clientReels.map((r) => {
              const brand = brandName[r.account] ?? r.account;
              return (
                <li>
                  <a
                    href={r.ready && r.project ? localizePath(locale, `/projects/${r.project}`) : r.url}
                    target={r.ready ? undefined : '_blank'}
                    rel={r.ready ? undefined : 'noopener noreferrer'}
                    data-track={r.ready ? undefined : 'instagram_click'}
                    data-track-location={`reel_${r.id}`}
                    class="group block"
                    aria-label={r.ready ? `${brand}: ${pick(locale, r.title)}` : `${brand}: ${pick(locale, r.title)} - Instagram (${t(locale, 'social.opensNewTab')})`}
                  >
                    <span class="phone">
                      <span class="phone__screen">
                        <video data-autoplay muted loop playsinline preload="none" poster={r.poster} src={r.preview}></video>
                        {r.ready && (
                          <span class="status absolute left-2 top-2">{L('Yayına hazır', 'Ready to post')}</span>
                        )}
                      </span>
                    </span>
                    <span class="label mt-3 block">{brand}</span>
                    <span class="mt-1 block text-sm font-medium leading-snug text-fg group-hover:text-accent">{pick(locale, r.title)}</span>
                  </a>
                </li>
              );
            })
          }
        </ul>

        <div class="mt-10">
          <WhatsAppButton locale={locale} topic="video" location="reels_stage" variant="secondary" label={L('İçerik teklifi al', 'Get a content quote')} />
        </div>
      </div>
    </section>

    {/* ---------- Process ---------- */}
    <section class="section section-alt">
      <div class="container-page">
        <SectionHead label={L('Süreç', 'Process')} title={L('Çalışma süreci', 'How I work')} />
        <ol class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4" role="list" data-reveal>
          {
            processSteps.map((s, i) => (
              <li class="border-t border-border pt-5">
                <span class="grid h-8 w-8 place-items-center rounded-full bg-accent-soft text-sm font-semibold text-accent" aria-hidden="true">{i + 1}</span>
                <h3 class="h-card mt-4">{pick(locale, s.title)}</h3>
                <p class="mt-2 text-[0.95rem] leading-relaxed text-muted">{pick(locale, s.description)}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    {/* ---------- About ---------- */}
    <section id="about" class="section scroll-mt-20">
      <div class="container-page grid gap-10 md:grid-cols-2 md:gap-16">
        <div>
          <p class="eyebrow">{L('Hakkımda', 'About')}</p>
          <h2 class="h-section mt-3">{L('Bilgisayar mühendisiyim', 'A computer engineer by training')}</h2>
          <p class="lead mt-5">
            {
              L(
                'Fatih Sultan Mehmet Vakıf Üniversitesi Bilgisayar Mühendisliği mezunuyum. App Store’da yayında iki uygulamam, TÜBİTAK destekli bir yapay zekâ araştırmam ve IEEE’de yayımlanmış bir bildirim var. Müşteri işlerine de aynı disiplinle yaklaşıyorum: ölçmeden karar vermiyorum, söz veremeyeceğim sonucu vaat etmiyorum.',
                'I studied Computer Engineering at Fatih Sultan Mehmet Vakıf University. I have two apps on the App Store, a TÜBİTAK-funded AI research project and a paper published by IEEE. I bring the same discipline to client work: I don’t decide without measuring, and I don’t promise results I can’t control.',
              )
            }
          </p>
          <div class="mt-7 flex flex-wrap gap-x-6 gap-y-3">
            <a href={localizePath(locale, '/about')} class="link-arrow">{L('Daha fazlası', 'More about me')} <Icon name="arrow" size={15} /></a>
            <a href={localizePath(locale, '/cv')} class="link-arrow">{L('Özgeçmiş (CV)', 'CV')} <Icon name="arrow" size={15} /></a>
          </div>
        </div>
        <dl class="grid grid-cols-1 gap-px self-start overflow-hidden rounded-xl border border-border bg-border sm:grid-cols-2" data-reveal>
          {
            [
              [L('Eğitim', 'Education'), L('Bilgisayar Mühendisliği, FSMVÜ (2026)', 'B.Sc. Computer Engineering, FSMVU (2026)')],
              [L('Araştırma', 'Research'), L('TÜBİTAK 2209-A proje yürütücüsü', 'TÜBİTAK 2209-A project lead')],
              [L('Yayın', 'Publication'), L('IEEE SIU 2025, ortak yazar', 'IEEE SIU 2025, co-author')],
              [L('Ürünler', 'Products'), L('Odak ve UniSum, App Store', 'Odak and UniSum, App Store')],
            ].map(([k, v]) => (
              <div class="bg-card p-5 sm:p-6">
                <dt class="label">{k}</dt>
                <dd class="mt-2 text-[0.95rem] font-medium text-fg">{v}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    {/* ---------- FAQ (also FAQPage JSON-LD for search / answer engines) ---------- */}
    <section id="faq" class="section border-t border-border" aria-labelledby="faq-title">
      <div class="container-page"><div class="max-w-3xl">
        <h2 id="faq-title" class="h-section">{L('Sık sorulan sorular', 'Frequently asked questions')}</h2>
        <div class="mt-8 divide-y divide-border border-y border-border" data-reveal>
          {
            faqs.map((f, i) => (
              <details class="group py-5" open={i === 0}>
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-[1.05rem] font-semibold text-fg">
                  {f.q}
                  <span class="shrink-0 text-xl leading-none text-accent transition-transform group-open:rotate-45" aria-hidden="true">+</span>
                </summary>
                <p class="mt-3 max-w-3xl text-[0.98rem] leading-relaxed text-muted">{f.a}</p>
              </details>
            ))
          }
        </div>
      </div></div>
    </section>

    {/* ---------- Contact ---------- */}
    <section id="contact" class="section section-alt scroll-mt-20">
      <div class="container-page grid gap-12 md:grid-cols-[1fr_1.1fr] md:gap-16">
        <div>
          <p class="eyebrow">{L('İletişim', 'Contact')}</p>
          <h2 class="h-section mt-3">{L('Projenizi konuşalım', 'Let’s talk about your project')}</h2>
          <p class="lead mt-4 max-w-md">
            {L('En hızlı yol WhatsApp. Yazmayı tercih ederseniz e-posta ya da kısa form da olur.', 'WhatsApp is the fastest way. If you prefer writing, email or the short form work too.')}
          </p>
          <div class="mt-8">
            <ContactChannels locale={locale} location="home_contact" tone="light" />
          </div>
        </div>
        <div class="card p-6 sm:p-8">
          <h3 class="h-card">{L('Kısa teklif formu', 'Short quote form')}</h3>
          <div class="mt-5"><ContactForm locale={locale} location="home" /></div>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter locale={locale} hideCta flush />
</Base>
