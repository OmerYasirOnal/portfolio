---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import { t, localizePath, type Locale } from '../../../data/i18n';
import { ogProjectPath } from '../../../lib/og';

// Emit one TR page per non-draft project. `entry.id` is the markdown filename
// (e.g. "akis") and becomes the URL slug; Astro prefixes `/tr/projects/`.
export async function getStaticPaths() {
  const projects = await getCollection('projects', (e) => !e.data.draft);
  return projects.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const locale: Locale = 'tr';
const { entry } = Astro.props;
const { data } = entry;
const path = localizePath(locale, `/projects/${entry.id}`);

const tagline = data.tagline_tr;
const status = data.status_tr;

// External destinations in display order, each mapped to its i18n label.
type LinkKey = 'repo' | 'live' | 'appstore' | 'other';
const LINK_ORDER: LinkKey[] = ['repo', 'live', 'appstore', 'other'];
const links = LINK_ORDER.filter((k) => data.links?.[k]).map((k) => ({
  key: k,
  href: data.links![k] as string,
  label: t(locale, `link.${k}`),
}));
const hint = t(locale, 'social.opensNewTab');

// The markdown body is English-only. For the TR mirror we build the case study
// from the localized `_tr` frontmatter fields so /tr never ships English copy.
const problem = data.problem_tr;
const whatIDid = data.what_i_did_tr;
const highlights = data.highlights_tr;
---

<Base
  title={`${data.title} — Ömer Yasir Önal`}
  description={tagline}
  path={path}
  lang={locale}
  ogImage={ogProjectPath(locale, entry.id)}
>
  <SiteHeader locale={locale} path={path} />

  <main id="main">
    <article class="mx-auto max-w-3xl px-6 pb-20 pt-12">
      {/* breadcrumb back to the projects index */}
      <a
        href={localizePath(locale, '/projects')}
        class="inline-flex items-center gap-1.5 font-mono text-xs text-muted transition-colors hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      >
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="m15 18-6-6 6-6"></path>
        </svg>
        {t(locale, 'projects.backToAll')}
      </a>

      <header class="mt-6 border-b border-border/60 pb-8">
        <p class="font-mono text-[0.7rem] uppercase tracking-widest text-muted">
          <span class="text-accent/70">/</span>{data.category}
        </p>

        <h1 class="mt-3 text-3xl font-bold tracking-tight text-fg sm:text-4xl">
          {data.title}
        </h1>

        <p class="mt-3 text-lg leading-relaxed text-muted">{tagline}</p>

        {/* status pill */}
        <p
          class="mt-5 inline-flex w-fit items-center gap-1.5 rounded-full border border-border bg-bg/60 px-2.5 py-0.5 font-mono text-[0.7rem] text-muted"
        >
          <span class="h-1.5 w-1.5 rounded-full bg-accent/70" aria-hidden="true"></span>
          {status}
        </p>

        {/* stack chips */}
        <ul class="mt-5 flex flex-wrap gap-1.5" role="list" aria-label={t(locale, 'project.stack')}>
          {
            data.stack.map((tech) => (
              <li class="rounded border border-border/70 px-1.5 py-0.5 font-mono text-[0.7rem] text-muted">
                {tech}
              </li>
            ))
          }
        </ul>

        {/* external links */}
        {
          links.length > 0 && (
            <div class="mt-6 flex flex-wrap gap-2">
              {links.map((link) => (
                <a
                  href={link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${link.label} (${hint})`}
                  class="inline-flex items-center gap-1.5 rounded-md border border-border px-3 py-1.5 font-mono text-xs text-fg transition-colors hover:border-accent hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
                >
                  {link.label}
                  <svg
                    width="12"
                    height="12"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M15 3h6v6" />
                    <path d="M10 14 21 3" />
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                  </svg>
                </a>
              ))}
            </div>
          )
        }
      </header>

      {/* Localized case study built from the `_tr` frontmatter (the markdown
          body is English-only, so it is not rendered on the TR mirror). */}
      <div class="prose mt-10">
        {
          problem && (
            <>
              <h2>{t(locale, 'project.problem')}</h2>
              <p>{problem}</p>
            </>
          )
        }
        {
          whatIDid && (
            <>
              <h2>{t(locale, 'project.whatIDid')}</h2>
              <p>{whatIDid}</p>
            </>
          )
        }
        {
          highlights.length > 0 && (
            <>
              <h2>{t(locale, 'project.highlights')}</h2>
              <ul>
                {highlights.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </>
          )
        }
      </div>
    </article>
  </main>

  <SiteFooter locale={locale} />
</Base>

<style>
  /* Scoped typographic styles for the rendered markdown case study — no
     typography plugin; stays within the dev-tools-minimal tokens. */
  .prose {
    color: var(--color-muted);
    line-height: 1.75;
  }
  .prose :global(h2) {
    color: var(--color-fg);
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
  }
  .prose :global(h2:first-child) {
    margin-top: 0;
  }
  .prose :global(h3) {
    color: var(--color-fg);
    font-size: 1.05rem;
    font-weight: 600;
    margin-top: 2rem;
    margin-bottom: 0.5rem;
  }
  .prose :global(p) {
    margin-top: 1rem;
    margin-bottom: 1rem;
  }
  .prose :global(ul),
  .prose :global(ol) {
    margin-top: 1rem;
    margin-bottom: 1rem;
    padding-left: 1.25rem;
    list-style-position: outside;
  }
  .prose :global(ul) {
    list-style-type: disc;
  }
  .prose :global(ol) {
    list-style-type: decimal;
  }
  .prose :global(li) {
    margin-top: 0.375rem;
  }
  .prose :global(li::marker) {
    color: var(--color-accent);
  }
  .prose :global(strong) {
    color: var(--color-fg);
    font-weight: 600;
  }
  .prose :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .prose :global(a:hover) {
    text-decoration: none;
  }
  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.85em;
    color: var(--color-fg);
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: 0.25rem;
    padding: 0.1rem 0.3rem;
  }
  .prose :global(pre) {
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    padding: 1rem;
    overflow-x: auto;
    margin-top: 1.25rem;
    margin-bottom: 1.25rem;
  }
  .prose :global(pre code) {
    background: transparent;
    border: 0;
    padding: 0;
  }
  .prose :global(blockquote) {
    border-left: 2px solid var(--color-accent);
    padding-left: 1rem;
    color: var(--color-muted);
    font-style: italic;
  }
</style>
