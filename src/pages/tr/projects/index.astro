---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import ProjectGrid from '../../../components/ProjectGrid.astro';
import { t, localizePath, type Locale } from '../../../data/i18n';
import { ogProjectsPath } from '../../../lib/og';
import { breadcrumbJsonLd, canonicalHref, jsonLdScript } from '../../../lib/seo';

const locale: Locale = 'tr';
const path = '/tr/projects';

const breadcrumbLd = breadcrumbJsonLd([
  { name: t(locale, 'nav.work'), url: canonicalHref(localizePath(locale, '/projects'), Astro.site!) },
]);

// All non-draft projects, split into the curated featured set and the rest.
// The content collection stays the single source of truth; ordering is by
// each entry's `order` field.
const all = (await getCollection('projects', (e) => !e.data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
const featured = all.filter((e) => e.data.featured);
const more = all.filter((e) => !e.data.featured);
---

<Base
  title={`${t(locale, 'projects.title')} — Ömer Yasir Önal`}
  description={t(locale, 'seo.projects.description')}
  path={path}
  lang={locale}
  ogImage={ogProjectsPath(locale)}
>
  <script slot="head" type="application/ld+json" is:inline set:html={jsonLdScript(breadcrumbLd)} />

  <SiteHeader locale={locale} path={path} />

  <main id="main">
    <section class="mx-auto max-w-5xl px-6 pb-8 pt-16">
      <p class="font-mono text-sm text-accent">
        <span class="text-accent/70">/</span>{t(locale, 'nav.work').toLowerCase()}
      </p>
      <h1 class="mt-3 text-3xl font-bold tracking-tight text-fg sm:text-4xl">
        {t(locale, 'projects.title')}
      </h1>
      <p class="mt-4 max-w-2xl text-balance text-base leading-relaxed text-muted">
        {t(locale, 'projects.intro')}
      </p>
    </section>

    {
      featured.length > 0 && (
        <section class="mx-auto max-w-5xl px-6 py-8">
          <header class="mb-8 flex items-baseline gap-3">
            <span class="font-mono text-sm text-accent" aria-hidden="true">
              01
            </span>
            <h2 class="text-2xl font-bold tracking-tight text-fg sm:text-3xl">
              {t(locale, 'section.selectedWork')}
            </h2>
            <span class="h-px flex-1 bg-border" aria-hidden="true" />
          </header>
          <ProjectGrid locale={locale} items={featured} columns={3} />
        </section>
      )
    }

    {
      more.length > 0 && (
        <section class="mx-auto max-w-5xl px-6 py-8 pb-20">
          <header class="mb-8 flex items-baseline gap-3">
            <span class="font-mono text-sm text-accent" aria-hidden="true">
              02
            </span>
            <h2 class="text-2xl font-bold tracking-tight text-fg sm:text-3xl">
              {t(locale, 'section.more')}
            </h2>
            <span class="h-px flex-1 bg-border" aria-hidden="true" />
          </header>
          <ProjectGrid locale={locale} items={more} columns={3} />
        </section>
      )
    }
  </main>

  <SiteFooter locale={locale} />
</Base>
