---
import { getCollection } from 'astro:content';
import ProjectDetailView from '../../views/ProjectDetailView.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects', (e) => !e.data.draft);
  return projects.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
---

<ProjectDetailView locale="tr" entry={entry} />
