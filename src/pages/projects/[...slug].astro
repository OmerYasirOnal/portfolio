---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import ProjectCaseStudy from '../../components/ProjectCaseStudy.astro';
import { t, localizePath, type Locale } from '../../data/i18n';
import { ogProjectPath } from '../../lib/og';
import { creativeWorkJsonLd, breadcrumbJsonLd, canonicalHref, jsonLdScript } from '../../lib/seo';

export async function getStaticPaths() {
  const projects = await getCollection('projects', (e) => !e.data.draft);
  return projects.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const locale: Locale = 'tr';
const { entry } = Astro.props;
const { data } = entry;
const path = localizePath(locale, `/projects/${entry.id}`);

const tagline = data.tagline_tr;
const status = data.status_tr;

type LinkKey = 'appstore' | 'live' | 'repo' | 'other';
const LINK_ORDER: LinkKey[] = ['appstore', 'live', 'repo', 'other'];
const links = LINK_ORDER.filter((k) => data.links?.[k]).map((k) => ({
  key: k,
  href: data.links![k] as string,
  label: t(locale, `link.${k}`),
}));
const hint = t(locale, 'social.opensNewTab');

const url = canonicalHref(path, Astro.site!);
const workLd = creativeWorkJsonLd(
  { title: data.title, description: tagline, category: data.category, url, stack: data.stack },
  Astro.site!,
);
const breadcrumbLd = breadcrumbJsonLd([
  { name: t(locale, 'projects.title'), url: canonicalHref(localizePath(locale, '/projects'), Astro.site!) },
  { name: data.title, url },
]);
---

<Base
  title={`${data.title} | Ömer Yasir Önal`}
  description={tagline}
  path={path}
  lang={locale}
  ogImage={ogProjectPath(locale, entry.id)}
  ogType="article"
>
  <script slot="head" type="application/ld+json" is:inline set:html={jsonLdScript(workLd)} />
  <script slot="head" type="application/ld+json" is:inline set:html={jsonLdScript(breadcrumbLd)} />

  <SiteHeader locale={locale} path={path} />

  <main id="main">
    <article class="mx-auto max-w-4xl px-6 pb-20 pt-12" data-reveal>
      <a
        href={localizePath(locale, '/projects')}
        class="inline-flex items-center gap-2 rounded-full border border-accent/25 bg-card/80 px-4 py-2 text-xs font-semibold text-muted shadow-2xs backdrop-blur-md transition-all hover:border-accent hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      >
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="m15 18-6-6 6-6"></path>
        </svg>
        {t(locale, 'projects.backToAll')}
      </a>

      <header class="mt-6 border-b border-accent/20 pb-8">
        <div class="flex flex-wrap items-center gap-3">
          <p class="inline-flex items-center gap-2 rounded-full border border-accent/25 bg-accent/8 px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-accent">
            <span class="h-1.5 w-1.5 rounded-full bg-accent" aria-hidden="true"></span>
            {t(locale, `category.${data.category}`)}
          </p>
          <span class="inline-flex items-center gap-1.5 rounded-full border border-accent/25 bg-card/80 px-3 py-1 text-xs font-semibold text-muted">
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-500" aria-hidden="true"></span>
            {status}
          </span>
        </div>

        <h1 class="mt-4 text-3xl font-extrabold tracking-tight text-fg sm:text-5xl">
          {data.title}
        </h1>

        <p class="mt-3.5 text-lg leading-relaxed text-muted sm:text-xl">{tagline}</p>

        <ul class="mt-6 flex flex-wrap gap-2" role="list" aria-label={t(locale, 'project.stack')}>
          {
            data.stack.map((tech) => (
              <li class="rounded-full border border-accent/20 bg-bg/80 px-3.5 py-1.5 text-xs font-semibold text-muted">
                {tech}
              </li>
            ))
          }
        </ul>

        {
          links.length > 0 && (
            <div class="mt-7 flex flex-wrap gap-3">
              {links.map((link, idx) => (
                <a
                  href={link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${link.label} (${hint})`}
                  class:list={[
                    'inline-flex items-center gap-2 rounded-full px-5 py-3 text-sm font-bold transition-all hover:-translate-y-0.5 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent',
                    idx === 0
                      ? 'bg-gradient-to-r from-emerald-600 via-emerald-500 to-teal-600 text-white shadow-md shadow-emerald-600/25 hover:shadow-lg'
                      : 'border border-accent/25 bg-card/80 text-fg hover:border-accent hover:text-accent',
                  ]}
                >
                  {link.label}
                  <span aria-hidden="true">↗</span>
                </a>
              ))}
            </div>
          )
        }
      </header>

      <ProjectCaseStudy entry={entry} locale={locale} />
    </article>
  </main>

  <SiteFooter locale={locale} />
</Base>
