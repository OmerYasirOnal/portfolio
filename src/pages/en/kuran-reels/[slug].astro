---
import QuranEpisodeView from '../../../views/QuranEpisodeView.astro';
import { quranEpisodes, type QuranEpisode } from '../../../data/quran-reels';

export function getStaticPaths() {
  return quranEpisodes.map((episode) => ({ params: { slug: episode.slug }, props: { episode } }));
}

const { episode } = Astro.props as { episode: QuranEpisode };
---

<QuranEpisodeView locale="en" episode={episode} />
