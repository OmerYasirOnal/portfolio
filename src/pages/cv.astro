---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { profile } from '../data/profile';
import { t, localizePath, type Locale } from '../data/i18n';
import { ogCvPath } from '../lib/og';
import { breadcrumbJsonLd, canonicalHref, jsonLdScript } from '../lib/seo';

const locale: Locale = 'tr';
const path = '/cv';
const mailto = `mailto:${profile.email}`;

const breadcrumbLd = breadcrumbJsonLd([
  { name: t(locale, 'cv.title'), url: canonicalHref(localizePath(locale, '/cv'), Astro.site!) },
]);

const downloadIcon = `<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/>`;

const downloads = [
  { key: 'cv.downloadTr', href: '/cv/omer-yasir-onal-tr.pdf', primary: true },
  { key: 'cv.downloadEn', href: '/cv/omer-yasir-onal-en.pdf', primary: false },
  { key: 'cv.downloadEu', href: '/cv/omer-yasir-onal-eu.pdf', primary: false },
];
---

<Base
  title={`${t(locale, 'cv.title')} | ${profile.name}`}
  description={t(locale, 'seo.cv.description')
    .replace('{name}', profile.name)
    .replace('{role}', profile.role[locale])}
  path={path}
  lang={locale}
  ogImage={ogCvPath(locale)}
>
  <script slot="head" type="application/ld+json" is:inline set:html={jsonLdScript(breadcrumbLd)} />

  <SiteHeader locale={locale} path={path} />

  <main id="main">
    <section class="container-page section">
      <div class="max-w-3xl">
        <p class="eyebrow">{profile.name}</p>
        <h1 class="h-display mt-3">{t(locale, 'cv.title')}</h1>
        <p class="lead mt-5">{t(locale, 'cv.intro')}</p>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          {
            downloads.map((d) => (
              <a href={d.href} download class={d.primary ? 'btn btn-primary' : 'btn btn-secondary'}>
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  set:html={downloadIcon}
                />
                {t(locale, d.key)}
              </a>
            ))
          }
        </div>

        <ul class="mt-10 space-y-3 border-t border-border pt-6 text-sm" role="list">
          <li>
            <a href="/cv/omer-yasir-onal-showcase.pdf" download class="link-arrow">
              {t(locale, 'cv.downloadShowcase')} <span aria-hidden="true">→</span>
            </a>
          </li>
          <li>
            <a
              href={mailto}
              class="font-semibold text-fg underline decoration-border-strong underline-offset-4 transition-colors hover:text-accent hover:decoration-accent"
            >
              {t(locale, 'cv.emailInstead')}
            </a>
          </li>
        </ul>
      </div>
    </section>
  </main>

  <SiteFooter locale={locale} />
</Base>
