---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { profile } from '../data/profile';
import { t, localizePath, type Locale } from '../data/i18n';
import { ogCvPath } from '../lib/og';
import { breadcrumbJsonLd, canonicalHref, jsonLdScript } from '../lib/seo';

const locale: Locale = 'tr';
const path = '/cv';
const mailto = `mailto:${profile.email}`;

const breadcrumbLd = breadcrumbJsonLd([
  { name: t(locale, 'cv.title'), url: canonicalHref(localizePath(locale, '/cv'), Astro.site!) },
]);

const downloadIcon = `<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/>`;

const downloads = [
  { key: 'cv.downloadTr', href: '/cv/omer-yasir-onal-tr.pdf', primary: true },
  { key: 'cv.downloadEn', href: '/cv/omer-yasir-onal-en.pdf', primary: false },
  { key: 'cv.downloadEu', href: '/cv/omer-yasir-onal-eu.pdf', primary: false },
];
---

<Base
  title={`${t(locale, 'cv.title')} | ${profile.name}`}
  description={t(locale, 'seo.cv.description')
    .replace('{name}', profile.name)
    .replace('{role}', profile.role[locale])}
  path={path}
  lang={locale}
  ogImage={ogCvPath(locale)}
>
  <script slot="head" type="application/ld+json" is:inline set:html={jsonLdScript(breadcrumbLd)} />

  <SiteHeader locale={locale} path={path} />

  <main id="main">
    <section class="mx-auto max-w-6xl px-6 pb-20 pt-16">
      <div class="rounded-2xl border border-border bg-card p-6 shadow-2xs sm:p-10">
        <p class="text-xs font-semibold uppercase tracking-wider text-accent">
          {profile.name}
        </p>
        <h1 class="mt-2 text-3xl font-bold tracking-tight text-fg sm:text-4xl">
          {t(locale, 'cv.title')}
        </h1>
        <p class="mt-4 max-w-2xl text-balance text-base leading-relaxed text-muted">
          {t(locale, 'cv.intro')}
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-4">
          {
            downloads.map((d) => (
              <a
                href={d.href}
                download
                class={
                  d.primary
                    ? 'inline-flex items-center gap-2 rounded-xl bg-accent px-5 py-3 text-sm font-semibold text-bg shadow-2xs transition-opacity hover:opacity-90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent'
                    : 'inline-flex items-center gap-2 rounded-xl border border-border bg-bg px-5 py-3 text-sm font-semibold text-fg transition-colors hover:border-accent hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent'
                }
              >
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  set:html={downloadIcon}
                />
                {t(locale, d.key)}
              </a>
            ))
          }
        </div>

        <p class="mt-6 text-sm">
          <a
            href="/cv/omer-yasir-onal-showcase.pdf"
            download
            class="inline-flex items-center gap-1.5 font-semibold text-accent underline decoration-accent/40 underline-offset-4 transition-colors hover:decoration-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
          >
            {t(locale, 'cv.downloadShowcase')} <span aria-hidden="true">→</span>
          </a>
        </p>

        <p class="mt-6 text-sm text-muted">
          <a
            href={mailto}
            class="font-semibold text-fg underline decoration-border underline-offset-4 transition-colors hover:text-accent hover:decoration-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
          >
            {t(locale, 'cv.emailInstead')}
          </a>
        </p>
      </div>
    </section>
  </main>

  <SiteFooter locale={locale} />
</Base>
