---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import WritingList from '../../components/WritingList.astro';
import { t, localizePath, type Locale } from '../../data/i18n';
import { ogWritingPath } from '../../lib/og';
import {
  breadcrumbJsonLd,
  writingItemListJsonLd,
  scholarlyArticleJsonLd,
  canonicalHref,
  jsonLdScript,
} from '../../lib/seo';

const locale: Locale = 'tr';
const path = '/writing';

const articles = (await getCollection('writing')).sort((a, b) =>
  a.data.date < b.data.date ? 1 : -1,
);
const pubs = await getCollection('publications');
const breadcrumbLd = breadcrumbJsonLd([
  { name: t(locale, 'section.writing'), url: canonicalHref(localizePath(locale, '/writing'), Astro.site!) },
]);
const posts = await getCollection('posts', (e) => !e.data.draft && e.data.lang === locale);
const ldItems = [
  ...articles.map((a) => ({
    title: a.data.title,
    url: a.data.url,
    date: a.data.date,
    order: a.data.order,
  })),
  ...posts.map((p) => ({
    title: p.data.title,
    url: canonicalHref(localizePath(locale, `/writing/${p.id}`), Astro.site!),
    date: p.data.date,
    order: 99,
  })),
]
  .sort((a, b) => {
    if (a.date !== b.date) return a.date < b.date ? 1 : -1;
    return a.order - b.order;
  })
  .map(({ title, url, date }) => ({ title, url, date }));
const articlesLd = writingItemListJsonLd(ldItems, Astro.site!);
const pubsLd = pubs.map((p) =>
  scholarlyArticleJsonLd(
    {
      title: p.data.title_tr,
      venue: p.data.venue,
      year: p.data.year,
      url: p.data.url,
    },
    Astro.site!,
  ),
);
---

<Base
  title={`${t(locale, 'section.writing')} | Ömer Yasir Önal`}
  description={t(locale, 'seo.writing.description')}
  path={path}
  lang={locale}
  ogImage={ogWritingPath(locale)}
>
  <script slot="head" type="application/ld+json" is:inline set:html={jsonLdScript(breadcrumbLd)} />
  <script slot="head" type="application/ld+json" is:inline set:html={jsonLdScript(articlesLd)} />
  {pubsLd.map((p) => <script slot="head" type="application/ld+json" is:inline set:html={jsonLdScript(p)} />)}

  <SiteHeader locale={locale} path={path} />

  <main id="main">
    <section class="mx-auto max-w-6xl px-6 pb-8 pt-16" data-reveal>
      <p class="inline-flex items-center gap-2 rounded-full border border-accent/25 bg-accent/8 px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-accent">
        <span class="h-1.5 w-1.5 rounded-full bg-accent" aria-hidden="true"></span>
        {t(locale, 'section.eyebrow.writing')}
      </p>
      <h1 class="mt-4 text-3xl font-extrabold tracking-tight text-fg sm:text-4xl">
        {t(locale, 'section.writing')}
      </h1>
      <p class="mt-4 max-w-2xl text-balance text-base leading-relaxed text-muted">
        {t(locale, 'writing.intro')}
      </p>
    </section>

    <section class="mx-auto max-w-6xl px-6 py-8 pb-20">
      <WritingList locale={locale} />
    </section>
  </main>

  <SiteFooter locale={locale} />
</Base>
