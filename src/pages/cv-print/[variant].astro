---
/**
 * PDF render source (NOT a public page — noindex).
 *
 * `scripts/build-cv.mjs` builds the site, then prints the built HTML of
 * `dist/cv-print/{tr,en,eu}/index.html` to `public/cv/omer-yasir-onal-{tr,en,eu}.pdf`
 * via headless Brave. The layout is a single ATS-safe main column with real,
 * selectable text — no text-as-image, no column splitting. A full-bleed violet
 * header band opens the page.
 *
 * Three OUTPUT variants (`getStaticPaths` below), each a `{ lang, photo, ascii,
 * gdpr }` recipe:
 *   - `tr` — Turkish, headshot, full diacritics.
 *   - `en` — English, CV-only headshot, ASCII-folded (except the name, which
 *     keeps its diacritics) so Workday / Greenhouse parsers survive it. The
 *     international / remote variant.
 *   - `eu` — English, no photo, PLUS a GDPR recruitment-consent footer; may
 *     run to a second page.
 *
 * All copy is REUSED from `profile.ts`, `cv.ts` and the content collections —
 * nothing is duplicated here. Turkish date/location strings are localized at
 * RENDER time via `cv-format.ts`; the `en`/`eu` variants ASCII-fold every
 * rendered string via `asciiFold` (the source frontmatter is never mutated).
 */
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import { profile } from '../../data/profile';
import { cv } from '../../data/cv';
import type { Locale } from '../../data/i18n';
import { cvVariants, type VariantId } from '../../data/cv-variants';
import {
  asciiFold,
  formatPeriod,
  localizeDate,
  localizeLocation,
  stripTechVersion,
} from '../../data/cv-format';

export function getStaticPaths() {
  return (Object.keys(cvVariants) as VariantId[]).map((variant) => ({ params: { variant } }));
}

const variant = Astro.params.variant as VariantId;
const cfg = cvVariants[variant];
const lang: Locale = cfg.lang;
const isTr = lang === 'tr';

// ASCII-fold every rendered string on the international / EU variants so ATS
// parsers read clean text; a no-op on the Turkish résumé.
const fold = cfg.ascii ? asciiFold : (value: string) => value;

// The TR and EN résumés carry a headshot (per-variant file from `cvVariants`);
// inline it as a data URI so it resolves when the built file:// HTML is printed
// (Astro's asset URLs would 404 there). `astro build` runs from the repo root,
// so resolve the source asset from cwd (import.meta.url would point at the
// compiled module under dist/).
const photoDataUri = cfg.photo
  ? `data:image/jpeg;base64,${readFileSync(
      join(process.cwd(), 'src', 'assets', cfg.photo),
    ).toString('base64')}`
  : null;

// --- Data --------------------------------------------------------------------
// The résumé's role, summary, skills, experience, projects, publications and
// writing line are CV-only (`cv.ts`), so the public site can keep its own
// (bolder) copy in `profile.ts` + the content collections. Still reused from
// `profile.ts`: name, contact line, certifications, languages, and the school +
// graduation of the education entry.

const s = (key: keyof typeof cv.sections): string => cv.sections[key][lang];

/** Human-readable, protocol-stripped display for a URL. */
const displayUrl = (url: string): string => url.replace(/^https?:\/\//, '').replace(/\/$/, '');

const socialLinks = [
  profile.links.github,
  profile.links.linkedin,
  profile.links.medium,
  profile.links.hackerrank,
];

// Education reads as *graduated* now (word order differs by locale), framed at
// render time so the reusable `profile.education` fields stay date-only.
const grad = isTr ? profile.education.graduation_tr : profile.education.graduation_en;
const educationLine = `${isTr ? cv.education.degree.tr : cv.education.degree.en} — ${
  isTr ? profile.education.school_tr : profile.education.school_en
} — ${isTr ? `${grad} mezunu` : `Graduated ${grad}`}`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{profile.name} — {fold(isTr ? 'Özgeçmiş' : 'Résumé')}</title>
    <style>
      /* Full-bleed sides (band reaches both edges); top/bottom keep a margin so
         a spillover page never butts content against the paper edge. */
      @page {
        size: A4;
        margin: 13mm 0;
      }

      :root {
        --accent: #6d28d9;
        --accent-soft: #c4b5fd;
        --accent-tint: #f5f3ff;
        --fg: #18181b;
        --muted: #52525b;
        --faint: #a1a1aa;
        --rule: #e4e0f4;
        --pad: 15mm; /* horizontal inset of the content + band interior */
      }

      * {
        box-sizing: border-box;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }

      html,
      body {
        margin: 0;
        padding: 0;
        background: #ffffff;
        color: var(--fg);
      }

      body {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto,
          'Helvetica Neue', Arial, sans-serif;
        font-size: 9.5pt;
        line-height: 1.42;
        -webkit-font-smoothing: antialiased;
      }

      a {
        color: var(--accent);
        text-decoration: none;
      }

      /* ---- Header band (full-bleed violet) -------------------------------- */
      .band {
        background: var(--accent);
        color: #ffffff;
        /* Pull up into the top page margin so the violet reaches the paper edge. */
        margin-top: -13mm;
        padding: 15mm var(--pad) 9mm;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12mm;
      }

      .band-text {
        min-width: 0;
      }

      .name {
        font-size: 25pt;
        font-weight: 800;
        letter-spacing: -0.02em;
        line-height: 1.04;
        margin: 0;
        color: #ffffff;
      }

      .role {
        font-size: 11.5pt;
        font-weight: 500;
        letter-spacing: 0.02em;
        margin: 5px 0 0;
        color: rgba(255, 255, 255, 0.92);
      }

      .photo {
        flex: 0 0 auto;
        width: 106px;
        height: 106px;
        border-radius: 50%;
        object-fit: cover;
        border: 3px solid rgba(255, 255, 255, 0.92);
        box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.35);
      }

      /* ---- Content column ------------------------------------------------- */
      .content {
        padding: 7mm var(--pad) 0;
      }

      /* ---- Contact / links masthead --------------------------------------- */
      .masthead {
        padding-bottom: 8px;
        border-bottom: 1px solid var(--rule);
        margin-bottom: 2px;
      }

      .contact-line {
        font-size: 9pt;
        color: var(--fg);
        line-height: 1.7;
      }

      .links-line {
        font-size: 9pt;
        line-height: 1.7;
        margin-top: 1px;
      }

      .links-line .platform {
        font-weight: 600;
        color: var(--accent);
      }

      .links-line .handle {
        color: var(--muted);
      }

      .sep {
        color: var(--faint);
        margin: 0 6px;
      }

      /* GDPR recruitment-consent footer (eu variant only). */
      .gdpr {
        margin-top: 16pt;
        padding-top: 6px;
        border-top: 1px solid var(--rule);
        font-size: 8pt;
        font-style: italic;
        color: var(--faint);
      }

      /* ---- Sections ------------------------------------------------------- */
      section {
        margin-top: 13pt;
      }

      h2 {
        font-size: 9.5pt;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.14em;
        color: var(--accent);
        margin: 0 0 7px;
        padding-bottom: 4px;
        border-bottom: 1px solid var(--accent-soft);
      }

      p {
        margin: 0;
      }

      .summary {
        text-align: justify;
        color: #27272a;
      }

      /* ---- Entries (avoid splitting across pages) ------------------------- */
      .entry {
        margin-bottom: 9px;
        break-inside: avoid;
        page-break-inside: avoid;
      }

      .entry:last-child {
        margin-bottom: 0;
      }

      .entry-head {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 12px;
      }

      .entry-title {
        font-weight: 700;
        color: var(--fg);
      }

      .entry-org {
        font-weight: 500;
        color: var(--muted);
      }

      .entry-meta {
        flex: 0 0 auto;
        font-size: 8.4pt;
        font-weight: 500;
        color: var(--muted);
        white-space: nowrap;
      }

      ul.bullets {
        margin: 4px 0 0;
        padding-left: 15px;
      }

      ul.bullets li {
        margin: 1.5px 0;
      }

      ul.bullets li::marker {
        color: var(--accent-soft);
      }

      /* ---- Skills / meta lists ------------------------------------------- */
      .kv {
        margin: 3.5px 0;
      }

      .kv .k {
        font-weight: 700;
        color: var(--fg);
      }

      .project-note {
        margin-top: 2px;
        color: #27272a;
      }

      .project-tech {
        color: var(--muted);
        font-size: 8.7pt;
        margin-top: 2px;
      }

      .project-more {
        margin-top: 7px;
        font-size: 8.7pt;
        color: var(--muted);
      }

      .inline-list {
        margin: 0;
        padding-left: 15px;
      }

      .inline-list li {
        margin: 2.5px 0;
      }

      .inline-list li::marker {
        color: var(--accent-soft);
      }
    </style>
  </head>
  <body>
    <!-- ============================== HEADER BAND ========================== -->
    <header class="band">
      <div class="band-text">
        {/* The name keeps its Turkish diacritics on every variant (owner request);
            the rest of the en/eu text stays ASCII-folded for ATS parsers. */}
        <h1 class="name">{profile.name}</h1>
        <p class="role">{fold(cv.role[lang])}</p>
      </div>
      {photoDataUri && <img class="photo" src={photoDataUri} alt={profile.name} />}
    </header>

    <main class="content">
      <!-- ========================= CONTACT / LINKS ======================= -->
      <div class="masthead">
        <div class="contact-line">
          <a href={`mailto:${profile.email}`}>{profile.email}</a><span class="sep">·</span>
          <a href={`tel:${cv.phone.replace(/\s/g, '')}`}>{cv.phone}</a><span class="sep">·</span>
          <span>{fold(profile.location[lang])}</span><span class="sep">·</span>
          <a href={cv.website}>{displayUrl(cv.website)}</a>
        </div>
        <div class="links-line">
          {
            socialLinks.map((l, i) => (
              <>
                {i > 0 && <span class="sep">·</span>}
                <a href={l.url}>
                  <span class="platform">{l.label}</span> <span class="handle">{l.handle}</span>
                </a>
              </>
            ))
          }
        </div>
      </div>

      <!-- ============================= SUMMARY ========================= -->
      <section>
        <h2>{s('summary')}</h2>
        <p class="summary">{fold(cv.summary[lang])}</p>
      </section>

      <!-- ============================== SKILLS ========================= -->
      <section>
        <h2>{s('skills')}</h2>
        {
          cv.skills.map((g) => (
            <p class="kv">
              <span class="k">{fold(isTr ? g.title_tr : g.title_en)}:</span>{' '}
              {fold(isTr ? g.tr : g.en)}
            </p>
          ))
        }
      </section>

      <!-- ============================ EXPERIENCE ======================= -->
      <section>
        <h2>{s('experience')}</h2>
        {
          cv.experience.map((e) => (
            <div class="entry">
              <div class="entry-head">
                <div>
                  <span class="entry-title">{fold(isTr ? e.role_tr : e.role_en)}</span>
                  <span class="entry-org"> {fold('—')} {fold(e.org)}</span>
                </div>
                <div class="entry-meta">
                  {fold(localizeLocation(e.location, lang))} ·{' '}
                  {fold(formatPeriod(e.start, e.end, lang))}
                </div>
              </div>
              <ul class="bullets">
                {(isTr ? e.bullets_tr : e.bullets_en).map((b) => (
                  <li>{fold(b)}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </section>

      <!-- ============================= PROJECTS ======================== -->
      <section>
        <h2>{s('projects')}</h2>
        {
          cv.projects.map((p) => (
            <div class="entry">
              <div class="entry-head">
                <div>
                  <span class="entry-title">{fold(p.title)}</span>
                </div>
                <div class="entry-meta">
                  <a href={p.link}>{fold(p.linkLabel ?? displayUrl(p.link))}</a>
                </div>
              </div>
              <p class="project-note">{fold(isTr ? p.tr : p.en)}</p>
              <p class="project-tech">
                {p.tech.map((tech) => fold(stripTechVersion(tech))).join(' · ')}
              </p>
            </div>
          ))
        }
        <p class="kv">
          <span class="k">{fold(isTr ? cv.appStoreApps.intro.tr : cv.appStoreApps.intro.en)}:</span>{' '}
          {
            cv.appStoreApps.apps.map((a, i) => (
              <>
                {i > 0 && <span class="sep">·</span>}
                <a href={a.link}>{fold(a.name)}</a> ({a.platform})
              </>
            ))
          }
        </p>
        <p class="project-more">
          <a href={profile.links.github.url}>
            {fold(isTr ? 'GitHub’da daha fazlası' : 'More on GitHub')} →{' '}
            {displayUrl(profile.links.github.url)}
          </a>
        </p>
      </section>

      <!-- =========================== PUBLICATIONS ====================== -->
      <section>
        <h2>{s('publications')}</h2>
        {
          cv.publications.map((pub) => (
            <div class="entry">
              <p>
                <span class="entry-title">{fold(isTr ? pub.title_tr : pub.title_en)}</span>
                {fold(' — ')}
                <span class="entry-org">{fold(pub.venue)}</span>
              </p>
              <p class="project-note">{fold(isTr ? pub.note_tr : pub.note_en)}</p>
            </div>
          ))
        }
      </section>

      <!-- ============================== WRITING ======================== -->
      <section>
        <h2>{s('writing')}</h2>
        <p>
          {fold(isTr ? cv.writing.tr : cv.writing.en)}
          {fold(' — ')}
          <a href={profile.links.medium.url}>{displayUrl(profile.links.medium.url)}</a>
        </p>
      </section>

      <!-- =========================== CERTIFICATIONS ==================== -->
      <section>
        <h2>{s('certifications')}</h2>
        <ul class="inline-list">
          {
            profile.certifications.map((c) => {
              const meta = `${c.issuer}${c.platform ? ` (${c.platform})` : ''}, ${localizeDate(
                c.date,
                lang,
              )}`;
              return (
                <li>
                  <span class="entry-title">{fold(c.title)}</span> {fold('—')} {fold(meta)}
                </li>
              );
            })
          }
        </ul>
      </section>

      <!-- ============================= EDUCATION ======================= -->
      <section>
        <h2>{s('education')}</h2>
        <p>{fold(educationLine)}</p>
      </section>

      <!-- ============================= LANGUAGES ======================= -->
      <section>
        <h2>{s('languages')}</h2>
        <p>
          {fold(
            profile.languages
              .map((l) => (isTr ? `${l.name_tr} (${l.level_tr})` : `${l.name_en} (${l.level_en})`))
              .join(' · '),
          )}
        </p>
      </section>

      <!-- ============================ GDPR CONSENT ===================== -->
      {cfg.gdpr && <footer class="gdpr">{cv.gdprConsent}</footer>}
    </main>
  </body>
</html>
