---
/**
 * PDF render source (NOT a public page — noindex).
 *
 * `scripts/build-cv.mjs` builds the site, then prints the built HTML of
 * `dist/cv-print/{en,tr}/index.html` to `public/cv/omer-yasir-onal-{en,tr}.pdf`
 * via headless Brave. The layout is a single ATS-safe main column with real,
 * selectable text — no text-as-image, no column splitting. A full-bleed violet
 * header band opens the page; TR renders the headshot in the band, EN omits it.
 *
 * All copy is REUSED from `profile.ts`, `cv.ts` and the content collections —
 * nothing is duplicated here. Turkish date/location strings are localized at
 * RENDER time via `cv-format.ts` (the source frontmatter is never mutated).
 */
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import { getCollection } from 'astro:content';
import { profile } from '../../data/profile';
import { cv } from '../../data/cv';
import { locales, type Locale } from '../../data/i18n';
import { formatPeriod, localizeDate, localizeLocation, stripTechVersion } from '../../data/cv-format';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const isTr = lang === 'tr';

// The TR résumé carries a headshot; inline it as a data URI so it resolves when
// Brave prints the built file:// HTML (Astro's asset URLs would 404 there).
// `astro build` runs from the repo root, so resolve the source asset from cwd
// (import.meta.url would point at the compiled module under dist/).
const photoDataUri = isTr
  ? `data:image/jpeg;base64,${readFileSync(
      join(process.cwd(), 'src', 'assets', 'omer-yasir-onal.jpg'),
    ).toString('base64')}`
  : null;

// --- Data (sorted, reused from the site's single sources of truth) -----------
const experience = (await getCollection('experience')).sort((a, b) => a.data.order - b.data.order);

// Curated résumé projects: `cv.projects` fixes the order + carries a CV-only
// impact note; the matching content-collection entry supplies the tech line and
// the primary link. `flatMap` drops any slug that doesn't resolve (strict-TS
// safe — no non-null assertion needed).
const allProjects = await getCollection('projects');
const cvProjects = cv.projects.flatMap((cp) => {
  const entry = allProjects.find((p) => p.id === cp.slug);
  return entry ? [{ entry, note: isTr ? cp.tr : cp.en }] : [];
});

const publications = await getCollection('publications');
const writingCount = (await getCollection('writing')).length;

// CV-specific skill order (reused from profile.ts, reordered for a security /
// back-end reviewer). Frontend + Mobile are folded into one line below.
const cvSkillLines = cv.skills.order.flatMap((title) => {
  const g = profile.skillGroups.find((sg) => sg.title_en === title);
  return g ? [g] : [];
});

const s = (key: keyof typeof cv.sections): string => cv.sections[key][lang];

/** Human-readable, protocol-stripped display for a URL. */
const displayUrl = (url: string): string => url.replace(/^https?:\/\//, '').replace(/\/$/, '');

/** The single most relevant link for a project (shipped product > code). */
const primaryLink = (links: {
  appstore?: string;
  live?: string;
  repo?: string;
  other?: string;
}): string | undefined => links.appstore ?? links.live ?? links.repo ?? links.other;

const socialLinks = [
  profile.links.github,
  profile.links.linkedin,
  profile.links.medium,
  profile.links.hackerrank,
];

// Education reads as *graduated* now (word order differs by locale), framed at
// render time so the reusable `profile.education` fields stay date-only.
const grad = isTr ? profile.education.graduation_tr : profile.education.graduation_en;
const educationLine = `${isTr ? cv.education.degree.tr : cv.education.degree.en} — ${
  isTr ? profile.education.school_tr : profile.education.school_en
} — ${isTr ? `${grad} mezunu` : `Graduated ${grad}`}`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{profile.name} — {isTr ? 'Özgeçmiş' : 'Résumé'}</title>
    <style>
      /* Full-bleed sides (band reaches both edges); top/bottom keep a margin so
         a spillover page never butts content against the paper edge. */
      @page {
        size: A4;
        margin: 13mm 0;
      }

      :root {
        --accent: #6d28d9;
        --accent-soft: #c4b5fd;
        --accent-tint: #f5f3ff;
        --fg: #18181b;
        --muted: #52525b;
        --faint: #a1a1aa;
        --rule: #e4e0f4;
        --pad: 15mm; /* horizontal inset of the content + band interior */
      }

      * {
        box-sizing: border-box;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }

      html,
      body {
        margin: 0;
        padding: 0;
        background: #ffffff;
        color: var(--fg);
      }

      body {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto,
          'Helvetica Neue', Arial, sans-serif;
        font-size: 9.5pt;
        line-height: 1.42;
        -webkit-font-smoothing: antialiased;
      }

      a {
        color: var(--accent);
        text-decoration: none;
      }

      /* ---- Header band (full-bleed violet) -------------------------------- */
      .band {
        background: var(--accent);
        color: #ffffff;
        /* Pull up into the top page margin so the violet reaches the paper edge. */
        margin-top: -13mm;
        padding: 15mm var(--pad) 9mm;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12mm;
      }

      .band-text {
        min-width: 0;
      }

      .name {
        font-size: 25pt;
        font-weight: 800;
        letter-spacing: -0.02em;
        line-height: 1.04;
        margin: 0;
        color: #ffffff;
      }

      .role {
        font-size: 11.5pt;
        font-weight: 500;
        letter-spacing: 0.02em;
        margin: 5px 0 0;
        color: rgba(255, 255, 255, 0.92);
      }

      .photo {
        flex: 0 0 auto;
        width: 92px;
        height: 92px;
        border-radius: 50%;
        object-fit: cover;
        border: 3px solid rgba(255, 255, 255, 0.92);
        box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.35);
      }

      /* ---- Content column ------------------------------------------------- */
      .content {
        padding: 7mm var(--pad) 0;
      }

      /* ---- Contact / links masthead --------------------------------------- */
      .masthead {
        padding-bottom: 8px;
        border-bottom: 1px solid var(--rule);
        margin-bottom: 2px;
      }

      .contact-line {
        font-size: 9pt;
        color: var(--fg);
        line-height: 1.7;
      }

      .links-line {
        font-size: 9pt;
        line-height: 1.7;
        margin-top: 1px;
      }

      .links-line .platform {
        font-weight: 600;
        color: var(--accent);
      }

      .links-line .handle {
        color: var(--muted);
      }

      .sep {
        color: var(--faint);
        margin: 0 6px;
      }

      /* ---- Sections ------------------------------------------------------- */
      section {
        margin-top: 13pt;
      }

      h2 {
        font-size: 9.5pt;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.14em;
        color: var(--accent);
        margin: 0 0 7px;
        padding-bottom: 4px;
        border-bottom: 1px solid var(--accent-soft);
      }

      p {
        margin: 0;
      }

      .summary {
        text-align: justify;
        color: #27272a;
      }

      /* ---- Entries (avoid splitting across pages) ------------------------- */
      .entry {
        margin-bottom: 9px;
        break-inside: avoid;
        page-break-inside: avoid;
      }

      .entry:last-child {
        margin-bottom: 0;
      }

      .entry-head {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 12px;
      }

      .entry-title {
        font-weight: 700;
        color: var(--fg);
      }

      .entry-org {
        font-weight: 500;
        color: var(--muted);
      }

      .entry-meta {
        flex: 0 0 auto;
        font-size: 8.4pt;
        font-weight: 500;
        color: var(--muted);
        white-space: nowrap;
      }

      ul.bullets {
        margin: 4px 0 0;
        padding-left: 15px;
      }

      ul.bullets li {
        margin: 1.5px 0;
      }

      ul.bullets li::marker {
        color: var(--accent-soft);
      }

      /* ---- Skills / meta lists ------------------------------------------- */
      .kv {
        margin: 3.5px 0;
      }

      .kv .k {
        font-weight: 700;
        color: var(--fg);
      }

      .project-note {
        margin-top: 2px;
        color: #27272a;
      }

      .project-tech {
        color: var(--muted);
        font-size: 8.7pt;
        margin-top: 2px;
      }

      .project-more {
        margin-top: 7px;
        font-size: 8.7pt;
        color: var(--muted);
      }

      .inline-list {
        margin: 0;
        padding-left: 15px;
      }

      .inline-list li {
        margin: 2.5px 0;
      }

      .inline-list li::marker {
        color: var(--accent-soft);
      }
    </style>
  </head>
  <body>
    <!-- ============================== HEADER BAND ========================== -->
    <header class="band">
      <div class="band-text">
        <h1 class="name">{profile.name}</h1>
        <p class="role">{profile.role[lang]}</p>
      </div>
      {photoDataUri && <img class="photo" src={photoDataUri} alt={profile.name} />}
    </header>

    <main class="content">
      <!-- ========================= CONTACT / LINKS ======================= -->
      <div class="masthead">
        <div class="contact-line">
          <a href={`mailto:${profile.email}`}>{profile.email}</a><span class="sep">·</span>
          <a href={`tel:${cv.phone.replace(/\s/g, '')}`}>{cv.phone}</a><span class="sep">·</span>
          <span>{profile.location[lang]}</span><span class="sep">·</span>
          <a href={cv.website}>{displayUrl(cv.website)}</a>
        </div>
        <div class="links-line">
          {
            socialLinks.map((l, i) => (
              <>
                {i > 0 && <span class="sep">·</span>}
                <a href={l.url}>
                  <span class="platform">{l.label}</span> <span class="handle">{l.handle}</span>
                </a>
              </>
            ))
          }
        </div>
      </div>

      <!-- ============================= SUMMARY ========================= -->
      <section>
        <h2>{s('summary')}</h2>
        <p class="summary">{cv.summary[lang]}</p>
      </section>

      <!-- ============================== SKILLS ========================= -->
      <section>
        <h2>{s('skills')}</h2>
        {
          cvSkillLines.map((g) => (
            <p class="kv">
              <span class="k">{isTr ? g.title_tr : g.title_en}:</span> {g.items.join(', ')}
            </p>
          ))
        }
        <p class="kv">
          <span class="k">
            {isTr ? cv.skills.frontendMobile.title_tr : cv.skills.frontendMobile.title_en}:
          </span>{' '}
          {isTr ? cv.skills.frontendMobile.tr : cv.skills.frontendMobile.en}
        </p>
      </section>

      <!-- ============================ EXPERIENCE ======================= -->
      <section>
        <h2>{s('experience')}</h2>
        {
          experience.map((e) => (
            <div class="entry">
              <div class="entry-head">
                <div>
                  <span class="entry-title">{isTr ? e.data.role_tr : e.data.role_en}</span>
                  <span class="entry-org"> — {e.data.org}</span>
                </div>
                <div class="entry-meta">
                  {localizeLocation(e.data.location, lang)} ·{' '}
                  {formatPeriod(e.data.start, e.data.end, lang)}
                </div>
              </div>
              <ul class="bullets">
                {(isTr ? e.data.bullets_tr : e.data.bullets_en).map((b) => (
                  <li>{b}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </section>

      <!-- ============================= PROJECTS ======================== -->
      <section>
        <h2>{s('projects')}</h2>
        {
          cvProjects.map(({ entry, note }) => {
            const link = primaryLink(entry.data.links);
            return (
              <div class="entry">
                <div class="entry-head">
                  <div>
                    <span class="entry-title">{entry.data.title}</span>
                  </div>
                  {link && (
                    <div class="entry-meta">
                      <a href={link}>{displayUrl(link)}</a>
                    </div>
                  )}
                </div>
                <p class="project-note">{note}</p>
                <p class="project-tech">{entry.data.stack.map(stripTechVersion).join(' · ')}</p>
              </div>
            );
          })
        }
        <p class="project-more">
          <a href={profile.links.github.url}>
            {isTr ? 'GitHub’da daha fazlası' : 'More on GitHub'} →{' '}
            {displayUrl(profile.links.github.url)}
          </a>
        </p>
      </section>

      <!-- =========================== PUBLICATIONS ====================== -->
      <section>
        <h2>{s('publications')}</h2>
        {
          publications.map((pub) => (
            <p class="entry">
              <span class="entry-title">{isTr ? pub.data.title_tr : pub.data.title_en}</span>
              {' — '}
              <span class="entry-org">
                {pub.data.venue}, {pub.data.year}
              </span>
            </p>
          ))
        }
      </section>

      <!-- ============================== WRITING ======================== -->
      <section>
        <h2>{s('writing')}</h2>
        <p>
          {(isTr ? cv.writing.tr : cv.writing.en).replace('{n}', String(writingCount))}
          {' — '}
          <a href={profile.links.medium.url}>{displayUrl(profile.links.medium.url)}</a>
        </p>
      </section>

      <!-- =========================== CERTIFICATIONS ==================== -->
      <section>
        <h2>{s('certifications')}</h2>
        <ul class="inline-list">
          {
            profile.certifications.map((c) => {
              const meta = `${c.issuer}${c.platform ? ` (${c.platform})` : ''}, ${localizeDate(
                c.date,
                lang,
              )}`;
              return (
                <li>
                  <span class="entry-title">{c.title}</span> — {meta}
                </li>
              );
            })
          }
        </ul>
      </section>

      <!-- ============================= EDUCATION ======================= -->
      <section>
        <h2>{s('education')}</h2>
        <p>{educationLine}</p>
      </section>

      <!-- ============================= LANGUAGES ======================= -->
      <section>
        <h2>{s('languages')}</h2>
        <p>
          {
            profile.languages
              .map((l) => (isTr ? `${l.name_tr} (${l.level_tr})` : `${l.name_en} (${l.level_en})`))
              .join(' · ')
          }
        </p>
      </section>
    </main>
  </body>
</html>
