---
/**
 * Visual project-showcase — PDF render source (NOT a public page — noindex).
 *
 * `scripts/build-cv.mjs` builds the site, then prints the built HTML of
 * `dist/cv-print/showcase/index.html` to
 * `public/cv/omer-yasir-onal-showcase.pdf` via headless Brave.
 *
 * A one-page A4-LANDSCAPE visual companion to the text CV: the top projects as
 * cards (screenshot + name + one-line description + tech chips + link). Images
 * are fine here — this is a visual piece, not an ATS document. Copy is REUSED
 * from the content collections + `src/data/showcase.ts`; nothing is duplicated.
 *
 * Screenshots are inlined as data URIs so they resolve when Brave prints the
 * built `file://` HTML (Astro's hashed asset URLs would 404 there). `astro
 * build` runs from the repo root, so the source assets resolve from `cwd`.
 */
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import { getCollection } from 'astro:content';
import { profile } from '../../data/profile';
import { showcase } from '../../data/showcase';
import { asciiFold, stripTechVersion } from '../../data/cv-format';

const projects = await getCollection('projects');
const bySlug = (slug: string) => projects.find((p) => p.id === slug);

/** The single most relevant link for a project (shipped product > code). */
const primaryLink = (links: {
  appstore?: string;
  live?: string;
  repo?: string;
  other?: string;
}): string | undefined => links.appstore ?? links.live ?? links.repo ?? links.other;

/** Human-readable, protocol-stripped display for a URL. */
const displayUrl = (url: string): string => url.replace(/^https?:\/\//, '').replace(/\/$/, '');

/** Screenshot → data URI (JPEG under src/assets/showcase). */
const imageDataUri = (file: string): string =>
  `data:image/jpeg;base64,${readFileSync(
    join(process.cwd(), 'src', 'assets', 'showcase', file),
  ).toString('base64')}`;

// Resolve every card to a uniform, render-ready shape (title / desc / chips /
// link), reusing the collection entry where a `slug` is present.
const visualCards = showcase.visual.map((c) => {
  const entry = c.slug ? bySlug(c.slug) : undefined;
  const stack = entry ? entry.data.stack : (c.stack ?? []);
  const link = c.link ?? (entry ? primaryLink(entry.data.links) : undefined);
  return {
    src: imageDataUri(c.image),
    title: entry?.data.title ?? c.title ?? '',
    desc: c.desc,
    chips: stack.slice(0, 6).map(stripTechVersion),
    link,
  };
});

const textCards = showcase.text.flatMap((c) => {
  const entry = bySlug(c.slug);
  if (!entry) return [];
  return [
    {
      title: entry.data.title,
      desc: c.desc,
      chips: entry.data.stack.slice(0, 6).map(stripTechVersion),
      link: primaryLink(entry.data.links),
    },
  ];
});

// ASCII-fold every rendered string (clean, print-safe glyphs).
const fold = asciiFold;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{fold(profile.name)} — {showcase.header.tagline}</title>
    <style>
      /* Landscape A4; full-bleed sides so the violet band reaches both edges. */
      @page {
        size: A4 landscape;
        margin: 12mm 0;
      }

      :root {
        --accent: #6d28d9;
        --accent-soft: #c4b5fd;
        --accent-tint: #f5f3ff;
        --fg: #18181b;
        --muted: #52525b;
        --faint: #a1a1aa;
        --rule: #e4e0f4;
        --pad: 14mm;
      }

      * {
        box-sizing: border-box;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }

      html,
      body {
        margin: 0;
        padding: 0;
        background: #ffffff;
        color: var(--fg);
      }

      body {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto,
          'Helvetica Neue', Arial, sans-serif;
        font-size: 9.5pt;
        line-height: 1.4;
        -webkit-font-smoothing: antialiased;
      }

      a {
        color: var(--accent);
        text-decoration: none;
      }

      /* ---- Header band (full-bleed violet) -------------------------------- */
      .band {
        background: var(--accent);
        color: #ffffff;
        margin-top: -12mm; /* pull up into the top page margin → reaches the edge */
        padding: 11mm var(--pad) 8mm;
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 12mm;
      }

      .name {
        font-size: 22pt;
        font-weight: 800;
        letter-spacing: -0.02em;
        line-height: 1.02;
        margin: 0;
        color: #ffffff;
      }

      .tagline {
        font-size: 12pt;
        font-weight: 500;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        margin: 6px 0 0;
        color: rgba(255, 255, 255, 0.9);
      }

      .band-right {
        flex: 0 0 auto;
        text-align: right;
      }

      .band-right .eyebrow {
        font-size: 8pt;
        font-weight: 600;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.72);
      }

      .band-right .site {
        display: block;
        font-size: 12pt;
        font-weight: 700;
        margin-top: 3px;
        color: #ffffff;
      }

      /* ---- Content -------------------------------------------------------- */
      .content {
        padding: 8mm var(--pad) 0;
      }

      .grid-visual {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 6mm;
      }

      .grid-text {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 6mm;
        margin-top: 6mm;
      }

      /* ---- Visual card (screenshot on top) -------------------------------- */
      .card {
        border: 1px solid var(--rule);
        border-radius: 10px;
        overflow: hidden;
        background: #ffffff;
        break-inside: avoid;
        page-break-inside: avoid;
      }

      .shot {
        display: block;
        width: 100%;
        aspect-ratio: 1440 / 900;
        object-fit: cover;
        object-position: top center;
        border-bottom: 1px solid var(--rule);
      }

      .card-body {
        padding: 8px 11px 11px;
      }

      .card-head {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 8px;
      }

      .card-title {
        font-size: 12pt;
        font-weight: 700;
        color: var(--fg);
        margin: 0;
        line-height: 1.1;
      }

      .card-link {
        flex: 0 0 auto;
        font-size: 8pt;
        font-weight: 600;
        color: var(--accent);
        white-space: nowrap;
      }

      .card-desc {
        margin: 5px 0 0;
        color: #27272a;
        font-size: 9pt;
        line-height: 1.38;
      }

      /* ---- Tech chips ----------------------------------------------------- */
      .chips {
        display: flex;
        flex-wrap: wrap;
        gap: 4px;
        margin-top: 8px;
      }

      .chip {
        display: inline-block;
        padding: 2px 7px;
        border-radius: 999px;
        background: var(--accent-tint);
        color: var(--accent);
        border: 1px solid var(--accent-soft);
        font-size: 7.6pt;
        font-weight: 600;
        line-height: 1.3;
      }

      /* ---- Compact text card (violet accent bar) -------------------------- */
      .tcard {
        border: 1px solid var(--rule);
        border-left: 3px solid var(--accent);
        border-radius: 8px;
        padding: 11px 13px;
        background: #ffffff;
        break-inside: avoid;
        page-break-inside: avoid;
      }

      .foot {
        margin-top: 6mm;
        padding-top: 5px;
        border-top: 1px solid var(--rule);
        font-size: 8pt;
        color: var(--faint);
        display: flex;
        justify-content: space-between;
      }

      .foot .accent {
        color: var(--accent);
        font-weight: 600;
      }
    </style>
  </head>
  <body>
    <!-- ============================== HEADER BAND ========================== -->
    <header class="band">
      <div>
        <h1 class="name">{fold(profile.name)} — {showcase.header.tagline}</h1>
        <p class="tagline">{fold(profile.role.en)}</p>
      </div>
      <div class="band-right">
        <span class="eyebrow">Portfolio</span>
        <span class="site">{showcase.header.site}</span>
      </div>
    </header>

    <main class="content">
      <!-- ========================= VISUAL CARDS ======================== -->
      <div class="grid-visual">
        {
          visualCards.map((c) => (
            <article class="card">
              <img class="shot" src={c.src} alt={`${fold(c.title)} screenshot`} />
              <div class="card-body">
                <div class="card-head">
                  <h2 class="card-title">{fold(c.title)}</h2>
                  {c.link && (
                    <a class="card-link" href={c.link}>
                      {fold(displayUrl(c.link))} →
                    </a>
                  )}
                </div>
                <p class="card-desc">{fold(c.desc)}</p>
                <div class="chips">
                  {c.chips.map((tech) => (
                    <span class="chip">{fold(tech)}</span>
                  ))}
                </div>
              </div>
            </article>
          ))
        }
      </div>

      <!-- ========================== TEXT CARDS ========================= -->
      <div class="grid-text">
        {
          textCards.map((c) => (
            <article class="tcard">
              <div class="card-head">
                <h2 class="card-title">{fold(c.title)}</h2>
                {c.link && (
                  <a class="card-link" href={c.link}>
                    {fold(displayUrl(c.link))} →
                  </a>
                )}
              </div>
              <p class="card-desc">{fold(c.desc)}</p>
              <div class="chips">
                {c.chips.map((tech) => (
                  <span class="chip">{fold(tech)}</span>
                ))}
              </div>
            </article>
          ))
        }
      </div>

      <!-- ============================== FOOTER ========================= -->
      <div class="foot">
        <span>
          {fold(profile.name)} · <span class="accent">{showcase.header.site}</span>
        </span>
        <span>{fold('More projects & the text CV at ' + showcase.header.site + '/cv')}</span>
      </div>
    </main>
  </body>
</html>
